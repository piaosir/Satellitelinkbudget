/**app.wxss**/
/* ========================================
   工业级专业化设计系统 - 卫星链路预算计算器
   ======================================== */

/* 系统字体栈 - 优化可读性 */
.container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  background-color: #f0f2f5;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  width: 100%;
  padding: 0;
  margin: 0;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 公共样式 */
page {
  background-color: #f0f2f5;
  font-size: 26rpx;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* 数值专用字体类 */
.numeric {
  font-family: "SF Mono", "Fira Code", "JetBrains Mono", Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

/* 卡片样式 - 工业级设计 */
.card {
  background: #ffffff;
  border-radius: 4rpx;
  margin: 0 0 2rpx 0;
  padding: 20rpx 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
  border: none;
  border-bottom: 1rpx solid #e5e7eb;
}

/* 全宽卡片样式 - 用于计算结果 */
.card-full-width {
  width: 100%;
  margin: 0 0 2rpx 0;
  padding: 20rpx 12rpx;
  border: none;
  box-sizing: border-box;
}

.card-full-width .card-title {
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.card-full-width .result-section {
  padding-left: 0;
  padding-right: 0;
}

.card-full-width .divider {
  margin-left: 0;
  margin-right: 0;
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  letter-spacing: 0.02em;
  padding: 0 8rpx;
}

.card-title::before {
  content: '';
  width: 4rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #3b82f6, #1d4ed8);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

/* 表单样式 */
.form-group {
  margin-bottom: 12rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  font-weight: 500;
  letter-spacing: 0.01em;
}

.form-input {
  width: 100%;
  height: 64rpx;
  background: #f9fafb;
  border: 1rpx solid #d1d5db;
  border-radius: 6rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  font-family: "SF Mono", "Fira Code", Menlo, Monaco, Consolas, monospace;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
  transition: all 0.15s ease;
  color: #111827;
}

.form-input:focus {
  border-color: #3b82f6;
  background: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.1);
}

.form-picker {
  width: 100%;
  height: 64rpx;
  background: #f9fafb;
  border: 1rpx solid #d1d5db;
  border-radius: 6rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  line-height: 62rpx;
  box-sizing: border-box;
  color: #111827;
}

/* 按钮样式 */
.btn-primary {
  width: 100%;
  height: 72rpx;
  background: linear-gradient(135deg, #1e3a5f, #0f172a);
  color: #ffffff;
  border-radius: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.15);
  transition: all 0.2s ease;
  letter-spacing: 0.05em;
}

.btn-primary:active {
  transform: translateY(1rpx);
  background: linear-gradient(135deg, #0f172a, #020617);
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.2);
}

.btn-secondary {
  width: 100%;
  height: 64rpx;
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #d1d5db;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.btn-secondary:active {
  background: #f3f4f6;
  border-color: #9ca3af;
}

/* 网格布局系统 */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.grid-auto {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140rpx, 1fr));
  gap: 10rpx;
}

/* 折叠面板 */
.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  background: #ffffff;
  border-radius: 4rpx;
  margin-bottom: 2rpx;
  cursor: pointer;
  border: none;
  border-bottom: 1rpx solid #e5e7eb;
}

.collapse-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  letter-spacing: 0.01em;
}

.collapse-icon {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.2s ease;
  color: #9ca3af;
  font-size: 20rpx;
}

.collapse-icon.expanded {
  transform: rotate(180deg);
}

.collapse-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.25s ease-out;
}

.collapse-content.show {
  max-height: 10000rpx;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.loading-text {
  margin-left: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #9ca3af;
  font-size: 26rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  background: #e5e7eb;
  color: #374151;
  margin-right: 8rpx;
  border: none;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 20rpx 0;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

page {
  background: #f0f2f5;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* ========================================
   双栏布局系统 - 发信/收信站并排
   ======================================== */
.dual-column-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  background: #ffffff;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 2rpx;
}

.dual-column {
  padding: 16rpx;
  border-right: 1rpx solid #e5e7eb;
}

.dual-column:last-child {
  border-right: none;
}

.dual-column-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.dual-column-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #111827;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dual-column-icon {
  font-size: 28rpx;
}

/* 紧凑型表单组 */
.form-group-compact {
  margin-bottom: 10rpx;
}

.form-group-compact .form-label {
  font-size: 20rpx;
  margin-bottom: 4rpx;
  color: #6b7280;
}

.form-group-compact .form-input {
  height: 56rpx;
  font-size: 24rpx;
}

.form-group-compact .form-picker {
  height: 56rpx;
  font-size: 24rpx;
  line-height: 54rpx;
}

/* 单行双字段布局 */
.inline-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.inline-fields .form-group-compact {
  margin-bottom: 8rpx;
}

/* 工业级配色系统 */
.text-primary { color: #111827; }
.text-secondary { color: #6b7280; }
.text-muted { color: #9ca3af; }
.text-accent { color: #3b82f6; }
.text-success { color: #059669; }
.text-warning { color: #d97706; }
.text-danger { color: #dc2626; }

.bg-primary { background-color: #111827; }
.bg-secondary { background-color: #f3f4f6; }
.bg-accent { background-color: #3b82f6; }

/* 微交互状态 */
.hover-lift {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.hover-lift:active {
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}