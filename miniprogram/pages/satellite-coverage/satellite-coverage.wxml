<!--satellite-coverage.wxml-->
<wxs src="./utils.wxs" module="utils" />
<view class="container">
  <!-- 地图组件。旋转关死：原先属性写 true、setting 写 0，两者打架（屏幕点换经纬度按北朝上算，转了就偏）。
       「手绘」开着时锁住拖动 / 缩放：手绘层底下的地图不许跟着手指跑 -->
  <map
    id="coverageMap"
    class="coverage-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    min-scale="{{3}}"
    max-scale="{{20}}"
    circles="{{circles}}"
    markers="{{utils.cat(markers, tjMarkers)}}"
    polyline="{{utils.cat(utils.cat(polylines, tjLines), tjLive)}}"
    polygons="{{polygons}}"
    show-location="{{showCurrentLocation}}"
    enable-zoom="{{!(tjEdit && tjFree)}}"
    enable-scroll="{{!(tjEdit && tjFree)}}"
    enable-rotate="{{false}}"
    enable-poi="{{true}}"
    enable-satellite="{{enableSatellite}}"
    setting="{{mapSetting}}"
    bindmarkertap="onMarkerTap"
    bindtap="onMapTap"
    bindpoitap="onMapPoiTap"
    bindcallouttap="onMapCalloutTap"
    bindtouchstart="onMapTouchStart"
    bindtouchend="onMapTouchEnd"
    bindtouchmove="onMapTouchMove">
  </map>

  <!-- 手绘层：描绘中开着「手绘」时盖住地图接手指，按住拖动连续加航点（地图此时拖不动，关掉即恢复） -->
  <view class="tj-draw-layer" wx:if="{{tjEdit && tjFree}}"
        catchtouchstart="onTjDrawStart" catchtouchmove="onTjDrawMove"
        catchtouchend="onTjDrawEnd" catchtouchcancel="onTjDrawEnd"></view>

  <!-- 描绘横幅（平台 traj-banner）：没选点时 撤销 / 手绘 / 航点 / 结束；选着航点时 删除此点 / 取消 -->
  <view class="tj-banner" wx:if="{{tjEdit}}" style="top: {{navBarTop + navBarHeight + 10}}px;">
    <view class="tj-banner-info">
      <text class="tj-banner-title">{{tjEdit.title}}</text>
      <text class="tj-banner-sub">{{tjEdit.sub}}</text>
    </view>
    <view class="tj-banner-ops" wx:if="{{tjEdit.sel >= 0}}">
      <view class="tj-bop del" bindtap="tjDelSel">删除此点</view>
      <view class="tj-bop" bindtap="tjClearSel">取消</view>
    </view>
    <view class="tj-banner-ops" wx:else>
      <view class="tj-bop {{tjEdit.canUndo ? '' : 'off'}}" bindtap="tjUndo">撤销</view>
      <view class="tj-bop {{tjFree ? 'on' : ''}}" bindtap="toggleTjFree">手绘</view>
      <view class="tj-bop" bindtap="showTjEditPanel">航点</view>
      <view class="tj-bop end" bindtap="tjEnd">结束</view>
    </view>
  </view>

  <!-- 悬浮操作栏 - 与主界面风格一致 -->
  <view class="floating-action-bar" style="top: {{navBarTop}}px; height: {{navBarHeight}}px; left: {{navBarRight}}px;">
    <!-- 返回按钮 -->
    <view class="float-btn" bindtap="goBack">
      <view class="float-icon icon-back"></view>
    </view>
    
    <!-- 卫星选择器 -->
    <view class="float-btn float-btn-satellite" bindtap="showSatelliteSelector" wx:if="{{!pickMode}}">
      <text class="float-satellite-name">{{currentSatellite.name}}</text>
    </view>
    
    <!-- 卫星地图切换按钮 -->
    <view class="float-btn {{enableSatellite ? 'active' : ''}}" bindtap="toggleSatelliteMap" wx:if="{{!pickMode}}">
      <view class="float-icon icon-satellite-map"></view>
    </view>
    
    <!-- 搜索位置按钮 -->
    <view class="float-btn" bindtap="showSearchPanel">
      <view class="float-icon icon-search"></view>
    </view>
  </view>
  
  <!-- 底部功能按钮区 -->
  <view class="bottom-btn-container" wx:if="{{!pickMode}}">
    <!-- 功能按钮组 -->
    <view class="bottom-btn-group {{bottomBtnsCollapsed ? 'collapsed' : ''}}">
      <!-- 等仰角线按钮 -->
      <view class="bottom-btn {{showElevationContours ? 'active' : ''}}" bindtap="showElevationPanel">
        <text class="bottom-btn-text">仰角线</text>
      </view>
      
      <!-- 波束按钮 -->
      <view class="bottom-btn {{showCoverageContours ? 'active' : ''}} {{!hasCoverageData ? 'disabled' : ''}} {{isSwitchingSatellite ? 'disabled' : ''}}" bindtap="showCoveragePanel">
        <text class="bottom-btn-text">波束</text>
      </view>
      
      <!-- 自定义覆盖值按钮 (仅在有覆盖数据时显示) -->
      <view class="bottom-btn {{showCoverageContours ? '' : 'disabled'}} {{isLoadingCoverageData || isSwitchingSatellite ? 'loading' : ''}}" bindtap="showCustomValuePanel" wx:if="{{showCoverageContours}}">
        <text class="bottom-btn-text">{{isLoadingCoverageData ? '加载中' : '自定义'}}</text>
      </view>

      <!-- 航迹按钮（仿真平台发来的航行 / 飞行航迹；有显示中的就高亮） -->
      <view class="bottom-btn {{trajOn > 0 ? 'active' : ''}}" bindtap="showTrajPanel">
        <text class="bottom-btn-text">航迹</text>
      </view>
    </view>

    <!-- 收起/展开小三角按钮 -->
    <view class="bottom-btn-toggle {{bottomBtnsCollapsed ? 'collapsed' : ''}}" bindtap="toggleBottomBtns">
      <view class="toggle-arrow"></view>
    </view>
  </view>
  
  <!-- 等仰角线设置弹窗 -->
  <view class="elevation-popup {{showElevationPopup ? 'show' : ''}}" wx:if="{{showElevationPopup}}">
    <view class="elevation-popup-header">
      <text class="elevation-popup-title">等仰角线设置</text>
      <text class="elevation-popup-close" bindtap="hideElevationPanel">✕</text>
    </view>
    <view class="elevation-popup-body">
      <view class="elevation-tip">输入仰角值（0°-90°），用逗号分隔</view>
      <view class="elevation-input-wrap">
        <input 
          type="text" 
          class="elevation-input-single" 
          placeholder="例如: 5, 10, 20, 30, 45"
          value="{{elevationInputText}}"
          bindinput="onElevationInputText"
        />
      </view>
      <view class="elevation-actions">
        <view class="elevation-btn elevation-btn-cancel" bindtap="hideElevationPanel">取消</view>
        <view class="elevation-btn elevation-btn-clear" bindtap="clearElevationContours">清除</view>
        <view class="elevation-btn elevation-btn-confirm" bindtap="applyElevationAngles">绘制</view>
      </view>
    </view>
  </view>
  
  <!-- 等仰角线弹窗遮罩 -->
  <view class="elevation-popup-mask {{showElevationPopup ? 'show' : ''}}" wx:if="{{showElevationPopup}}" bindtap="hideElevationPanel"></view>
  
  <!-- 覆盖图设置弹窗 -->
  <view class="coverage-popup {{showCoveragePopup ? 'show' : ''}}" wx:if="{{showCoveragePopup}}">
    <view class="coverage-popup-header">
      <text class="coverage-popup-title">覆盖图设置</text>
      <text class="coverage-popup-close" bindtap="hideCoveragePanel">✕</text>
    </view>
    <view class="coverage-popup-body">
      <!-- 类型选择 (EIRP / G·T)：先选类型，再往该类型下导入波束 -->
      <view class="coverage-section">
        <text class="coverage-section-title">类型</text>
        <view class="coverage-tag-group">
          <view class="coverage-tag {{selectedType === 'EIRP' ? 'active' : ''}}" data-type="EIRP" bindtap="onTypeChange">EIRP</view>
          <view class="coverage-tag {{selectedType === 'GT' ? 'active' : ''}}" data-type="GT" bindtap="onTypeChange">G/T</view>
        </view>
      </view>
      
      <!-- 波束（密钥导入为一个波束，可多选绘制；长按标签弹菜单：重命名/删除） -->
      <view class="coverage-section">
        <view class="coverage-section-header">
          <text class="coverage-section-title">波束（可多选，长按重命名/删除）</text>
          <text class="coverage-section-toggle" bindtap="toggleAllBeams">
            {{selectedBeams.length === availableBeams.length && availableBeams.length > 0 ? '取消全选' : '全选'}}
          </text>
        </view>
        <view class="import-row">
          <text class="import-btn" bindtap="showImportPanel">＋ 密钥导入覆盖为波束</text>
        </view>
        <scroll-view scroll-y class="coverage-beam-scroll">
          <view class="coverage-tag-group">
            <view class="coverage-tag beam-tag {{utils.includes(selectedBeams, item.id) ? 'active' : ''}}"
                  wx:for="{{availableBeams}}"
                  wx:key="id"
                  data-id="{{item.id}}"
                  bindtap="onBeamChange"
                  bindlongpress="onBeamLongPress">
              {{item.name}}
            </view>
          </view>
          <view class="beam-empty" wx:if="{{availableBeams.length === 0}}">当前卫星 + 类型下暂无波束，点上方「＋ 密钥导入」添加</view>
        </scroll-view>
        <view class="coverage-section-hint" wx:if="{{selectedBeams.length > 0}}">
          已选择 {{selectedBeams.length}} 个波束
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="coverage-actions">
        <view class="coverage-btn coverage-btn-cancel" bindtap="hideCoveragePanel">取消</view>
        <view class="coverage-btn coverage-btn-clear" bindtap="resetMap">清除内容</view>
        <view class="coverage-btn coverage-btn-confirm" bindtap="loadAndDrawCoverage">绘制</view>
      </view>
    </view>
  </view>
  
  <!-- 覆盖图弹窗遮罩 -->
  <view class="coverage-popup-mask {{showCoveragePopup ? 'show' : ''}}" wx:if="{{showCoveragePopup}}" bindtap="hideCoveragePanel"></view>
  
  <!-- 自定义覆盖值弹窗 -->
  <view class="custom-value-popup {{showCustomValuePopup ? 'show' : ''}}" wx:if="{{showCustomValuePopup}}">
    <view class="custom-value-popup-header">
      <text class="custom-value-popup-title">选择覆盖值</text>
      <text class="custom-value-popup-close" bindtap="hideCustomValuePanel">✕</text>
    </view>
    <view class="custom-value-popup-body">
      <!-- 可用值列表 -->
      <view class="value-list-section">
        <view class="value-list-header">
          <text class="value-list-title">可用值 ({{selectedType === 'GT' ? 'dB/K' : 'dBW'}})</text>
          <text class="value-list-toggle" bindtap="toggleAllGainValues">
            {{selectedGainValues.length === availableGainValues.length ? '取消全选' : '全选'}}
          </text>
        </view>
        <scroll-view scroll-y class="value-list-scroll">
          <view class="value-tag-group">
            <view class="value-tag {{item.selected ? 'selected' : ''}}" 
                  wx:for="{{gainValueItems}}" 
                  wx:key="value"
                  data-value="{{item.value}}"
                  bindtap="toggleGainValue">
              {{item.value}}
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 自定义输入 -->
      <view class="custom-input-section">
        <text class="custom-input-label">或输入特定值（逗号分隔）</text>
        <input 
          type="text" 
          class="custom-input" 
          placeholder="例如: 40, 42, 45"
          value="{{customValueInput}}"
          bindinput="onCustomValueInput"
        />
      </view>
      
      <!-- 显示波束名开关 -->
      <view class="beam-label-section">
        <text class="beam-label-text">显示波束名</text>
        <view class="beam-label-switch {{showBeamLabels ? 'active' : ''}}" bindtap="toggleBeamLabels">
          <view class="beam-label-switch-track">
            <view class="beam-label-switch-thumb"></view>
          </view>
        </view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="custom-value-actions">
        <view class="custom-value-btn custom-value-btn-cancel" bindtap="hideCustomValuePanel">取消</view>
        <view class="custom-value-btn custom-value-btn-confirm" bindtap="applyCoverageSelection">应用</view>
      </view>
    </view>
  </view>
  
  <!-- 自定义覆盖值弹窗遮罩 -->
  <view class="custom-value-popup-mask {{showCustomValuePopup ? 'show' : ''}}" wx:if="{{showCustomValuePopup}}" bindtap="hideCustomValuePanel"></view>
  
  <!-- 自定义覆盖值弹窗 -->
  <view class="custom-value-popup {{showCustomValuePopup ? 'show' : ''}}" wx:if="{{showCustomValuePopup}}">
    <view class="custom-value-popup-header">
      <text class="custom-value-popup-title">选择覆盖值</text>
      <text class="custom-value-popup-close" bindtap="hideCustomValuePanel">✕</text>
    </view>
    <view class="custom-value-popup-body">
      <!-- 可用值列表 -->
      <view class="value-list-section">
        <view class="value-list-header">
          <text class="value-list-title">可用值 ({{selectedType === 'GT' ? 'dB/K' : 'dBW'}})</text>
          <text class="value-list-toggle" bindtap="toggleAllGainValues">
            {{selectedGainValues.length === availableGainValues.length ? '取消全选' : '全选'}}
          </text>
        </view>
        <scroll-view scroll-y class="value-list-scroll">
          <view class="value-tag-group">
            <view class="value-tag {{item.selected ? 'selected' : ''}}" 
                  wx:for="{{gainValueItems}}" 
                  wx:key="value"
                  data-value="{{item.value}}"
                  bindtap="toggleGainValue">
              {{item.value}}
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 自定义输入 -->
      <view class="custom-input-section">
        <text class="custom-input-label">或输入特定值（逗号分隔）</text>
        <input 
          type="text" 
          class="custom-input" 
          placeholder="例如: 40, 42, 45"
          value="{{customValueInput}}"
          bindinput="onCustomValueInput"
        />
      </view>
      
      <!-- 显示波束名开关 -->
      <view class="beam-label-section">
        <text class="beam-label-text">显示波束名</text>
        <view class="beam-label-switch {{showBeamLabels ? 'active' : ''}}" bindtap="toggleBeamLabels">
          <view class="beam-label-switch-track">
            <view class="beam-label-switch-thumb"></view>
          </view>
        </view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="custom-value-actions">
        <view class="custom-value-btn custom-value-btn-cancel" bindtap="hideCustomValuePanel">取消</view>
        <view class="custom-value-btn custom-value-btn-confirm" bindtap="applyCoverageSelection">应用</view>
      </view>
    </view>
  </view>
  
  <!-- 自定义覆盖值弹窗遮罩 -->
  <view class="custom-value-popup-mask {{showCustomValuePopup ? 'show' : ''}}" wx:if="{{showCustomValuePopup}}" bindtap="hideCustomValuePanel"></view>
  
  <!-- 位置搜索弹窗 -->
  <view class="search-popup {{showSearchPopup ? 'show' : ''}}" wx:if="{{showSearchPopup}}">
    <view class="search-popup-header">
      <text class="search-popup-title">搜索位置</text>
      <text class="search-popup-close" bindtap="hideSearchPanel">✕</text>
    </view>
    <!-- 显示当前位置开关 -->
    <view class="search-toolbar">
      <view class="search-toolbar-left" bindtap="toggleShowLocation">
        <switch checked="{{showCurrentLocation}}" color="#2563eb" class="search-location-switch" />
        <text class="search-toolbar-label">显示当前位置</text>
      </view>
    </view>
    <view class="search-popup-body">
      <!-- 搜索方式切换 -->
      <view class="search-mode-tabs">
        <view class="search-mode-tab {{searchMode === 'location' ? 'active' : ''}}" bindtap="switchSearchMode" data-mode="location">
          <text>地点搜索</text>
        </view>
        <view class="search-mode-tab {{searchMode === 'coordinate' ? 'active' : ''}}" bindtap="switchSearchMode" data-mode="coordinate">
          <text>经纬度</text>
        </view>
      </view>
      
      <!-- 地点搜索模式 -->
      <view class="search-content" wx:if="{{searchMode === 'location'}}">
        <view class="search-input-wrap">
          <input 
            type="text" 
            class="search-input" 
            placeholder="输入城市、地标或地址"
            value="{{searchKeyword}}"
            bindinput="onSearchKeywordInput"
            bindconfirm="searchLocation"
          />
          <view class="search-input-btn" bindtap="searchLocation">
            <view class="search-icon-small"></view>
          </view>
        </view>
        <!-- 关键词建议列表 -->
        <scroll-view scroll-y class="suggestion-list" wx:if="{{showSuggestions && suggestionList.length > 0}}">
          <view class="suggestion-item" 
                wx:for="{{suggestionList}}" 
                wx:key="index"
                bindtap="selectSuggestion"
                data-index="{{index}}">
            <view class="suggestion-icon">
              <view class="suggestion-pin-icon"></view>
            </view>
            <view class="suggestion-info">
              <text class="suggestion-title">{{item.title}}</text>
              <text class="suggestion-address">{{item.address}}</text>
            </view>
          </view>
        </scroll-view>
        <!-- 搜索结果列表 -->
        <scroll-view scroll-y class="search-results" wx:if="{{!showSuggestions && searchResults.length > 0}}">
          <view class="search-result-item" 
                wx:for="{{searchResults}}" 
                wx:key="index"
                bindtap="selectSearchResult"
                data-index="{{index}}">
            <text class="search-result-name">{{item.name}}</text>
            <text class="search-result-address">{{item.address}}</text>
          </view>
        </scroll-view>
        <!-- 无结果提示 -->
        <view class="search-no-result" wx:if="{{!showSuggestions && searchNoResult}}">
          <text>未找到相关位置</text>
        </view>
      </view>
      
      <!-- 经纬度输入模式 -->
      <view class="search-content" wx:if="{{searchMode === 'coordinate'}}">
        <view class="coordinate-input-group">
          <view class="coordinate-input-item">
            <text class="coordinate-label">纬度 (Lat)</text>
            <input 
              type="text" 
              class="coordinate-input" 
              placeholder="-90 到 90"
              value="{{inputLatitude}}"
              bindinput="onLatitudeInput"
            />
          </view>
          <view class="coordinate-input-item">
            <text class="coordinate-label">经度 (Lon)</text>
            <input 
              type="text" 
              class="coordinate-input" 
              placeholder="-180 到 180"
              value="{{inputLongitude}}"
              bindinput="onLongitudeInput"
            />
          </view>
        </view>
        <view class="coordinate-tip">提示：正纬度为北纬，负纬度为南纬；正经度为东经，负经度为西经</view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="search-actions">
        <view class="search-btn search-btn-clear" bindtap="clearAllSearchMarkers">清除所有标记</view>
        <view class="search-btn search-btn-mylocation" bindtap="goToMyLocation">我的位置</view>
        <view class="search-btn search-btn-confirm" bindtap="confirmSearch">定位</view>
      </view>
    </view>
  </view>
  
  <!-- 位置搜索遮罩 -->
  <view class="search-popup-mask {{showSearchPopup ? 'show' : ''}}" wx:if="{{showSearchPopup}}" bindtap="hideSearchPanel"></view>
  
  <!-- 卫星选择弹窗 -->
  <view class="satellite-popup {{showSatellitePopup ? 'show' : ''}}" wx:if="{{showSatellitePopup}}">
    <view class="satellite-popup-header">
      <text class="satellite-popup-title">选择卫星</text>
      <view class="satellite-header-actions">
        <text class="satellite-add-btn" bindtap="showCustomSatPanel">＋自定义卫星</text>
        <text class="satellite-popup-close" bindtap="hideSatelliteSelector">✕</text>
      </view>
    </view>
    <scroll-view scroll-y class="satellite-popup-list">
      <view class="satellite-popup-item {{satelliteIndex === index ? 'active' : ''}}"
            wx:for="{{satellites}}"
            wx:key="index"
            bindtap="onSatelliteChange"
            data-index="{{index}}">
        <view class="satellite-popup-name-wrap">
          <text class="satellite-popup-name">{{item.name}}</text>
          <text wx:if="{{item.custom}}" class="satellite-custom-badge">自定义</text>
        </view>
        <view class="satellite-popup-right">
          <text class="satellite-popup-position">{{item.position}}°E</text>
          <text wx:if="{{item.custom}}" class="satellite-del-btn" catchtap="onDeleteCustomSat" data-index="{{index}}">✕</text>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 卫星选择遮罩 -->
  <view class="satellite-popup-mask {{showSatellitePopup ? 'show' : ''}}" wx:if="{{showSatellitePopup}}" bindtap="hideSatelliteSelector"></view>

  <!-- 自定义卫星弹窗 -->
  <view class="coverage-popup custom-sat-popup {{showCustomSatPopup ? 'show' : ''}}" wx:if="{{showCustomSatPopup}}">
    <view class="coverage-popup-header">
      <text class="coverage-popup-title">自定义卫星</text>
      <text class="coverage-popup-close" bindtap="hideCustomSatPanel">✕</text>
    </view>
    <view class="coverage-popup-body">
      <view class="import-tip">添加一颗 GEO 卫星（仅名称与轨位；覆盖数据仍由「密钥导入」的波束提供）。</view>
      <view class="custom-sat-field">
        <text class="custom-sat-label">卫星名称</text>
        <input type="text" class="elevation-input-single" placeholder="如 MYSAT 1" value="{{customSatName}}" bindinput="onCustomSatNameInput" />
      </view>
      <view class="custom-sat-field">
        <text class="custom-sat-label">轨位（东经为正，−180 ~ 180°）</text>
        <input type="text" class="elevation-input-single" placeholder="如 110.5" value="{{customSatPosition}}" bindinput="onCustomSatPositionInput" />
      </view>
      <view class="coverage-actions">
        <view class="coverage-btn coverage-btn-cancel" bindtap="hideCustomSatPanel">取消</view>
        <view class="coverage-btn coverage-btn-confirm" bindtap="confirmAddCustomSat">添加</view>
      </view>
    </view>
  </view>
  <view class="coverage-popup-mask custom-sat-mask {{showCustomSatPopup ? 'show' : ''}}" wx:if="{{showCustomSatPopup}}" bindtap="hideCustomSatPanel"></view>

  <!-- 航迹弹窗：仿真平台发来的 / 手机上手绘的航行 / 飞行航迹。点整行显示 / 隐藏，行上四个操作 -->
  <view class="coverage-popup traj-popup {{showTrajPopup ? 'show' : ''}}" wx:if="{{showTrajPopup}}">
    <view class="coverage-popup-header">
      <text class="coverage-popup-title">航迹</text>
      <view class="traj-header-actions">
        <text class="coverage-section-toggle" wx:if="{{trajRows.length > 1}}" bindtap="toggleAllTrajs">{{trajAllOn ? '全部隐藏' : '全部显示'}}</text>
        <text class="coverage-popup-close" bindtap="hideTrajPanel">✕</text>
      </view>
    </view>
    <view class="coverage-popup-body">
      <view class="traj-head">
        <text class="import-btn" data-kind="sea" bindtap="onTrajNew">＋ 航行</text>
        <text class="import-btn" data-kind="flight" bindtap="onTrajNew">＋ 飞行</text>
        <text class="import-btn" bindtap="showTrajImport">＋ 密钥导入</text>
      </view>
      <scroll-view scroll-y class="traj-scroll">
        <view class="traj-row {{item.on ? '' : 'off'}} {{item.editing ? 'editing' : ''}}" wx:for="{{trajRows}}" wx:key="id" data-id="{{item.id}}" bindtap="onTrajToggle">
          <view class="traj-chk {{item.on ? 'on' : ''}}"></view>
          <image wx:if="{{item.icon}}" class="traj-glyph" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="traj-main">
            <view class="traj-name-wrap">
              <text class="traj-name">{{item.name}}</text>
              <text wx:if="{{item.local}}" class="traj-badge">本机</text>
            </view>
            <view class="traj-meta">
              <view class="traj-swatch {{item.dash ? 'dash' : ''}}" style="border-top-color: {{item.color}};"></view>
              <text class="traj-sub">{{item.sub}}</text>
            </view>
          </view>
          <!-- 四个操作排成两行两列：一字排开时名字只剩三四个字、读数也被截掉 -->
          <view class="traj-ops">
            <text class="traj-op {{item.editing ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onTrajEdit">{{item.editing ? '编辑中' : '编辑'}}</text>
            <text class="traj-op" data-id="{{item.id}}" catchtap="onTrajLocate">定位</text>
            <text class="traj-op" data-id="{{item.id}}" catchtap="onTrajRename">改名</text>
            <text class="traj-op del" data-id="{{item.id}}" catchtap="onTrajDelete">移除</text>
          </view>
        </view>
        <view class="beam-empty" wx:if="{{trajRows.length === 0}}">暂无航迹。</view>
      </scroll-view>
    </view>
  </view>
  <view class="coverage-popup-mask {{showTrajPopup ? 'show' : ''}}" wx:if="{{showTrajPopup}}" bindtap="hideTrajPanel"></view>

  <!-- 「航点」面板（描绘横幅打开；平台侧栏的航迹卡）：名称 / 颜色 / 航点列表（点行 = 在图上选中，改坐标、删点）/ 按经纬度加点 -->
  <view class="coverage-popup tj-edit-popup {{showTjEditPopup ? 'show' : ''}}" wx:if="{{showTjEditPopup && tjSheet}}">
    <view class="coverage-popup-header">
      <text class="coverage-popup-title">编辑航迹</text>
      <text class="coverage-popup-close" bindtap="hideTjEditPanel">✕</text>
    </view>
    <view class="coverage-popup-body">
      <view class="tj-field">
        <text class="tj-label">名称</text>
        <input class="elevation-input-single tj-input" type="text" maxlength="40" value="{{tjSheet.name}}"
               bindinput="onTjNameInput" bindblur="onTjNameBlur" bindconfirm="onTjNameBlur" />
      </view>
      <view class="tj-field">
        <text class="tj-label">颜色</text>
        <view class="tj-colors">
          <text class="tj-color-def {{tjSheet.color ? '' : 'on'}}" data-c="" bindtap="onTjColor">默认</text>
          <view wx:for="{{tjPalette}}" wx:key="*this" class="tj-color {{tjSheet.color === item ? 'on' : ''}}"
                style="background: {{item}};" data-c="{{item}}" bindtap="onTjColor"></view>
        </view>
      </view>
      <text class="tj-label tj-wp-title">航点（{{tjSheet.n}}）</text>
      <scroll-view scroll-y class="tj-wp-scroll" scroll-into-view="{{tjWpInto}}">
        <block wx:for="{{tjSheet.rows}}" wx:key="k">
          <view wx:if="{{item.gap}}" class="tj-wp-gap">… 中间 {{item.gap}} 点 …</view>
          <view wx:else id="tjwp{{item.i}}" class="tj-wp-row {{tjEdit.sel === item.i ? 'sel' : ''}}" data-i="{{item.i}}" bindtap="onTjWpPick">
            <text class="tj-wp-no">{{item.no}}</text>
            <text class="tj-wp-ll">{{item.ll}}</text>
            <text class="tj-wp-km">{{item.km}}</text>
            <text class="traj-op" data-i="{{item.i}}" catchtap="onTjWpEdit">改</text>
            <text class="traj-op del" data-i="{{item.i}}" catchtap="onTjWpDel">删</text>
          </view>
        </block>
        <view class="beam-empty" wx:if="{{!tjSheet.n}}">暂无航点。</view>
      </scroll-view>
      <view class="tj-wp-add">
        <input class="elevation-input-single tj-input" type="text" placeholder="纬度" value="{{tjWpLat}}" bindinput="onTjWpLatInput" />
        <input class="elevation-input-single tj-input" type="text" placeholder="经度" value="{{tjWpLon}}" bindinput="onTjWpLonInput" />
        <view class="coverage-btn coverage-btn-confirm tj-wp-addbtn" bindtap="onTjWpAdd">加点</view>
      </view>
    </view>
  </view>
  <view class="coverage-popup-mask {{showTjEditPopup ? 'show' : ''}}" wx:if="{{showTjEditPopup && tjSheet}}" bindtap="hideTjEditPanel"></view>

  <!-- 密钥导入弹窗（波束面板与航迹面板共用：同一条云函数，包里有什么就落什么） -->
  <view class="coverage-popup {{showImportPopup ? 'show' : ''}}" wx:if="{{showImportPopup}}">
    <view class="coverage-popup-header">
      <text class="coverage-popup-title">{{importMode === 'traj' ? '导入航迹' : '导入覆盖数据'}}</text>
      <text class="coverage-popup-close" bindtap="hideImportPanel">✕</text>
    </view>
    <view class="coverage-popup-body">
      <view class="import-tip" wx:if="{{importMode !== 'traj'}}">在仿真平台点「导出 › 发送覆盖图到小程序」生成密钥后在此输入。导入的覆盖将作为「{{currentSatellite.name}} · {{selectedType === 'GT' ? 'G/T' : 'EIRP'}}」下的一个波束。</view>
      <!-- 8 位密钥分格输入（验证码风格：中间只读“-”分隔，隐形 input 覆盖全区承接键盘/粘贴/退格） -->
      <view class="otp-field {{importKeyFocus ? 'is-focused' : ''}}" bindtap="focusOtp">
        <block wx:for="{{otpCells}}" wx:key="id">
          <view wx:if="{{item.sep}}" class="otp-dash">-</view>
          <view wx:else class="otp-cell {{item.filled ? 'is-filled' : ''}} {{item.active && importKeyFocus ? 'is-active' : ''}}">
            <text wx:if="{{item.char}}" class="otp-cell-char">{{item.char}}</text>
            <view wx:if="{{item.active && importKeyFocus && !item.char}}" class="otp-caret"></view>
          </view>
        </block>
        <input class="otp-input" type="text" maxlength="11" value="{{importKeyInput}}"
               focus="{{importKeyFocus}}" cursor="{{importKeyInput.length}}" confirm-type="done" hold-keyboard="{{true}}"
               adjust-position="{{false}}"
               bindinput="onImportKeyInput" bindfocus="onOtpFocus" bindblur="onOtpBlur" />
      </view>
      <view class="otp-hint">8 位字母 / 数字，如 ABCD-2345</view>
      <input wx:if="{{importMode !== 'traj'}}" type="text" class="elevation-input-single import-name-input" placeholder="波束名称（可选，默认取快照名）" value="{{importBeamName}}" bindinput="onImportNameInput" />
      <view class="coverage-actions">
        <view class="coverage-btn coverage-btn-cancel" bindtap="hideImportPanel">取消</view>
        <view class="coverage-btn coverage-btn-confirm {{importing ? 'disabled' : ''}}" bindtap="confirmImport">{{importing ? '导入中...' : '导入'}}</view>
      </view>
    </view>
  </view>
  <view class="coverage-popup-mask {{showImportPopup ? 'show' : ''}}" wx:if="{{showImportPopup}}" bindtap="hideImportPanel"></view>

  <!-- 波束重命名改为「长按波束标签 → 操作菜单」，旧批量编辑弹窗已移除 -->

  <!-- 加载状态 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <view class="loading-text">正在加载...</view>
    </view>
  </view>
</view>
