/* 底部等仰角线按钮 */
.bottom-elevation-btn {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 20px);
  left: 50%;
  transform: translateX(-50%);
  min-width: 50px;
  height: 32px;
  padding: 0 16px;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
}

.bottom-elevation-btn:active {
  transform: translateX(-50%) scale(0.95);
}

.bottom-elevation-btn.active {
  background: rgba(37, 99, 235, 0.9);
}

.bottom-elevation-text {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1px;
}

/* 底部按钮组 */
.bottom-btn-container {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 60px);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
}

.bottom-btn-group {
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
  opacity: 1;
  transform: translateY(0);
  max-height: 50px;
  overflow: hidden;
}

.bottom-btn-group.collapsed {
  opacity: 0;
  transform: translateY(20px);
  max-height: 0;
  pointer-events: none;
}

/* 收起/展开小三角按钮 */
.bottom-btn-toggle {
  margin-top: 6px;
  width: 36px;
  height: 20px;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.bottom-btn-toggle.collapsed {
  margin-top: 0;
  margin-bottom: 6px;
}

.toggle-arrow {
  width: 0;
  height: 0;
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-top: 6px solid #ffffff;
  transition: transform 0.3s ease;
}

.bottom-btn-toggle.collapsed .toggle-arrow {
  transform: rotate(180deg);
}

.bottom-btn {
  min-width: 40px;
  height: 32px;
  padding: 0 12px;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.95);
}

.bottom-btn.active {
  background: rgba(37, 99, 235, 0.9);
}

.bottom-btn.disabled {
  background: rgba(0, 0, 0, 0.3);
  opacity: 0.5;
}

.bottom-btn.loading {
  background: rgba(100, 100, 100, 0.7);
  opacity: 0.7;
}

/* 清除按钮样式 */
.bottom-btn.bottom-btn-clear {
  background: rgba(220, 53, 69, 0.85);
  min-width: 32px;
  padding: 0 8px;
}

.bottom-btn.bottom-btn-clear:active {
  background: rgba(200, 35, 51, 0.95);
}

/* 垃圾桶图标 - 使用纯CSS绘制 */
.trash-icon {
  position: relative;
  width: 14px;
  height: 16px;
}

.trash-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 2px;
  background: #ffffff;
  border-radius: 1px;
}

.trash-icon::after {
  content: '';
  position: absolute;
  top: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 12px;
  height: 11px;
  border: 2px solid #ffffff;
  border-top: none;
  border-radius: 0 0 2px 2px;
  box-sizing: border-box;
}

.bottom-btn-text {
  font-size: 13px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5px;
}

/* 激活状态的按钮 */
.float-btn-active,
.float-btn.active {
  background: rgba(37, 99, 235, 0.8) !important;
  border-color: rgba(37, 99, 235, 0.5) !important;
}

/* 卫星选择按钮 */
.float-btn-satellite {
  flex: 1;
  max-width: 140px;
}

.float-satellite-name {
  font-size: 12px;
  color: #ffffff;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 覆盖状态按钮 */
.float-btn-status {
  min-width: auto;
  padding: 0 8px;
}

.float-btn-status.in-coverage {
  background: rgba(34, 197, 94, 0.8);
  border-color: rgba(34, 197, 94, 0.3);
}

.float-btn-status.out-coverage {
  background: rgba(239, 68, 68, 0.8);
  border-color: rgba(239, 68, 68, 0.3);
}

.float-status-text {
  font-size: 11px;
  color: #ffffff;
  font-weight: 500;
}

/* 卫星选择弹窗 */
.satellite-popup {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 44px);
  left: 8px;
  right: 8px;
  max-height: 60vh;
  background: #ffffff;
  border-radius: 4px;
  z-index: 1001;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15), 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
}

.satellite-popup.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.satellite-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
}

.satellite-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.satellite-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-bottom: 1px solid #e5e7eb;
  flex-shrink: 0;
}

.satellite-popup-title {
  font-size: 14px;
  font-weight: 600;
  color: #1f2937;
}

.satellite-popup-close {
  font-size: 16px;
  color: #9ca3af;
  padding: 4px;
}

.satellite-popup-list {
  flex: 1;
  overflow-y: auto;
}

.satellite-popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-bottom: 1px solid #f3f4f6;
  transition: background 0.15s ease;
}

.satellite-popup-item:active {
  background: #f3f4f6;
}

.satellite-popup-item.active {
  background: #eff6ff;
}

.satellite-popup-item.active .satellite-popup-name {
  color: #2563eb;
  font-weight: 600;
}

.satellite-popup-name {
  font-size: 14px;
  color: #1f2937;
}

.satellite-popup-position {
  font-size: 12px;
  color: #6b7280;
}

/* 加载遮罩 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 30px;
  height: 30px;
  border: 2px solid #e0e0e0;
  border-top-color: #2C3E50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 10px;
  font-size: 13px;
  color: #666666;
}

