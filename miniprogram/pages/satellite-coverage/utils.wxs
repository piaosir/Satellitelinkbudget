/**
 * WXS 工具模块 - 用于模板中的辅助函数
 */

/**
 * 判断数组是否包含某个元素
 * @param {Array} arr - 数组
 * @param {any} item - 要查找的元素
 * @returns {boolean} 是否包含
 */
function includes(arr, item) {
  if (!arr || !arr.length) return false;
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === item) {
      return true;
    }
  }
  return false;
}

module.exports = {
  includes: includes
};
