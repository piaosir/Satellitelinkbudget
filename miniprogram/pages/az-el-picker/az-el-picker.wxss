page {
  background: #ffffff;
}

.container {
  position: relative;
  width: 100%;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100vh;
}

.top-bar {
  position: fixed;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-btn {
  min-width: 88rpx;
  height: 100%;
  padding: 0 18rpx;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.satellite-picker {
  height: 100%;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 280rpx;
  font-size: 24rpx;
}

.panel {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 20rpx;
  z-index: 20;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.title {
  display: block;
  font-size: 24rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.coord {
  display: block;
  font-size: 22rpx;
  color: #374151;
  margin-bottom: 4rpx;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.btn {
  flex: 1;
  text-align: center;
  border-radius: 8rpx;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-ghost {
  color: #334155;
  background: #e2e8f0;
}

.btn-primary {
  color: #ffffff;
  background: #0f172a;
}
