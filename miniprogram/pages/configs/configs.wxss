/* configs.wxss */

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  margin-bottom: 0;
  border-bottom: 2px solid #d0d0d0;
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.config-list {
  padding: 0;
}

.config-card {
  background: #ffffff;
  border-radius: 0;
  padding: 24rpx 32rpx;
  margin-bottom: 1px;
  box-shadow: none;
  border: 1px solid #d0d0d0;
  border-top: none;
}

.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #d0d0d0;
}

.config-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.config-date {
  font-size: 22rpx;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.config-info {
  margin-bottom: 16rpx;
}

.config-info-item {
  display: flex;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.config-info-item .label {
  color: #4a4a4a;
  width: 140rpx;
  font-family: 'Courier New', 'Consolas', monospace;
}

.config-info-item .value {
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
  font-family: 'Courier New', 'Consolas', monospace;
}

.config-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.action-btn.load {
  background: #2a2a2a;
  color: #ffffff;
  border: 1px solid #2a2a2a;
}

.action-btn.report {
  background: #ffffff;
  color: #52c41a;
  border: 1px solid #52c41a;
}

.action-btn.share {
  background: #ffffff;
  color: #1890ff;
  border: 1px solid #1890ff;
}

.action-btn.delete {
  background: #ffffff;
  color: #c41e3a;
  border: 1px solid #c41e3a;
}

.empty-icon {
  font-size: 160rpx;
  opacity: 0.3;
}
