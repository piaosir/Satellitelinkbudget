.qrcode-btn {
  background: rgba(0, 0, 0, 0.6) !important;
}

/* 批量分享二维码面板 */
.batch-qr-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.batch-qr-panel-mask.show {
  opacity: 1;
  visibility: visible;
}

.batch-qr-panel {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  z-index: 1001;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.batch-qr-panel.show {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

.batch-qr-card {
  width: 580rpx;
  background: #ffffff;
  border-radius: 0;
  border: 1rpx solid #1a1a1a;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

/* 关闭按钮 */
.batch-qr-close-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #999999;
  z-index: 10;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.batch-qr-close-btn:active {
  background: rgba(0, 0, 0, 0.05);
}

.batch-qr-body {
  padding: 32rpx;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 加载状态 */
.batch-qr-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background: transparent;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(26, 26, 26, 0.2);
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 二维码图片区域 */
.batch-qr-image-container {
  width: 400rpx;
  height: 400rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.batch-qr-image {
  width: 380rpx;
  height: 380rpx;
}

/* 没有图片时的备用显示 */
.batch-qr-code-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.batch-code-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.batch-code-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* 配置信息 */
.batch-qr-info {
  margin-top: 24rpx;
  text-align: center;
}

.batch-qr-count {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.count-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.count-label {
  font-size: 28rpx;
  color: #666666;
}

.batch-qr-names {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
  max-width: 500rpx;
}

.config-name-item {
  font-size: 22rpx;
  color: #666666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.config-name-more {
  font-size: 22rpx;
  color: #999999;
}

/* 批次码行 */
.batch-code-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 0;
  width: 100%;
  box-sizing: border-box;
}

.batch-code-label {
  font-size: 26rpx;
  color: #666666;
}

.batch-code-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.batch-code-copy {
  font-size: 24rpx;
  color: #ffffff;
  background: #1a1a1a;
  padding: 8rpx 20rpx;
  border-radius: 4rpx;
}

.batch-code-copy:active {
  background: #000000;
}

/* 提示文字 */
.batch-qr-tips {
  margin-top: 24rpx;
  text-align: center;
}

.tip-text {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.6;
}

/* 批量导入面板 */
.batch-import-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.batch-import-panel-mask.show {
  opacity: 1;
  visibility: visible;
}

