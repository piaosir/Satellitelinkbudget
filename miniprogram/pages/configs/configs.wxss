.batch-import-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
}

.batch-import-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
