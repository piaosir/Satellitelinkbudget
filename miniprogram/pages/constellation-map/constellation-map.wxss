.page {
  position: relative;
  height: 100vh;
  background: #0a0e1a;
  color: #d6dee8;
  overflow: hidden;
}

/* 顶部控制条（浮于地球之上，半透明） */
.ctrl-zone {
  position: relative;
  z-index: 5;
  padding: 16rpx 24rpx 12rpx;
  background: rgba(12, 19, 34, 0.82);
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.18);
}
.ctrl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ctrl-label {
  font-size: 26rpx;
  color: #8aa0b8;
}
.grp-picker {
  flex: 0 0 auto;
}
.grp-value {
  font-size: 30rpx;
  color: #e6edf5;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.14);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
}
.grp-caret {
  color: #7bb4cc;
  font-size: 22rpx;
}
/* 搜索框 */
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
  padding: 0 16rpx;
  height: 60rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #e6edf5;
  height: 60rpx;
  line-height: 60rpx;
}
.search-input::placeholder {
  color: #66788c;
}
.search-clear {
  font-size: 26rpx;
  color: #8aa0b8;
  padding-left: 12rpx;
}

/* 时间轴行：旋转/实时开关 + 拖动轨道 + 时刻读数 */
.tl-row {
  margin-top: 12rpx;
  gap: 12rpx;
}
.tl-row .btn-mini {
  flex: 0 0 auto;
}
/* 自定义进度条：细轨 + 渐变填充 + 小巧圆点（与星间链路一致） */
.tb-track {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 56rpx;            /* 透明大触区，整条轨道可点可拖 */
  margin: 0 22rpx;          /* 留出圆点半径+光晕的余量，端点处不压住时间读数 */
  display: flex;
  align-items: center;
}
.tb-bar {
  position: relative;
  width: 100%;
  height: 8rpx;
  background: rgba(90, 130, 165, 0.18);
  border-radius: 8rpx;
  overflow: hidden;
}
.tb-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, #3f7f96, #7fd4ec);
  border-radius: 6rpx;
}
.tb-knob {
  position: absolute;
  top: 50%;
  width: 26rpx;
  height: 26rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #eaf6fb;
  border: 2rpx solid #cfe9f3;
  transition: width .08s, height .08s;
  animation: tbPulse 2.2s ease-in-out infinite;
}
/* 按住轨道时放大圆点，给出抓取反馈，落点更直观 */
.tb-track:active .tb-knob {
  width: 38rpx;
  height: 38rpx;
}
/* 呼吸光晕：内圈实色点 + 外圈柔光，缓慢起伏，既显眼又不喧宾夺主（与星间链路一致） */
@keyframes tbPulse {
  0%, 100% { box-shadow: 0 0 0 3rpx rgba(127,212,236,0.22), 0 0 10rpx 2rpx rgba(127,212,236,0.45); }
  50%      { box-shadow: 0 0 0 5rpx rgba(127,212,236,0.32), 0 0 18rpx 4rpx rgba(127,212,236,0.7); }
}
.tb-time {
  font-size: 20rpx;
  color: #8ab4cc;
  flex-shrink: 0;
  text-align: right;
  min-width: 96rpx;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
/* 精调步进：等宽铺满，加大点按目标 */
.tb-steps {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}
.tb-step, .tb-now {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 10rpx 0;
  color: #b9c8d8;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 6rpx;
}
.tb-step:active, .tb-now:active {
  background: rgba(90, 130, 165, 0.24);
}
.tb-now {
  color: #cfe0ee;
  border-color: rgba(123, 180, 204, 0.5);
}
.tb-dis {
  opacity: 0.34;
}

/* 搜索结果下拉 */
.search-panel {
  margin-top: 12rpx;
  background: rgba(10, 16, 28, 0.96);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 12rpx;
  overflow: hidden;
}
.search-scroll {
  max-height: 420rpx;
}
.search-item {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.12);
}
.si-name {
  display: block;
  font-size: 28rpx;
  color: #e6edf5;
}
.si-sub {
  display: block;
  font-size: 22rpx;
  color: #7f93a8;
  margin-top: 4rpx;
}

.btn-mini {
  font-size: 24rpx;
  color: #b9c8d8;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 10rpx;
}
.btn-on {
  color: #9fd0ef;
  border-color: rgba(123, 180, 204, 0.6);
}

/* 3D 地球：绝对铺满整页，尺寸恒定，不受控制条/信息卡布局变化影响（避免非等比拉伸变形） */
.globe-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}
.globe-canvas {
  width: 100%;
  height: 100%;
}
.globe-hint {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(150, 180, 210, 0.5);
}
/* 数据元信息浮层：地球底部左侧，位于提示行之上（选中星时被信息卡覆盖，符合上下文） */
.globe-meta {
  position: absolute;
  left: 24rpx;
  bottom: 52rpx;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx 18rpx;
  max-width: 72%;
}
.gm-item {
  font-size: 22rpx;
  color: rgba(150, 180, 210, 0.72);
}
.gm-load {
  font-size: 22rpx;
  color: #7bb4cc;
}
.gm-warn {
  font-size: 22rpx;
  color: #c2a25e;
}

/* 信息卡：浮层固定底部，不挤压地球画布 */
.sat-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(12, 19, 34, 0.94);
  border-top: 1rpx solid rgba(110, 145, 180, 0.2);
  border-radius: 18rpx 18rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.35);
  padding: 20rpx 24rpx 28rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.card-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6edf5;
}
.card-slot {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffd27a;
  flex: 0 0 auto;
}
.card-close {
  font-size: 30rpx;
  color: #8aa0b8;
  padding: 0 10rpx;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 14rpx;
}
.kv {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}
.kv-wide {
  grid-column: span 2;
}
.kv .k {
  font-size: 20rpx;
  color: #7f93a8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.kv .v {
  font-size: 26rpx;
  color: #dfe6ee;
  white-space: nowrap;
}
/* 顶部波束角设置条（选中卫星后出现）：与搜索框/按钮同一视觉体系 */
.beam-bar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.beam-bar-l {
  font-size: 26rpx;
  color: #8aa0b8;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.beam-bar-in {
  width: 160rpx;
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #e6edf5;
}
.beam-bar-in::placeholder {
  color: #66788c;
}
.beam-bar-u {
  font-size: 24rpx;
  color: #8aa0b8;
  flex-shrink: 0;
  margin-left: 10rpx;
}
/* 锁定按钮：纯 SVG 锁图标，无边框无底框，图标即按钮 */
.beam-lock {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 40rpx;
  height: 40rpx;
}
/* 未选星时的占位提示，使常显的控制行左侧不空 */
.beam-bar-hint {
  font-size: 24rpx;
  color: #66788c;
}
/* 旋转/实时开关：靠右常显（选星时填补锁按钮后的空白） */
.beam-bar-toggles {
  margin-left: auto;
  display: flex;
  gap: 12rpx;
}
.card-legend {
  display: flex;
  gap: 26rpx;
  margin-top: 14rpx;
}
.card-legend .lg {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9aacbe;
}
.lg-dot {
  display: inline-block;
  width: 18rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}
.dot-orbit { background: #6f9fc8; }
.dot-track { background: #c2a25e; }
.dot-foot { background: #7bb4cc; }
