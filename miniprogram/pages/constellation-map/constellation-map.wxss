.page {
  position: relative;
  height: 100vh;
  background: #0a0e1a;
  color: #d6dee8;
  overflow: hidden;
}

/* 顶部控制条（浮于地球之上，半透明） */
.ctrl-zone {
  position: relative;
  z-index: 5;
  padding: 16rpx 24rpx 12rpx;
  background: rgba(12, 19, 34, 0.82);
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.18);
}
.ctrl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ctrl-label {
  font-size: 26rpx;
  color: #8aa0b8;
}
.grp-picker {
  flex: 0 0 auto;
}
.grp-value {
  font-size: 30rpx;
  color: #e6edf5;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.14);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
}
.grp-caret {
  color: #7bb4cc;
  font-size: 22rpx;
}
/* 搜索框 */
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
  padding: 0 16rpx;
  height: 60rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #e6edf5;
  height: 60rpx;
  line-height: 60rpx;
}
.search-input::placeholder {
  color: #66788c;
}
.search-clear {
  font-size: 26rpx;
  color: #8aa0b8;
  padding-left: 12rpx;
}

/* 按钮行 */
.btn-row {
  margin-top: 12rpx;
}
.meta-inline {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: flex-end;
}

/* 搜索结果下拉 */
.search-panel {
  margin-top: 12rpx;
  background: rgba(10, 16, 28, 0.96);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 12rpx;
  overflow: hidden;
}
.search-scroll {
  max-height: 420rpx;
}
.search-item {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.12);
}
.si-name {
  display: block;
  font-size: 28rpx;
  color: #e6edf5;
}
.si-sub {
  display: block;
  font-size: 22rpx;
  color: #7f93a8;
  margin-top: 4rpx;
}

.btn-mini {
  font-size: 24rpx;
  color: #b9c8d8;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 10rpx;
}
.btn-on {
  color: #9fd0ef;
  border-color: rgba(123, 180, 204, 0.6);
}
.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 12rpx;
}
.meta-item {
  font-size: 22rpx;
  color: #7f93a8;
}
.meta-load {
  font-size: 24rpx;
  color: #7bb4cc;
}
.meta-warn {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c2a25e;
}

/* 3D 地球：绝对铺满整页，尺寸恒定，不受控制条/信息卡布局变化影响（避免非等比拉伸变形） */
.globe-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}
.globe-canvas {
  width: 100%;
  height: 100%;
}
.globe-hint {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(150, 180, 210, 0.5);
}

/* 信息卡：浮层固定底部，不挤压地球画布 */
.sat-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(12, 19, 34, 0.94);
  border-top: 1rpx solid rgba(110, 145, 180, 0.2);
  border-radius: 18rpx 18rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.35);
  padding: 20rpx 24rpx 28rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.card-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6edf5;
}
.card-slot {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffd27a;
  flex: 0 0 auto;
}
.card-close {
  font-size: 30rpx;
  color: #8aa0b8;
  padding: 0 10rpx;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 14rpx;
}
.kv {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}
.kv-wide {
  grid-column: span 2;
}
.kv .k {
  font-size: 20rpx;
  color: #7f93a8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.kv .v {
  font-size: 26rpx;
  color: #dfe6ee;
  white-space: nowrap;
}
.card-legend {
  display: flex;
  gap: 26rpx;
  margin-top: 14rpx;
}
.card-legend .lg {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9aacbe;
}
.lg-dot {
  display: inline-block;
  width: 18rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}
.dot-orbit { background: #6f9fc8; }
.dot-track { background: #c2a25e; }
.dot-foot { background: #7bb4cc; }
