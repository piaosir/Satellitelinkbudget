.page {
  position: relative;
  height: 100vh;
  background: #0a0e1a;
  color: #d6dee8;
  overflow: hidden;
}

/* 顶部控制条（浮于地球之上，半透明） */
.ctrl-zone {
  position: relative;
  z-index: 5;
  padding: 16rpx 24rpx 12rpx;
  background: rgba(12, 19, 34, 0.82);
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.18);
}
.ctrl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ctrl-label {
  font-size: 26rpx;
  color: #8aa0b8;
}
.grp-picker {
  flex: 0 0 auto;
}
.grp-value {
  font-size: 30rpx;
  color: #e6edf5;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.14);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
}
.grp-caret {
  color: #7bb4cc;
  font-size: 22rpx;
}
/* 搜索框 */
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
  padding: 0 16rpx;
  height: 60rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #e6edf5;
  height: 60rpx;
  line-height: 60rpx;
}
.search-input::placeholder {
  color: #66788c;
}
.search-clear {
  font-size: 26rpx;
  color: #8aa0b8;
  padding-left: 12rpx;
}

/* 时间轴行：旋转/实时开关 + 拖动轨道 + 时刻读数 */
.tl-row {
  margin-top: 12rpx;
  gap: 12rpx;
}
.tl-row .btn-mini {
  flex: 0 0 auto;
}
/* 自定义进度条：细轨 + 渐变填充 + 小巧圆点（与星间链路一致） */
.tb-track {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 56rpx;            /* 透明大触区，整条轨道可点可拖 */
  margin: 0 22rpx;          /* 留出圆点半径+光晕的余量，端点处不压住时间读数 */
  display: flex;
  align-items: center;
}
.tb-bar {
  position: relative;
  width: 100%;
  height: 8rpx;
  background: rgba(90, 130, 165, 0.18);
  border-radius: 8rpx;
  overflow: hidden;
}
.tb-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, #3f7f96, #7fd4ec);
  border-radius: 6rpx;
}
.tb-knob {
  position: absolute;
  top: 50%;
  width: 26rpx;
  height: 26rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #eaf6fb;
  border: 2rpx solid #cfe9f3;
  transition: width .08s, height .08s;
  animation: tbPulse 2.2s ease-in-out infinite;
}
/* 按住轨道时放大圆点，给出抓取反馈，落点更直观 */
.tb-track:active .tb-knob {
  width: 38rpx;
  height: 38rpx;
}
/* 呼吸光晕：内圈实色点 + 外圈柔光，缓慢起伏，既显眼又不喧宾夺主（与星间链路一致） */
@keyframes tbPulse {
  0%, 100% { box-shadow: 0 0 0 3rpx rgba(127,212,236,0.22), 0 0 10rpx 2rpx rgba(127,212,236,0.45); }
  50%      { box-shadow: 0 0 0 5rpx rgba(127,212,236,0.32), 0 0 18rpx 4rpx rgba(127,212,236,0.7); }
}
.tb-time {
  font-size: 20rpx;
  color: #8ab4cc;
  flex-shrink: 0;
  text-align: right;
  min-width: 96rpx;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
/* 精调步进：等宽铺满，加大点按目标 */
.tb-steps {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}
.tb-step, .tb-now {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 10rpx 0;
  color: #b9c8d8;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 6rpx;
}
.tb-step:active, .tb-now:active {
  background: rgba(90, 130, 165, 0.24);
}
.tb-now {
  color: #cfe0ee;
  border-color: rgba(123, 180, 204, 0.5);
}
.tb-dis {
  opacity: 0.34;
}

/* 搜索结果下拉 */
.search-panel {
  margin-top: 12rpx;
  background: rgba(10, 16, 28, 0.96);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 12rpx;
  overflow: hidden;
}
.search-scroll {
  max-height: 420rpx;
}
.search-item {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(110, 145, 180, 0.12);
}
.si-name {
  display: block;
  font-size: 28rpx;
  color: #e6edf5;
}
.si-sub {
  display: block;
  font-size: 22rpx;
  color: #7f93a8;
  margin-top: 4rpx;
}

.btn-mini {
  font-size: 24rpx;
  color: #b9c8d8;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.25);
  border-radius: 10rpx;
}
.btn-on {
  color: #9fd0ef;
  border-color: rgba(123, 180, 204, 0.6);
}

/* 3D 地球：绝对铺满整页，尺寸恒定，不受控制条/信息卡布局变化影响（避免非等比拉伸变形） */
.globe-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}
.globe-canvas {
  width: 100%;
  height: 100%;
}
.globe-hint {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(150, 180, 210, 0.5);
}
/* 数据元信息浮层：地球底部左侧，位于提示行之上（选中星时被信息卡覆盖，符合上下文） */
.globe-meta {
  position: absolute;
  left: 24rpx;
  bottom: 52rpx;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx 18rpx;
  max-width: 72%;
}
.gm-item {
  font-size: 22rpx;
  color: rgba(150, 180, 210, 0.72);
}
.gm-load {
  font-size: 22rpx;
  color: #7bb4cc;
}
.gm-warn {
  font-size: 22rpx;
  color: #c2a25e;
}

/* 信息卡：浮层固定底部，不挤压地球画布 */
.sat-card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(12, 19, 34, 0.94);
  border-top: 1rpx solid rgba(110, 145, 180, 0.2);
  border-radius: 18rpx 18rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.35);
  padding: 20rpx 24rpx 28rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.card-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6edf5;
}
.card-slot {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffd27a;
  flex: 0 0 auto;
}
.card-close {
  font-size: 30rpx;
  color: #8aa0b8;
  padding: 0 10rpx;
}
/* 信息卡「AR 对星」入口：与 .btn-on 同一套描边样式 */
.card-ar {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: #9fd0ef;
  border: 1rpx solid rgba(123, 180, 204, 0.6);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 14rpx;
}
.kv {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}
.kv-wide {
  grid-column: span 2;
}
.kv .k {
  font-size: 20rpx;
  color: #7f93a8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.kv .v {
  font-size: 26rpx;
  color: #dfe6ee;
  white-space: nowrap;
}
/* 顶部波束角设置条（选中卫星后出现）：与搜索框/按钮同一视觉体系 */
.beam-bar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.beam-bar-l {
  font-size: 26rpx;
  color: #8aa0b8;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.beam-bar-in {
  width: 160rpx;
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  background: rgba(90, 130, 165, 0.12);
  border: 1rpx solid rgba(110, 145, 180, 0.3);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #e6edf5;
}
.beam-bar-in::placeholder {
  color: #66788c;
}
.beam-bar-u {
  font-size: 24rpx;
  color: #8aa0b8;
  flex-shrink: 0;
  margin-left: 10rpx;
}
/* 锁定按钮：纯 SVG 锁图标，无边框无底框，图标即按钮 */
.beam-lock {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 40rpx;
  height: 40rpx;
}
/* 未选星时的占位提示，使常显的控制行左侧不空 */
.beam-bar-hint {
  font-size: 24rpx;
  color: #66788c;
}
/* 旋转/实时开关：靠右常显（选星时填补锁按钮后的空白） */
.beam-bar-toggles {
  margin-left: auto;
  display: flex;
  gap: 12rpx;
}
.card-legend {
  display: flex;
  gap: 26rpx;
  margin-top: 14rpx;
}
.card-legend .lg {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9aacbe;
}
.lg-dot {
  display: inline-block;
  width: 18rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}
.dot-orbit { background: #6f9fc8; }
.dot-track { background: #c2a25e; }
.dot-foot { background: #7bb4cc; }

/* ===== 仿真平台星座：导入按钮 + 导入面板 =====
   分格密钥输入与「卫星覆盖 / 频率计划」两处同构，只是配色跟着本页的深色底走。 */
.imp-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #9fd0ef;
  padding: 10rpx 18rpx;
  background: rgba(90, 130, 165, 0.14);
  border: 1rpx solid rgba(123, 180, 204, 0.42);
  border-radius: 10rpx;
  white-space: nowrap;
}
.imp-n {
  font-size: 20rpx;
  line-height: 1;
  color: #0a0e1a;
  background: #7bb4cc;
  border-radius: 20rpx;
  padding: 3rpx 10rpx;
}

.kmask { position: fixed; inset: 0; background: rgba(0, 0, 0, .45); z-index: 1000; }
/* 竖向 flex + 封顶高度：导入多份之后清单会长，不封顶就把密钥框顶出屏幕 */
.kpop {
  position: fixed; top: 18%; left: 24rpx; right: 24rpx; z-index: 1001;
  max-height: 68%; display: flex; flex-direction: column;
  background: #101a2b; border: 1rpx solid rgba(110, 145, 180, .3); border-radius: 12rpx; overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .5);
}
.kpop-hd { flex: none; display: flex; align-items: center; padding: 22rpx 26rpx; border-bottom: 1rpx solid rgba(110, 145, 180, .18); }
.kpop-t { flex: 1; font-size: 30rpx; font-weight: 600; color: #e6edf5; }
.kpop-x { font-size: 32rpx; color: #7d90a6; padding: 0 8rpx; }

/* 已导入星座清单：点行切过去，行上「改名 / 移除」直接可点（长按也出同样两项） */
.imp-list { flex: 1 1 auto; min-height: 0; max-height: 420rpx; }
.imp-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 20rpx 18rpx 26rpx;
  border-bottom: 1rpx solid rgba(110, 145, 180, .12);
}
.imp-main { flex: 1; min-width: 0; }
.imp-nm { display: block; font-size: 28rpx; color: #e6edf5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.imp-sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: #7d90a6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 触区给足（≥64rpx 高），字号压小一档，不与星座名抢眼 */
.imp-act {
  flex: 0 0 auto; padding: 12rpx 18rpx; font-size: 24rpx; line-height: 1;
  color: #9fd0ef; background: rgba(90, 130, 165, .16);
  border: 1rpx solid rgba(123, 180, 204, .3); border-radius: 8rpx;
}
.imp-act.del { color: #e8a0a0; border-color: rgba(200, 120, 120, .35); background: rgba(160, 80, 80, .14); }
.imp-empty { padding: 26rpx; font-size: 24rpx; color: #7d90a6; border-bottom: 1rpx solid rgba(110, 145, 180, .12); }

.kpop-bd { flex: none; padding: 26rpx; }
.otp-field { position: relative; display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; }
.otp-cell {
  position: relative; flex: 1 1 0; min-width: 0; height: 84rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(110, 145, 180, .3); border-radius: 12rpx; background: rgba(90, 130, 165, .1);
}
.otp-cell.is-filled { background: rgba(90, 130, 165, .18); border-color: rgba(123, 180, 204, .5); }
.otp-cell.is-active { border-color: #7bb4cc; background: rgba(123, 180, 204, .16); }
.otp-cell-char { font-size: 38rpx; font-weight: 600; line-height: 1; color: #e6edf5; font-family: 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace; }
.otp-dash { flex: 0 0 auto; padding: 0 4rpx; font-size: 38rpx; font-weight: 600; color: #5c6f85; }
.otp-caret { width: 4rpx; height: 42rpx; background: #7bb4cc; border-radius: 2rpx; animation: otpBlink 1.06s steps(1) infinite; }
@keyframes otpBlink { 0%, 49.99% { opacity: 1; } 50%, 100% { opacity: 0; } }
/* 隐形真实 input：移出可视区而不是盖在分格上（真机 <input> 是原生层控件，文字与系统光标压不住） */
.otp-input { position: absolute; left: -9999rpx; top: 0; width: 200rpx; height: 84rpx; opacity: 0; }
.otp-hint { font-size: 22rpx; color: #7d90a6; margin-bottom: 22rpx; }
.kpop-acts { display: flex; gap: 16rpx; }
.kbtn { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; border-radius: 10rpx; background: rgba(90, 130, 165, .16); color: #c3d2e0; }
.kbtn.confirm { background: #2f7fa8; color: #f2f8fc; }
.kbtn.disabled { opacity: .5; }
