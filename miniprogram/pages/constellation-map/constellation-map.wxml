<view class="page">
  <!-- 顶部控制条 -->
  <view class="ctrl-zone">
    <view class="ctrl-row">
      <picker class="grp-picker" mode="selector" range="{{groups}}" range-key="label"
              value="{{groupIndex}}" bindchange="onGroupChange">
        <view class="grp-value">{{groups[groupIndex].label}} <text class="grp-caret">▾</text></view>
      </picker>
      <view class="search-box">
        <input class="search-input" value="{{keyword}}" placeholder="搜索卫星名 / 编号"
               confirm-type="search" bindinput="onSearchInput" />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
      </view>
      <!-- 仿真平台送来的星座：绑定后自动同步，或在这里输密钥 -->
      <view class="imp-btn" bindtap="onImportTap">
        导入<text wx:if="{{impSets.length}}" class="imp-n">{{impSets.length}}</text>
      </view>
    </view>
    <!-- 时间轴行：拖动轨道 + 时刻读数（未来 0~24h，与星间链路一致） -->
    <view class="ctrl-row tl-row">
      <view class="tb-track" bindtouchstart="onTrackTouch" catchtouchmove="onTrackTouch" bindtouchend="onTrackEnd">
        <view class="tb-bar"><view class="tb-fill" style="width:{{timePct}}%"></view></view>
        <view class="tb-knob" style="left:{{timePct}}%"></view>
      </view>
      <text class="tb-time">{{liveRefresh ? '实时' : timeLabel}}</text>
    </view>
    <!-- 精调步进 -->
    <view class="tb-steps">
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="-60" bindtap="stepTime">−1h</text>
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="-10" bindtap="stepTime">−10m</text>
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="-1" bindtap="stepTime">−1m</text>
      <text class="tb-now {{(!liveRefresh && timeOffset > 0) ? '' : 'tb-dis'}}" bindtap="resetTime">此刻</text>
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="1" bindtap="stepTime">+1m</text>
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="10" bindtap="stepTime">+10m</text>
      <text class="tb-step {{liveRefresh ? 'tb-dis' : ''}}" data-d="60" bindtap="stepTime">+1h</text>
    </view>

    <!-- 控制行：常显不收回。右侧旋转/实时开关常在；左侧波束角设置仅选中卫星后出现，
         框内常显该星 ε=0 上限(最大覆盖)，可手填更小值。adjust-position=false：键盘弹出不顶动地球/动画 -->
    <view class="beam-bar">
      <block wx:if="{{selected}}">
        <text class="beam-bar-l">波束角</text>
        <input class="beam-bar-in" type="digit" value="{{beam}}" placeholder="{{beamAuto || '自动'}}"
               adjust-position="{{false}}" hold-keyboard="{{true}}" confirm-type="done" bindinput="onBeamInput" />
        <text class="beam-bar-u">°</text>
        <image class="beam-lock" src="{{beamLock ? lockIcon : unlockIcon}}" mode="aspectFit" bindtap="toggleBeamLock" />
      </block>
      <text wx:else class="beam-bar-hint">轻触卫星设置波束角</text>
      <view class="beam-bar-toggles">
        <view class="btn-mini {{autoRotate ? 'btn-on' : ''}}" bindtap="toggleRotate">{{autoRotate ? '旋转中' : '旋转停'}}</view>
        <view class="btn-mini {{liveRefresh ? 'btn-on' : ''}}" bindtap="toggleRefresh">{{liveRefresh ? '实时开' : '实时关'}}</view>
      </view>
    </view>

    <!-- 搜索结果下拉 -->
    <view wx:if="{{searchResults.length}}" class="search-panel">
      <scroll-view scroll-y class="search-scroll">
        <view wx:for="{{searchResults}}" wx:key="noradId" class="search-item"
              data-norad="{{item.noradId}}" data-group="{{item.group}}" bindtap="onPickResult">
          <text class="si-name">{{item.name}}</text>
          <text class="si-sub">{{item.groupLabel}} · NORAD {{item.noradId}}<text wx:if="{{item.slot}}"> · {{item.slot}}</text></text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 3D 地球 -->
  <view class="globe-wrap">
    <!-- hidden：canvas 是原生组件，z-index 压不住它（同层渲染在这条路上不成立），
         导入弹窗一开就被地球盖掉。弹窗期间把画布整个摘掉，关闭时由 _restartLoop 重新起帧循环。 -->
    <canvas type="2d" id="globeCanvas" class="globe-canvas" hidden="{{showImp}}"
      bindtouchstart="onTouchStart" catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"
      catchwheel="onWheel"></canvas>
    <!-- 数据元信息：移到地球底部浮层，顶部腾给时间轴（选中星时被信息卡覆盖，符合上下文） -->
    <view class="globe-meta">
      <text wx:if="{{loading}}" class="gm-load">{{statusText}}</text>
      <block wx:else>
        <text class="gm-item">在轨 {{satCount}}</text>
        <text class="gm-item">OMM {{dataTime}}</text>
        <text wx:if="{{statusText}}" class="gm-warn">{{statusText}}</text>
      </block>
    </view>
    <view class="globe-hint">轻触星点查看 · 拖动旋转 · 双指缩放</view>
  </view>

  <!-- 选中卫星信息卡 -->
  <view class="sat-card {{selected ? 'show' : ''}}" wx:if="{{selected}}">
    <view class="card-head">
      <view class="card-title-wrap">
        <text class="card-name">{{selected.name}}</text>
        <text wx:if="{{selected.slot}}" class="card-slot">{{selected.slot}}</text>
      </view>
      <text class="card-close" bindtap="closeCard">✕</text>
    </view>
    <view class="card-grid">
      <view class="kv"><text class="k">NORAD</text><text class="v">{{selected.noradId}}</text></view>
      <view class="kv"><text class="k">高度</text><text class="v">{{selected.alt}} km</text></view>
      <view class="kv"><text class="k">倾角</text><text class="v">{{selected.incl}}°</text></view>
      <view class="kv"><text class="k">偏心率</text><text class="v">{{selected.ecc}}</text></view>
      <view class="kv"><text class="k">惯性绝对速度</text><text class="v">{{selected.speedAbs}} km/s</text></view>
      <view class="kv"><text class="k">对地相对速度</text><text class="v">{{selected.speedRel}} km/s</text></view>
      <view class="kv"><text class="k">轨道周期</text><text class="v">{{selected.period}} min</text></view>
      <view class="kv"><text class="k">近/远地点</text><text class="v">{{selected.perigee}}/{{selected.apogee}} km</text></view>
      <view class="kv"><text class="k">升交点赤经 Ω</text><text class="v">{{selected.raan}}°</text></view>
      <view class="kv"><text class="k">近地点幅角 ω</text><text class="v">{{selected.argp}}°</text></view>
      <view class="kv kv-wide"><text class="k">星下点</text><text class="v">{{selected.lat}}, {{selected.lon}}</text></view>
    </view>
    <view class="card-legend">
      <text class="lg"><text class="lg-dot dot-orbit"></text>轨道</text>
      <text class="lg"><text class="lg-dot dot-track"></text>星下点轨迹</text>
      <text class="lg"><text class="lg-dot dot-foot"></text>覆盖足迹</text>
    </view>
  </view>

  <!-- 导入面板：已导入星座清单（点击切换 · 长按重命名/删除）+ 8 位密钥输入。
       分格输入与「卫星覆盖 / 频率计划」两处同款；真实 <input> 移出可视区，字符与光标全靠自绘。 -->
  <view class="kmask" wx:if="{{showImp}}" bindtap="hideImp"></view>
  <view class="kpop" wx:if="{{showImp}}">
    <view class="kpop-hd">
      <text class="kpop-t">仿真平台星座</text>
      <text class="kpop-x" bindtap="hideImp">✕</text>
    </view>
    <scroll-view class="imp-list" scroll-y wx:if="{{impSets.length}}">
      <view wx:for="{{impSets}}" wx:key="id" class="imp-row" data-id="{{item.id}}"
            bindtap="onImpTap" bindlongpress="onImpLongPress">
        <view class="imp-main">
          <text class="imp-nm">{{item.name}}</text>
          <text class="imp-sub">{{item.count}} 颗<text wx:if="{{item.src}}"> · {{item.src}}</text><text wx:if="{{item.from}}"> · {{item.from}}</text></text>
        </view>
        <view class="imp-act" data-id="{{item.id}}" catchtap="onImpRename">改名</view>
        <view class="imp-act del" data-id="{{item.id}}" catchtap="onImpDelete">移除</view>
      </view>
    </scroll-view>
    <view wx:else class="imp-empty">还没有导入的星座。</view>
    <view class="kpop-bd">
      <view class="otp-field" bindtap="focusOtp">
        <block wx:for="{{otpCells}}" wx:key="id">
          <view wx:if="{{item.sep}}" class="otp-dash">-</view>
          <view wx:else class="otp-cell {{item.filled ? 'is-filled' : ''}} {{item.active && keyFocus ? 'is-active' : ''}}">
            <text wx:if="{{item.char}}" class="otp-cell-char">{{item.char}}</text>
            <view wx:if="{{item.active && keyFocus && !item.char}}" class="otp-caret"></view>
          </view>
        </block>
        <input class="otp-input" type="text" maxlength="11" value="{{keyInput}}"
               focus="{{keyFocus}}" cursor="{{keyInput.length}}" confirm-type="done" hold-keyboard="{{true}}"
               adjust-position="{{false}}"
               bindinput="onKeyInput" bindfocus="onOtpFocus" bindblur="onOtpBlur"
               bindconfirm="confirmKeyImport" />
      </view>
      <view class="otp-hint">8 位字母 / 数字，如 ABCD-2345</view>
      <view class="kpop-acts">
        <view class="kbtn" bindtap="hideImp">取消</view>
        <view class="kbtn confirm {{importing ? 'disabled' : ''}}" bindtap="confirmKeyImport">{{importing ? '导入中…' : '导入'}}</view>
      </view>
    </view>
  </view>
</view>
