/* pages/results-detail/results-detail.wxss */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f5f9;
}

/* ====== 搜索栏 ====== */
.search-bar {
  padding: 16rpx 20rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 64rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
  height: 64rpx;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

.search-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 8rpx 0;
}

.action-btn {
  font-size: 24rpx;
  color: #3b82f6;
  padding: 4rpx 12rpx;
}

.action-btn:active {
  opacity: 0.6;
}

.action-divider {
  font-size: 22rpx;
  color: #cbd5e1;
  margin: 0 4rpx;
}

/* ====== 快速定位 ====== */
.anchor-bar {
  background: #fff;
  white-space: nowrap;
  padding: 0 12rpx;
  height: 68rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
}

.anchor-item {
  display: inline-block;
  font-size: 24rpx;
  color: #64748b;
  padding: 10rpx 20rpx;
  margin: 0 4rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  flex-shrink: 0;
}

.anchor-item.active {
  background: #1e293b;
  color: #fff;
}

.anchor-item:active {
  opacity: 0.7;
}

/* ====== 内容区 ====== */
.scroll-anchor {
  height: 0;
  width: 0;
  overflow: hidden;
}

.results-scroll {
  padding: 12rpx 16rpx;
}

/* ====== 分组卡片 ====== */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
}

.section-header:active {
  background: #f8fafc;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dot-blue { background: #3b82f6; }
.dot-green { background: #22c55e; }
.dot-orange { background: #f97316; }
.dot-purple { background: #8b5cf6; }
.dot-cyan { background: #06b6d4; }
.dot-amber { background: #f59e0b; }
.dot-red { background: #ef4444; }
.dot-indigo { background: #6366f1; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.section-count {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 12rpx;
}

.section-arrow {
  font-size: 36rpx;
  color: #94a3b8;
  transform: rotate(90deg);
  transition: transform 0.25s ease;
  line-height: 1;
}

.section-arrow.expanded {
  transform: rotate(270deg);
}

/* ====== 折叠内容 ====== */
.section-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.section-body.show {
  max-height: 8000rpx;
}

/* ====== 详细结果网格 ====== */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rpx;
  padding: 0 4rpx 12rpx;
  background: #f8fafc;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 4rpx;
  position: relative;
}

.detail-item:active {
  background: #f1f5f9;
}

.detail-item.marked {
  background: #eff6ff;
}

.detail-item.marked::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: #3b82f6;
  border-radius: 0 2rpx 2rpx 0;
}

.detail-label {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.detail-value {
  font-size: 24rpx;
  color: #0f172a;
  font-weight: 600;
  font-family: "SF Mono", Menlo, Monaco, Consolas, monospace;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}
