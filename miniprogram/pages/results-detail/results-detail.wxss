/* pages/results-detail/results-detail.wxss */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f5f9;
}

/* ====== 顶部轨道类型标识 Banner ====== */
.orbit-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.25);
}

.orbit-banner-geo {
  background: linear-gradient(90deg, #1d4ed8 0%, #3b82f6 100%);
}

.orbit-banner-ngso {
  background: linear-gradient(90deg, #047857 0%, #10b981 100%);
}

.orbit-banner-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.orbit-banner-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.18);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.orbit-banner-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.orbit-banner-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 16rpx;
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 卫星分组标题中的轨道类型小徽章 ====== */
.orbit-chip {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  line-height: 1.6;
}

.orbit-chip-geo {
  color: #1d4ed8;
  background: #dbeafe;
}

.orbit-chip-ngso {
  color: #047857;
  background: #d1fae5;
}

/* ====== 搜索栏 ====== */
.search-bar {
  padding: 16rpx 20rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 64rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
  height: 64rpx;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

.search-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 8rpx 0;
}

.action-btn {
  font-size: 24rpx;
  color: #3b82f6;
  padding: 4rpx 12rpx;
}

.action-btn:active {
  opacity: 0.6;
}

.action-divider {
  font-size: 22rpx;
  color: #cbd5e1;
  margin: 0 4rpx;
}

/* ====== 快速定位 ====== */
.anchor-bar {
  background: #fff;
  white-space: nowrap;
  padding: 0 12rpx;
  height: 68rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
}

.anchor-item {
  display: inline-block;
  font-size: 24rpx;
  color: #64748b;
  padding: 10rpx 20rpx;
  margin: 0 4rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  flex-shrink: 0;
}

.anchor-item.active {
  background: #1e293b;
  color: #fff;
}

.anchor-item:active {
  opacity: 0.7;
}

/* ====== 内容区 ====== */
.scroll-anchor {
  height: 0;
  width: 0;
  overflow: hidden;
}

.results-scroll {
  padding: 12rpx 16rpx;
}

/* ====== 分组卡片 ====== */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
}

.section-header:active {
  background: #f8fafc;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dot-blue { background: #3b82f6; }
.dot-green { background: #22c55e; }
.dot-orange { background: #f97316; }
.dot-purple { background: #8b5cf6; }
.dot-cyan { background: #06b6d4; }
.dot-amber { background: #f59e0b; }
.dot-red { background: #ef4444; }
.dot-indigo { background: #6366f1; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.section-count {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 12rpx;
}

.section-arrow {
  font-size: 36rpx;
  color: #94a3b8;
  transform: rotate(90deg);
  transition: transform 0.25s ease;
  line-height: 1;
}

.section-arrow.expanded {
  transform: rotate(270deg);
}

/* ====== 折叠内容 ====== */
.section-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.section-body.show {
  max-height: 8000rpx;
}

/* ====== 详细结果网格 ====== */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rpx;
  padding: 0 4rpx 12rpx;
  background: #f8fafc;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 4rpx;
  position: relative;
}

.detail-item:active {
  background: #f1f5f9;
}

.detail-item.marked {
  background: #eff6ff;
}

.detail-item.marked::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: #3b82f6;
  border-radius: 0 2rpx 2rpx 0;
}

.detail-label {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.detail-value {
  font-size: 24rpx;
  color: #0f172a;
  font-weight: 600;
  font-family: "SF Mono", Menlo, Monaco, Consolas, monospace;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.detail-value-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.detail-el-warn {
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.detail-el-warn.detail-el-warn-warning {
  color: #d97706;
}

.detail-el-warn.detail-el-warn-error {
  color: #dc2626;
}

/* ====== 视图切换 ====== */
.view-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.view-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f1f5f9;
  transition: all 0.2s ease;
}

.view-tab.active {
  color: #fff;
  background: #1e293b;
  font-weight: 600;
}

.view-tab:active {
  opacity: 0.8;
}

/* ====== 链路瀑布（三线表 / 黑白） ====== */
.wf-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 20rpx 0;
  box-sizing: border-box;
  background: #ffffff;
}

.wf-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 0 18rpx;
}

.wf-doc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 1rpx;
}

/* 导出按钮：黑白描边，呼应三线表风格 */
.wf-export-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 22rpx;
  border: 2rpx solid #000000;
  border-radius: 6rpx;
  background: #ffffff;
}

.wf-export-btn:active {
  background: #000000;
}

.wf-export-btn:active .wf-export-icon,
.wf-export-btn:active .wf-export-text {
  color: #ffffff;
}

.wf-export-btn.disabled {
  opacity: 0.45;
}

.wf-export-icon {
  font-size: 22rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1;
}

.wf-export-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 1rpx;
}

/* 工具栏右侧操作区：语言切换 + 导出 */
.wf-toolbar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 中英文切换按钮：黑底白字，与导出按钮区分主次 */
.wf-lang-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #000000;
  border-radius: 6rpx;
  background: #000000;
}

.wf-lang-btn:active {
  background: #ffffff;
}

.wf-lang-btn:active .wf-lang-icon,
.wf-lang-btn:active .wf-lang-text {
  color: #000000;
}

.wf-lang-icon {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.wf-lang-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 三线表：每段一张表 */
.wf-table {
  margin-bottom: 36rpx;
}

/* 表题（置于顶线之上，居中黑体） */
.wf-cap {
  font-size: 23rpx;
  font-weight: 700;
  color: #000000;
  text-align: center;
  letter-spacing: 0.5rpx;
  padding-bottom: 8rpx;
}

/* 表头：顶线（粗）+ 表头细线 */
.wf-head {
  display: flex;
  align-items: center;
  padding: 8rpx 6rpx;
  border-top: 3rpx solid #000000;
  border-bottom: 1rpx solid #000000;
}

.wf-head text {
  font-size: 19rpx;
  font-weight: 600;
  color: #000000;
  letter-spacing: 0.5rpx;
}

/* 表体：底线（粗），数据行无横线 */
.wf-body {
  border-bottom: 3rpx solid #000000;
}

.wf-row {
  display: flex;
  align-items: center;
  padding: 7rpx 6rpx;
}

/* 列宽：表头与数据行共用 */
.wf-h-label, .wf-label {
  flex: 1;
  padding-right: 10rpx;
  font-size: 21rpx;
  color: #1a1a1a;
  word-break: break-all;
}

.wf-sign {
  display: inline-block;
  width: 20rpx;
  font-weight: 700;
  color: #333333;
  font-family: "SF Mono", Menlo, Monaco, Consolas, monospace;
}

.wf-h-val, .wf-val {
  width: 148rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 21rpx;
  color: #000000;
  font-family: "SF Mono", Menlo, Monaco, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.wf-h-unit, .wf-unit {
  width: 90rpx;
  flex-shrink: 0;
  padding-left: 12rpx;
  font-size: 19rpx;
  color: #555555;
  font-family: "SF Mono", Menlo, Monaco, Consolas, monospace;
}

/* 双列（上行/下行）列宽 */
.wf-cols-2 .wf-h-val, .wf-cols-2 .wf-val { width: 124rpx; }
.wf-cols-2 .wf-h-unit, .wf-cols-2 .wf-unit { width: 82rpx; }

/* 三列（上行/下行/合计）列宽 + 更紧凑字号 */
.wf-cols-3 .wf-h-label, .wf-cols-3 .wf-label { font-size: 20rpx; }
.wf-cols-3 .wf-h-val, .wf-cols-3 .wf-val {
  width: 104rpx;
  font-size: 20rpx;
  padding-left: 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.wf-cols-3 .wf-h-unit, .wf-cols-3 .wf-unit { width: 60rpx; padding-left: 8rpx; }

/* 合计列：加粗强调 */
.wf-val-total { font-weight: 700; color: #000000; }

/* 行类型：仅用字重 / 细分隔线区分，无配色 */
.wf-r-ref .wf-sign { color: #999999; }

.wf-r-base .wf-label { font-weight: 700; color: #000000; }
.wf-r-base .wf-val { font-weight: 700; }

/* 小计 / 检查点：上方细分隔线 + 加粗 */
.wf-r-sub {
  border-top: 1rpx solid #999999;
}
.wf-r-sub .wf-label { font-weight: 700; color: #000000; }
.wf-r-sub .wf-val { font-weight: 700; color: #000000; }

/* 次级检查点（C/T、C/N₀、热噪声 C/N）：仅加粗，无分隔线，减少级联表横线 */
.wf-r-chk .wf-label { font-weight: 700; color: #000000; }
.wf-r-chk .wf-val { font-weight: 700; color: #000000; }

/* KPI（C/N、C/N₀、C/T 等）：加粗强调 */
.wf-r-kpi .wf-label { font-weight: 700; color: #000000; }
.wf-r-kpi .wf-val { font-weight: 700; color: #000000; }

/* 链路余量：上方细分隔线，加粗放大（不染色） */
.wf-r-margin {
  border-top: 1rpx solid #999999;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}
.wf-r-margin .wf-label { font-weight: 700; font-size: 22rpx; color: #000000; }
.wf-r-margin .wf-val { font-size: 25rpx; font-weight: 700; color: #000000; }

.wf-foot {
  padding: 4rpx 0 20rpx;
  font-size: 19rpx;
  color: #888888;
  line-height: 1.5;
}
