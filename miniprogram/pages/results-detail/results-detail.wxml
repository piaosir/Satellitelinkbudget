  <view class="orbit-banner orbit-banner-{{orbitType === 'NGSO' ? 'ngso' : 'geo'}}">
    <view class="orbit-banner-left">
      <text class="orbit-banner-tag">轨道类型</text>
      <text class="orbit-banner-label">{{orbitTypeLabel}}</text>
    </view>
    <text class="orbit-banner-desc">{{orbitTypeDesc}}</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <image class="search-icon" src="/images/icons/search.svg" mode="aspectFit"></image>
      <input class="search-input" 
             placeholder="搜索参数名称或结果值..." 
             value="{{searchKeyword}}" 
             bindinput="onSearchInput" 
             confirm-type="search" />
      <image class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch" src="/images/icons/search-clear.svg" mode="aspectFit"></image>
    </view>
    <view class="search-actions">
      <text class="action-btn" bindtap="expandAll">展开全部</text>
      <text class="action-divider">|</text>
      <text class="action-btn" bindtap="collapseAll">折叠全部</text>
    </view>
  </view>

  <!-- 快速定位锚点栏 -->
  <scroll-view class="anchor-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="anchor-item {{activeAnchor === item.id ? 'active' : ''}}" 
          wx:for="{{sectionAnchors}}" wx:key="id"
          bindtap="scrollToSection" data-id="{{item.id}}">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 高度定位锚点 -->
  <view class="scroll-anchor"></view>

  <!-- 结果内容 -->
