<wxs module="filter">
  function strContains(str, keyword) {
    if (str.indexOf(keyword) > -1) return true;
    var lower = str.toLowerCase();
    var kwLower = keyword.toLowerCase();
    if (lower.indexOf(kwLower) > -1) return true;
    return false;
  }
  function matchSearch(label, keyword, value) {
    if (!keyword || keyword.length === 0) return true;
    if (strContains(label, keyword)) return true;
    if (value !== undefined && value !== null) {
      var valStr = '' + value;
      if (strContains(valStr, keyword)) return true;
    }
    return false;
  }
  function includes(arr, val) {
    if (!arr || !arr.length) return false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === val) return true;
    }
    return false;
  }
  function sectionHasMatch(labels, keyword, results, keys, extraVals) {
    if (!keyword || keyword.length === 0) return true;
    for (var i = 0; i < labels.length; i++) {
      if (strContains(labels[i], keyword)) return true;
    }
    if (results && keys) {
      for (var j = 0; j < keys.length; j++) {
        var val = results[keys[j]];
        if (val !== undefined && val !== null) {
          if (strContains('' + val, keyword)) return true;
        }
      }
    }
    if (extraVals) {
      for (var k = 0; k < extraVals.length; k++) {
        if (extraVals[k] && strContains('' + extraVals[k], keyword)) return true;
      }
    }
    return false;
  }
  module.exports = { matchSearch: matchSearch, includes: includes, sectionHasMatch: sectionHasMatch };
</wxs>

