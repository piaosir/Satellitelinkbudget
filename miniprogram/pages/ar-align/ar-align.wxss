/* ar-align.wxss */
.container {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 输入阶段样式 */
.input-stage {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.input-card {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 0;
  padding: 40rpx 32rpx;
  box-shadow: none;
  border: 1px solid #d0d0d0;
}

.input-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 40rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.orbit-input-group {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #4a4a4a;
  margin-bottom: 8rpx;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.form-input {
  width: 100%;
  height: 64rpx;
  background-color: #fafafa;
  border-radius: 0;
  border: 1px solid #b0b0b0;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  box-sizing: border-box;
  font-family: 'Courier New', 'Consolas', monospace;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #2a2a2a;
  background: #ffffff;
}

.form-picker {
  width: 100%;
  height: 64rpx;
  background-color: #fafafa;
  border-radius: 0;
  border: 1px solid #b0b0b0;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'Courier New', 'Consolas', monospace;
}

.form-picker::after {
  content: '▼';
  font-size: 20rpx;
  color: #6a6a6a;
}

.orbit-display {
  background: #2a2a2a;
  border-radius: 0;
  padding: 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
  border: 2px solid #2a2a2a;
}

.orbit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 2px;
}

.btn-primary {
  width: 100%;
  height: 72rpx;
  background: #2a2a2a;
  color: #ffffff;
  border: 2px solid #2a2a2a;
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 600;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 1px;
  text-transform: uppercase;
  transition: all 0.2s;
}

.btn-start:active {
  background: #1a1a1a;
  border-color: #1a1a1a;
  transform: none;
}

/* 集成按钮样式 */
.btn-start-integrated {
  width: 100%;
  background: #ffffff;
  color: #1a1a1a;
  border: 2px solid #2a2a2a;
  border-radius: 0;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all 0.2s;
}

.btn-orbit-display {
  width: 100%;
  background: #2a2a2a;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.btn-orbit-label {
  font-size: 20rpx;
  color: #b0b0b0;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.btn-orbit-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 1.5px;
}

.btn-start-text {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-align: center;
  background: #ffffff;
  color: #1a1a1a;
  transition: all 0.2s;
}

.btn-start-integrated:active {
  transform: none;
}

.btn-start-integrated:active .btn-orbit-display {
  background: #1a1a1a;
}

.btn-start-integrated:active .btn-start-text {
  background: #f0f0f0;
}

/* AR阶段样式 */
.ar-stage {
  width: 100%;
  height: 100vh;
  position: relative;
}

.camera-view {
  width: 100%;
  height: 100%;
}

/* 提示覆盖层 */
.tip-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.tip-card {
  background-color: #ffffff;
  border-radius: 0;
  border: 2px solid #2a2a2a;
  padding: 48rpx 32rpx;
  text-align: center;
  max-width: 500rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.tip-subtext {
  font-size: 24rpx;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

/* AR覆盖层 */
.ar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 中心瞄准圈 */
.aim-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #2a2a2a;
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(42, 42, 42, 0.6);
  transition: all 0.3s ease;
  z-index: 10;
}

.aim-circle.aligned {
  border-color: #10b981;
  box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.8);
  animation: pulse 1s infinite;
}

.aim-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background-color: #2a2a2a;
  border-radius: 50%;
}

.aim-circle.aligned .aim-dot {
  background-color: #10b981;
}

@keyframes pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.1);
  }
}

/* 卫星图标 - 使用satellite.png图片，通过CSS优化稳定性 */
.satellite-icon {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  margin-left: -60rpx;
  margin-top: -60rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  filter: drop-shadow(0 0 15rpx rgba(255, 255, 255, 0.9));
  
  /* CSS层面优化渲染性能和视觉稳定性 */
  will-change: transform;
  transform: translateZ(0); /* 启用硬件加速 */
  backface-visibility: hidden; /* 隐藏背面，提升性能 */
  
  /* 轻微的平滑过渡，不影响准确性 */
  transition: left 0.05s ease-out, top 0.05s ease-out;
  
  /* 减少浮动动画幅度 */
  animation: satelliteFloat 4s ease-in-out infinite;
}

.satellite-image {
  width: 100%;
  height: 100%;
}

/* 边缘状态样式 */
.satellite-icon.at-edge {
  animation: satellitePulse 1.5s ease-in-out infinite;
}

@keyframes satellitePulse {
  0%, 100% {
    transform: translateZ(0) scale(1);
    opacity: 0.9;
  }
  50% {
    transform: translateZ(0) scale(1.15);
    opacity: 1;
  }
}

/* 边缘指示器 */
.edge-indicator {
  position: absolute;
  bottom: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.95);
  border: 2px solid #2a2a2a;
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  white-space: nowrap;
  pointer-events: none;
}

.edge-arrow {
  font-size: 24rpx;
  color: #2a2a2a;
  font-weight: bold;
  animation: arrowBlink 1s ease-in-out infinite;
}

@keyframes arrowBlink {
  0%, 100% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
}

@keyframes satelliteFloat {
  0%, 100% {
    transform: translateZ(0) translateY(0) scale(1);
  }
  50% {
    transform: translateZ(0) translateY(-5rpx) scale(1.03);
  }
}

/* 顶部信息栏 */
.info-bar {
  position: absolute;
  top: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  pointer-events: none;
  gap: 16rpx;
}

.info-section {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 0;
  border: 2px solid #2a2a2a;
  padding: 16rpx 24rpx;
}

.info-section-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
  text-align: center;
}

.info-row {
  display: flex;
  justify-content: space-around;
  gap: 24rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  font-size: 20rpx;
  color: #6a6a6a;
  margin-bottom: 6rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.3px;
}

.info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.info-divider {
  height: 2rpx;
  background-color: #e0e0e0;
  margin: 0;
}

/* 底部状态栏 */
.status-bar {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  text-align: center;
  padding: 0 40rpx;
  pointer-events: none;
}

.status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 16rpx 32rpx;
  border-radius: 0;
  border: 2px solid #2a2a2a;
  display: inline-block;
  margin-bottom: 16rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.status-text.success {
  color: #10b981;
  border-color: #10b981;
}

.distance-info {
  font-size: 22rpx;
  color: #1a1a1a;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  border-radius: 0;
  border: 1px solid #6a6a6a;
  display: inline-block;
  font-family: 'Courier New', 'Consolas', monospace;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(245, 245, 245, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #d0d0d0;
  border-top-color: #2a2a2a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

/* 卫星覆盖图按钮 */
.btn-coverage {
  width: 100%;
  height: 72rpx;
  margin-top: 24rpx;
  background: #ffffff;
  color: #2a2a2a;
  border: 1px solid #b0b0b0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Courier New', 'Consolas', monospace;
  transition: all 0.2s;
}

.btn-coverage:active {
  background: #f5f5f5;
  border-color: #2a2a2a;
}

.btn-coverage-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.btn-coverage-text {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
