/* ar-align.wxss
   选择页遵循期刊黑白体系（字体/分段切换器/填空线输入等 token 来自 app.wxss 全局），
   AR 相机覆盖层沿用原有等宽风格（cover-view 层的功能性读数）。 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #ffffff;
}

/* ===================== 选择目标阶段 ===================== */
.input-stage {
  width: 100%;
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background-color: #ffffff;
}

.sel-card {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
}

/* 抬头：标题 + GSO/NGSO 分段切换（墨块），下承 2rpx 规则线 */
.sel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #1a1a1a;
  margin-bottom: 28rpx;
}

.sel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

/* picker：与填空线输入同款，右侧灰 chevron */
.form-picker {
  width: 100%;
  height: 64rpx;
  background: transparent;
  border: none;
  border-bottom: 2rpx solid #d4d4d4;
  padding: 0 4rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-picker::after {
  content: '▾';
  color: #8c8c8c;
  font-size: 24rpx;
  margin-left: 12rpx;
}

.form-picker-sub {
  color: #8c8c8c;
  font-size: 24rpx;
  margin-left: auto;
  padding-right: 8rpx;
  font-variant-numeric: tabular-nums;
}

/* 搜索框（填空线）+ 清除 */
.sch {
  position: relative;
  display: flex;
  align-items: center;
}

.sch-in {
  flex: 1;
}

.sch-clr {
  position: absolute;
  right: 8rpx;
  color: #8c8c8c;
  font-size: 26rpx;
  padding: 8rpx;
}

/* 结果表：三线表——顶底墨线，表头下细线，行间发丝线 */
.sch-res {
  margin: 8rpx 0 20rpx;
  border-top: 1rpx solid #1a1a1a;
  border-bottom: 1rpx solid #1a1a1a;
}

.sch-res-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 4rpx;
  border-bottom: 1rpx solid #c4c4c4;
}

.sch-res-ti {
  font-size: 22rpx;
  color: #404040;
}

.sch-res-x {
  font-size: 22rpx;
  color: #8c8c8c;
  padding: 0 8rpx;
}

.sch-res-list {
  max-height: 440rpx;
}

.sch-item {
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid #ececec;
}

.sch-item:last-child {
  border-bottom: none;
}

.sch-item:active {
  background: #f5f5f5;
}

.si-name {
  display: block;
  font-size: 28rpx;
  color: #1a1a1a;
}

.si-meta {
  display: block;
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 2rpx;
}

/* 目标卡：章节式——顶 2rpx 墨线、底 1rpx 中线 */
.tgt {
  margin: 8rpx 0 28rpx;
  padding: 20rpx 4rpx 16rpx;
  border-top: 2rpx solid #1a1a1a;
  border-bottom: 1rpx solid #c4c4c4;
}

.tgt-empty {
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
  padding: 28rpx 0;
}

.tgt-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
}

.tgt-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 轨道类别：墨块；分组：墨线描边（与主页轨道标签同口径） */
.tgt-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: #1a1a1a;
  padding: 0 10rpx;
  line-height: 30rpx;
}

.tgt-grp {
  font-size: 20rpx;
  color: #1a1a1a;
  border: 1rpx solid #1a1a1a;
  padding: 0 10rpx;
  line-height: 28rpx;
}

.tgt-sub {
  font-size: 22rpx;
  color: #404040;
  margin-top: 6rpx;
}

.tgt-grid {
  display: flex;
  margin-top: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #ececec;
  border-bottom: 1rpx solid #ececec;
}

.kv {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.k {
  font-size: 20rpx;
  color: #8c8c8c;
}

.v {
  font-size: 28rpx;
  color: #1a1a1a;
  font-variant-numeric: tabular-nums;
}

/* 仅「地平线下」用警示红 */
.v-warn {
  color: #9b1c1c;
}

.tgt-line {
  font-size: 22rpx;
  color: #404040;
  margin-top: 10rpx;
}

.tgt-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tgt-src {
  font-size: 20rpx;
  color: #8c8c8c;
}

.tgt-loc {
  font-size: 20rpx;
  color: #8c8c8c;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.tgt-loc-bad {
  color: #9b1c1c;
  text-decoration: underline;
}

/* 主按钮：墨黑、4rpx 圆角 */
.btn-start {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1a1a1a;
  color: #ffffff;
  border: none;
  border-radius: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.btn-start::after {
  border: none;
}

.btn-start:active {
  background: #404040;
}

/* ===================== AR 阶段 ===================== */
.ar-stage {
  width: 100%;
  height: 100vh;
  position: relative;
}

.camera-view {
  width: 100%;
  height: 100%;
}

/* 提示覆盖层 */
.tip-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.tip-card {
  background-color: #ffffff;
  border-radius: 0;
  border: 2px solid #2a2a2a;
  padding: 48rpx 32rpx;
  text-align: center;
  max-width: 500rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.tip-subtext {
  font-size: 24rpx;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

/* AR覆盖层 */
.ar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 中心瞄准圈 */
.aim-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #2a2a2a;
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(42, 42, 42, 0.6);
  transition: all 0.3s ease;
  z-index: 10;
}

.aim-circle.aligned {
  border-color: #10b981;
  box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.8);
  animation: pulse 1s infinite;
}

.aim-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background-color: #2a2a2a;
  border-radius: 50%;
}

.aim-circle.aligned .aim-dot {
  background-color: #10b981;
}

@keyframes pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.1);
  }
}

/* 卫星图标 - 使用satellite.png图片，通过CSS优化稳定性 */
.satellite-icon {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  margin-left: -60rpx;
  margin-top: -60rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  filter: drop-shadow(0 0 15rpx rgba(255, 255, 255, 0.9));

  /* CSS层面优化渲染性能和视觉稳定性 */
  will-change: transform;
  transform: translateZ(0); /* 启用硬件加速 */
  backface-visibility: hidden; /* 隐藏背面，提升性能 */

  /* AR模式不加过渡延迟，确保图标锚定在真实世界位置 */
}

.satellite-image {
  width: 100%;
  height: 100%;
}

/* 边缘状态样式 */
.satellite-icon.at-edge {
  animation: satellitePulse 1.5s ease-in-out infinite;
}

@keyframes satellitePulse {
  0%, 100% {
    transform: translateZ(0) scale(1);
    opacity: 0.9;
  }
  50% {
    transform: translateZ(0) scale(1.15);
    opacity: 1;
  }
}

/* 边缘指示器 */
.edge-indicator {
  position: absolute;
  bottom: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.95);
  border: 2px solid #2a2a2a;
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  white-space: nowrap;
  pointer-events: none;
}

.edge-arrow {
  font-size: 24rpx;
  color: #2a2a2a;
  font-weight: bold;
  animation: arrowBlink 1s ease-in-out infinite;
}

@keyframes arrowBlink {
  0%, 100% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
}

@keyframes satelliteFloat {
  0%, 100% {
    transform: translateZ(0) translateY(0) scale(1);
  }
  50% {
    transform: translateZ(0) translateY(-5rpx) scale(1.03);
  }
}

/* 顶部信息栏 */
.info-bar {
  position: absolute;
  top: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  pointer-events: none;
  gap: 16rpx;
}

.info-section {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 0;
  border: 2px solid #2a2a2a;
  padding: 16rpx 24rpx;
}

.info-section-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
  text-align: center;
}

.info-row {
  display: flex;
  justify-content: space-around;
  gap: 24rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  font-size: 20rpx;
  color: #6a6a6a;
  margin-bottom: 6rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.3px;
}

.info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

/* 目标第三行：轨道类别 / 距离 / 可见状态或过境 */
.info-target-line {
  font-size: 20rpx;
  color: #404040;
  text-align: center;
  margin-top: 10rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.3px;
}

.info-divider {
  height: 2rpx;
  background-color: #e0e0e0;
  margin: 0;
}

/* 底部状态栏 */
.status-bar {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  text-align: center;
  padding: 0 40rpx;
  pointer-events: none;
}

.status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 16rpx 32rpx;
  border-radius: 0;
  border: 2px solid #2a2a2a;
  display: inline-block;
  margin-bottom: 16rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.5px;
}

.status-text.success {
  color: #10b981;
  border-color: #10b981;
}

.status-text.warn {
  color: #9b1c1c;
  border-color: #9b1c1c;
}

.distance-info {
  font-size: 22rpx;
  color: #1a1a1a;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  border-radius: 0;
  border: 1px solid #6a6a6a;
  display: inline-block;
  font-family: 'Courier New', 'Consolas', monospace;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #d4d4d4;
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  letter-spacing: 0.02em;
}

/* 底部工具行：换星 / 手动翻转 / 诊断（放在 .ar-overlay 之外，避免继承 pointer-events:none） */
.tool-row {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 0 40rpx;
}

.tool-btn {
  font-size: 20rpx;
  color: #1a1a1a;
  background-color: rgba(255, 255, 255, 0.9);
  border: 1px solid #6a6a6a;
  padding: 10rpx 20rpx;
  margin: 0 8rpx;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.3px;
}

.tool-btn.active {
  color: #ffffff;
  background-color: #2a2a2a;
  border-color: #2a2a2a;
}

/* 诊断面板 */
.debug-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 300rpx;
  background-color: rgba(255, 255, 255, 0.92);
  border: 1px solid #6a6a6a;
  padding: 12rpx 16rpx;
}

.debug-line {
  font-size: 18rpx;
  line-height: 28rpx;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  white-space: nowrap;
}

.debug-rec {
  margin-top: 10rpx;
  text-align: center;
}
