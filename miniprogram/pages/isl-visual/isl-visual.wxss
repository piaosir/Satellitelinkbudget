.page {
  min-height: 100vh;
  background: #0d1117;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== 操作区（置顶） ===== */
.ctrl-zone {
  padding: 10rpx 14rpx 0;
  position: relative;
  z-index: 10;       /* 让搜索结果浮层叠在地球之上 */
}
/* 点空白关闭浮层的透明遮罩：z 低于浮层(50/60)、高于操作区普通内容，全屏捕获点击 */
.pop-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}
.toggle-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.toggle-label {
  font-size: 21rpx;
  color: #8b94a3;
  margin-right: 12rpx;
}
.tg {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #6b7484;
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
  border: 1rpx solid #2a313c;
  border-radius: 5rpx;
  background: #14181f;
  opacity: 0.5;
}
.tg-on {
  color: #cfd6df;
  border-color: #3a4456;
  opacity: 1;
}
.tg-rotate {
  margin-left: auto;   /* 推到行尾，与显示开关分隔 */
  margin-right: 0;
}
.tg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 7rpx;
}
.sat-row {
  display: flex;
  gap: 12rpx;
}
.sat-col {
  flex: 1;
  min-width: 0;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
}
.card-title {
  position: relative;        /* 分组浮层的定位锚点 */
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #c5ccd6;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 8rpx;
}
.dot-sat1 { background: #6f9fc8; }
.dot-sat2 { background: #c2a25e; }
.dot-station { background: #6fb88f; }

/* ===== 选星：已选名 + 搜索框 + 结果下拉 ===== */
/* 分组 chip：点击展开分组浮层（可选浏览；默认「全部」=全局搜索） */
.grp-chip {
  margin-left: auto;
  max-width: 66%;
  font-size: 19rpx;
  color: #8ab4cc;
  padding: 3rpx 12rpx;
  border: 1rpx solid #2f3a45;
  border-radius: 20rpx;
  background: #0e1219;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grp-empty { color: #7d8694; }
/* 分组浮层：自适应换行铺满列宽 */
.grp-pop {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 6rpx;
  z-index: 60;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid #3a4654;
  border-radius: 8rpx;
  background: #131922;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.6);
}
.grp-item {
  font-size: 19rpx;
  color: #c2c9d3;
  padding: 7rpx 14rpx;
  border: 1rpx solid #2a323d;
  border-radius: 6rpx;
  background: #0e1219;
}
.grp-item:active { background: #1d2735; }
.grp-on {
  color: #cfe7f2;
  border-color: #4a6675;
  background: #16202b;
}
.grp-all {
  color: #9ec9b0;
  border-color: #3c5a48;
  background: #141c18;
}
.sch {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  position: relative;   /* 搜索结果浮层的定位锚点 */
}
.sch-in {
  flex: 1;
  min-width: 0;
  background: #0e1219;
  border: 1rpx solid #283039;
  border-radius: 4rpx;
  padding: 7rpx 9rpx;
  font-size: 21rpx;
  color: #e6e9ef;
}
.sch-clr {
  font-size: 22rpx;
  color: #6b7484;
  padding: 4rpx 8rpx;
  margin-left: 6rpx;
}
.sch-res {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 6rpx;
  z-index: 50;                 /* 稳压地球与下方控件之上 */
  max-height: 48vh;           /* 随屏高自适应，永不超出可视区，内部滚动 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;           /* 让圆角裁住表头与列表 */
  border: 1rpx solid #3a4654;
  border-radius: 8rpx;
  background: #131922;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.6);
}
/* 列表表头：常驻不滚动，提供「关闭」出口 */
.sch-res-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx;
  border-bottom: 1rpx solid #232c37;
  background: #161d27;
}
.sch-res-ti {
  font-size: 18rpx;
  color: #8a93a2;
}
.sch-res-x {
  font-size: 19rpx;
  color: #cfe0ee;
  padding: 4rpx 12rpx;
  border: 1rpx solid #3a4654;
  border-radius: 6rpx;
  background: #0e1219;
}
.sch-res-list {
  flex: 1;
  min-height: 0;
  max-height: calc(48vh - 60rpx);
}
.sch-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 64rpx;          /* 加大点按目标，单指好点 */
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #1f2630;
}
.sch-item:last-child {
  border-bottom: none;
}
.sch-item:active {
  background: #1d2735;        /* 点按高亮反馈 */
}
.si-name {
  font-size: 22rpx;
  color: #e4e9f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.si-meta {
  font-size: 18rpx;
  color: #7b8593;
  margin-top: 3rpx;
}

.cin {
  display: flex;
  align-items: center;
  padding: 3rpx 0;
}
.cslider {
  display: flex;
  align-items: center;
  padding: 2rpx 0;
}
.cl {
  font-size: 21rpx;
  color: #8b94a3;
  width: 84rpx;
  flex-shrink: 0;
}
.cl-wide { width: 150rpx; }
.cl-mid { width: 64rpx; margin-left: 14rpx; }
/* 选星卡片内的波束角行（与搜索框同宽、紧随其下） */
.bw-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.bw-l {
  font-size: 20rpx;
  color: #8b94a3;
  flex-shrink: 0;
  margin-right: 8rpx;
}
.bw-in {
  flex: 1;
  min-width: 0;
  background: #0e1219;
  border: 1rpx solid #283039;
  border-radius: 4rpx;
  padding: 5rpx 9rpx;
  font-size: 21rpx;
  color: #e6e9ef;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.bw-u {
  font-size: 20rpx;
  color: #5c6675;
  flex-shrink: 0;
  margin-left: 6rpx;
}
.cf {
  flex: 1;
  min-width: 0;
  background: #0e1219;
  border: 1rpx solid #283039;
  border-radius: 4rpx;
  padding: 6rpx 9rpx;
  font-size: 22rpx;
  color: #e6e9ef;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.cu {
  font-size: 20rpx;
  color: #5c6675;
  width: 44rpx;
  text-align: left;        /* 紧贴各自输入框：°E 靠经度、°N 靠纬度 */
  flex-shrink: 0;
  margin-left: 6rpx;
}
.cu-hemi {
  color: #8ab4cc;
  text-decoration: underline;
  padding: 6rpx 2rpx;
}
.csl {
  flex: 1;
  min-width: 0;
  margin: 0 6rpx 0 4rpx;
}

.common-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 9rpx 12rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
/* ===== 3D 地球（flex 撑满中间剩余空间，消除底部留白） ===== */
.globe-wrap {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 700rpx;
  margin-top: 10rpx;
  background: #090c11;
  border-top: 1rpx solid #1b212a;
  border-bottom: 1rpx solid #1b212a;
}

/* ===== 时间轴 ===== */
.time-bar {
  margin: 8rpx 14rpx 0;
  padding: 6rpx 14rpx 8rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
.tb-row {
  display: flex;
  align-items: center;
}
.tb-label {
  font-size: 20rpx;
  color: #8b94a3;
  flex-shrink: 0;
}
/* 自定义进度条：细轨 + 渐变填充 + 小巧发光圆点（原生 slider 圆点最小也偏大、无法发光） */
.tb-track {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 64rpx;            /* 透明大触区，整条轨道可点可拖、容错更高 */
  margin: 0 22rpx;          /* 留出圆点半径的余量，端点处不会压住左侧"时间轴"标签/右侧时间 */
  display: flex;
  align-items: center;
}
.tb-bar {
  position: relative;
  width: 100%;
  height: 8rpx;
  background: #20262f;
  border-radius: 8rpx;
  overflow: hidden;
}
.tb-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, #3f7f96, #7fd4ec);
  border-radius: 6rpx;
}
.tb-knob {
  position: absolute;
  top: 50%;
  width: 26rpx;
  height: 26rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #eaf6fb;
  border: 2rpx solid #cfe9f3;
  transition: width .08s, height .08s;
  animation: tbPulse 2.2s ease-in-out infinite;
}
/* 按住轨道时放大圆点，给出抓取反馈，落点更直观 */
.tb-track:active .tb-knob {
  width: 38rpx;
  height: 38rpx;
}
/* 呼吸光晕：内圈实色点 + 外圈柔光，缓慢起伏，既显眼又不喧宾夺主 */
@keyframes tbPulse {
  0%, 100% { box-shadow: 0 0 0 3rpx rgba(127,212,236,0.22), 0 0 10rpx 2rpx rgba(127,212,236,0.45); }
  50%      { box-shadow: 0 0 0 5rpx rgba(127,212,236,0.32), 0 0 18rpx 4rpx rgba(127,212,236,0.7); }
}
.tb-time {
  font-size: 19rpx;
  color: #8ab4cc;
  flex-shrink: 0;
  text-align: right;
  min-width: 132rpx;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
/* 精调步进：每个按钮等宽铺满，加大点按目标，便于落在想要的分钟 */
.tb-steps {
  display: flex;
  gap: 6rpx;
  margin-top: 8rpx;
}
.tb-step, .tb-now {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 9rpx 0;
  color: #9aacbe;
  background: #0e1219;
  border: 1rpx solid #2a313c;
  border-radius: 4rpx;
}
.tb-step:active, .tb-now:active {
  background: #1b222c;
  border-color: #3a4654;
}
.tb-now {
  color: #cfe0ee;
  border-color: #3a4654;
}
.tb-dis {
  opacity: 0.32;
}
.globe-canvas {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.globe-hint {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #5c6675;
}
.globe-legend {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}
.lg-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #8b94a3;
}
.lg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 7rpx;
}
.lg-line {
  width: 26rpx;
  height: 3rpx;
  margin-right: 7rpx;
}
.line-ok { background: #5a93a8; }
.line-blocked { background: #c25b58; }

/* ===== 展示信息区 ===== */
.result-card {
  margin: 10rpx 14rpx 0;
  padding: 12rpx 16rpx 14rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
.card-blocked { border-color: #4a2c2c; }

.sec-title {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #6fa6bd;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  margin: 2rpx 0 6rpx;
}
.sec-title:not(:first-child) {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #1f2630;
}
.sec-badge {
  margin-left: 10rpx;
  font-size: 19rpx;
  padding: 3rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid transparent;
}
.b-ok {
  color: #6cb290;
  background: rgba(78, 154, 120, 0.1);
  border-color: rgba(78, 154, 120, 0.3);
}
.b-bad {
  color: #d07673;
  background: rgba(194, 91, 88, 0.1);
  border-color: rgba(194, 91, 88, 0.3);
}
.sec-sub {
  margin-left: 10rpx;
  font-size: 19rpx;
  color: #6b7484;
  font-weight: 400;
}
.calc-time {
  margin-left: auto;
  font-size: 19rpx;
  color: #6b7484;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}

/* 键值密集网格 */
.kv-grid {
  display: flex;
  flex-wrap: wrap;
}
.kv {
  width: 50%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 3rpx 0;
  box-sizing: border-box;
}
.kv:nth-child(odd) { padding-right: 18rpx; }
.kv .k {
  font-size: 20rpx;
  color: #8b94a3;
}
.kv .v {
  font-size: 22rpx;
  color: #e6e9ef;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
  white-space: nowrap;
}
.kv .v-ok { color: #6cb290; }
.kv .v-bad { color: #d07673; }

/* 地球站对星表格 */
.es-tbl {
  display: flex;
  flex-direction: column;
}
.es-tr {
  display: flex;
  align-items: center;
  padding: 3rpx 0;
}
.es-thead .es-c {
  font-size: 19rpx;
  color: #6b7484;
}
.es-c {
  flex: 1;
  font-size: 21rpx;
  color: #cfd6df;
  text-align: right;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.es-c.c-name {
  flex: 1.2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  text-align: left;
  color: #c5ccd6;
  font-family: inherit;
}
.es-c.c-name .cn-top {
  display: flex;
  align-items: center;
}
.es-c.c-name .tag-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
}
.c-norad {
  margin-top: 2rpx;
  margin-left: 20rpx;        /* 与上行星名（圆点+间距）左对齐 */
  font-size: 17rpx;
  color: #79828f;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.es-warn { color: #d07673; }
