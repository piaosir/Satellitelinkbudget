.page {
  min-height: 100vh;
  background: #0d1117;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== 操作区（置顶） ===== */
.ctrl-zone {
  padding: 10rpx 14rpx 0;
  position: relative;
  z-index: 10;       /* 让搜索结果浮层叠在地球之上 */
}
.toggle-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.toggle-label {
  font-size: 21rpx;
  color: #8b94a3;
  margin-right: 12rpx;
}
.tg {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #6b7484;
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
  border: 1rpx solid #2a313c;
  border-radius: 5rpx;
  background: #14181f;
  opacity: 0.5;
}
.tg-on {
  color: #cfd6df;
  border-color: #3a4456;
  opacity: 1;
}
.tg-rotate {
  margin-left: auto;   /* 推到行尾，与显示开关分隔 */
  margin-right: 0;
}
.tg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 7rpx;
}
.sat-row {
  display: flex;
  gap: 12rpx;
}
.sat-col {
  flex: 1;
  min-width: 0;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
}
.card-title {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #c5ccd6;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 8rpx;
}
.dot-sat1 { background: #6f9fc8; }
.dot-sat2 { background: #c2a25e; }
.dot-station { background: #6fb88f; }

/* ===== 选星：已选名 + 搜索框 + 结果下拉 ===== */
.sel-name {
  margin-left: auto;
  max-width: 60%;
  font-size: 20rpx;
  color: #8ab4cc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sel-empty { color: #5c6675; }
.sch {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  position: relative;   /* 搜索结果浮层的定位锚点 */
}
.sch-in {
  flex: 1;
  min-width: 0;
  background: #0e1219;
  border: 1rpx solid #283039;
  border-radius: 4rpx;
  padding: 7rpx 9rpx;
  font-size: 21rpx;
  color: #e6e9ef;
}
.sch-clr {
  font-size: 22rpx;
  color: #6b7484;
  padding: 4rpx 8rpx;
  margin-left: 6rpx;
}
.sch-res {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 4rpx;
  z-index: 20;
  max-height: 300rpx;
  overflow-y: auto;
  border: 1rpx solid #2f3845;
  border-radius: 4rpx;
  background: #11161e;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45);
}
.sch-item {
  display: flex;
  flex-direction: column;
  padding: 6rpx 9rpx;
  border-bottom: 1rpx solid #1b212a;
}
.si-name {
  font-size: 21rpx;
  color: #d7dde6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.si-meta {
  font-size: 18rpx;
  color: #6b7484;
  margin-top: 1rpx;
}

.cin {
  display: flex;
  align-items: center;
  padding: 3rpx 0;
}
.cslider {
  display: flex;
  align-items: center;
  padding: 2rpx 0;
}
.cl {
  font-size: 21rpx;
  color: #8b94a3;
  width: 84rpx;
  flex-shrink: 0;
}
.cl-wide { width: 150rpx; }
.cl-mid { width: 64rpx; margin-left: 14rpx; }
.cf {
  flex: 1;
  min-width: 0;
  background: #0e1219;
  border: 1rpx solid #283039;
  border-radius: 4rpx;
  padding: 6rpx 9rpx;
  font-size: 22rpx;
  color: #e6e9ef;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.cu {
  font-size: 20rpx;
  color: #5c6675;
  width: 44rpx;
  text-align: right;
  flex-shrink: 0;
  margin-left: 4rpx;
}
.cu-hemi {
  color: #8ab4cc;
  text-decoration: underline;
  padding: 6rpx 2rpx;
}
.hint-mini {
  font-size: 19rpx;
  color: #6b7484;
  margin-top: 6rpx;
  line-height: 1.4;
}
.csl {
  flex: 1;
  min-width: 0;
  margin: 0 6rpx 0 4rpx;
}

.common-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 9rpx 12rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
/* ===== 3D 地球（flex 撑满中间剩余空间，消除底部留白） ===== */
.globe-wrap {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 700rpx;
  margin-top: 10rpx;
  background: #090c11;
  border-top: 1rpx solid #1b212a;
  border-bottom: 1rpx solid #1b212a;
}

/* ===== 时间轴 ===== */
.time-bar {
  display: flex;
  align-items: center;
  margin: 8rpx 14rpx 0;
  padding: 6rpx 14rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
.tb-label {
  font-size: 20rpx;
  color: #8b94a3;
  flex-shrink: 0;
}
.tb-slider {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx 0 12rpx;
}
.tb-time {
  font-size: 19rpx;
  color: #8ab4cc;
  flex-shrink: 0;
  text-align: right;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.tb-reset {
  font-size: 19rpx;
  color: #9aacbe;
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #2a313c;
  border-radius: 4rpx;
}
.globe-canvas {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.globe-hint {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #5c6675;
}
.globe-legend {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}
.lg-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #8b94a3;
}
.lg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 7rpx;
}
.lg-line {
  width: 26rpx;
  height: 3rpx;
  margin-right: 7rpx;
}
.line-ok { background: #5a93a8; }
.line-blocked { background: #c25b58; }

/* ===== 展示信息区 ===== */
.result-card {
  margin: 10rpx 14rpx 0;
  padding: 12rpx 16rpx 14rpx;
  background: #14181f;
  border: 1rpx solid #232a34;
  border-radius: 6rpx;
}
.card-blocked { border-color: #4a2c2c; }

.sec-title {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #6fa6bd;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  margin: 2rpx 0 6rpx;
}
.sec-title:not(:first-child) {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #1f2630;
}
.sec-badge {
  margin-left: 10rpx;
  font-size: 19rpx;
  padding: 3rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid transparent;
}
.b-ok {
  color: #6cb290;
  background: rgba(78, 154, 120, 0.1);
  border-color: rgba(78, 154, 120, 0.3);
}
.b-bad {
  color: #d07673;
  background: rgba(194, 91, 88, 0.1);
  border-color: rgba(194, 91, 88, 0.3);
}
.sec-sub {
  margin-left: 10rpx;
  font-size: 19rpx;
  color: #6b7484;
  font-weight: 400;
}
.calc-time {
  margin-left: auto;
  font-size: 19rpx;
  color: #6b7484;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}

/* 键值密集网格 */
.kv-grid {
  display: flex;
  flex-wrap: wrap;
}
.kv {
  width: 50%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 3rpx 0;
  box-sizing: border-box;
}
.kv:nth-child(odd) { padding-right: 18rpx; }
.kv .k {
  font-size: 20rpx;
  color: #8b94a3;
}
.kv .v {
  font-size: 22rpx;
  color: #e6e9ef;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
  white-space: nowrap;
}
.kv .v-ok { color: #6cb290; }
.kv .v-bad { color: #d07673; }

/* 地球站对星表格 */
.es-tbl {
  display: flex;
  flex-direction: column;
}
.es-tr {
  display: flex;
  align-items: center;
  padding: 3rpx 0;
}
.es-thead .es-c {
  font-size: 19rpx;
  color: #6b7484;
}
.es-c {
  flex: 1;
  font-size: 21rpx;
  color: #cfd6df;
  text-align: right;
  font-family: 'DIN Alternate', 'Roboto Mono', Consolas, monospace;
}
.es-c.c-name {
  flex: 1.2;
  display: flex;
  align-items: center;
  text-align: left;
  color: #c5ccd6;
  font-family: inherit;
}
.es-c.c-name .tag-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
}
.es-warn { color: #d07673; }
.es-note {
  font-size: 19rpx;
  color: #6b7484;
  margin-top: 8rpx;
}
