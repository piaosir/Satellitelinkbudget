<view class="page">
  <!-- 操作区（置顶） -->
  <view class="ctrl-zone">
    <view class="toggle-row">
      <text class="toggle-label">显示</text>
      <view class="tg {{show1 ? 'tg-on' : ''}}" data-key="show1" bindtap="onToggle"><view class="tg-dot dot-sat1"></view>卫星1</view>
      <view class="tg {{show2 ? 'tg-on' : ''}}" data-key="show2" bindtap="onToggle"><view class="tg-dot dot-sat2"></view>卫星2</view>
      <view class="tg {{showStation ? 'tg-on' : ''}}" data-key="showStation" bindtap="onToggle"><view class="tg-dot dot-station"></view>地球站</view>
      <view class="tg tg-rotate {{live ? 'tg-on' : ''}}" bindtap="toggleLive">{{live ? '实时中' : '实时关'}}</view>
      <view class="tg tg-rotate {{autoRotate ? 'tg-on' : ''}}" bindtap="toggleRotate">{{autoRotate ? '自转中' : '自转停'}}</view>
    </view>
    <view class="sat-row">
      <!-- 卫星1 -->
      <view class="sat-col">
        <view class="card-title"><view class="tag-dot dot-sat1"></view>卫星1
          <text class="grp-chip {{group1 ? '' : 'grp-empty'}}" catchtap="toggleGroup1">{{group1Label || '全部'}} ▾</text>
          <view wx:if="{{groupOpen1}}" class="grp-pop">
            <view wx:for="{{groupList}}" wx:key="key" class="grp-item {{group1 === item.key ? 'grp-on' : (item.key ? '' : 'grp-all')}}"
              data-key="{{item.key}}" data-label="{{item.label}}" catchtap="onPickGroup1">{{item.label}}</view>
          </view>
        </view>
        <view class="sch">
          <input class="sch-in" value="{{kw1}}" placeholder="{{group1 ? '组内过滤，或在下方直接选' : '输入卫星名或 NORAD 搜索'}}"
            bindfocus="onSearchFocus1" bindinput="onSearchInput1" confirm-type="search" />
          <text wx:if="{{kw1}}" class="sch-clr" bindtap="clearSearch1">✕</text>
        </view>
        <!-- 波束角(全波束°)：placeholder 常显该星 ε=0 上限，可手填更小值；清空即回到自动 -->
        <view class="bw-row">
          <text class="bw-l">波束角</text>
          <input class="bw-in" type="digit" value="{{beam1}}" placeholder="{{beam1Auto || '自动'}}" data-slot="1" bindinput="onBeamInput" />
          <text class="bw-u">°</text>
        </view>
        <view wx:if="{{results1.length}}" class="sch-res">
          <view class="sch-res-hd">
            <text class="sch-res-ti">{{group1Label || '搜索结果'}} · {{results1.length}} 颗</text>
            <text class="sch-res-x" catchtap="closeResults1">✕ 关闭</text>
          </view>
          <scroll-view class="sch-res-list" scroll-y>
            <view wx:for="{{results1}}" wx:key="noradId" class="sch-item" data-norad="{{item.noradId}}" data-group="{{item.group}}" bindtap="onPickResult1">
              <text class="si-name">{{item.name}}</text>
              <text class="si-meta">{{item.groupLabel}} · {{item.noradId}}{{item.lonText ? ' · 定点 ' + item.lonText : ''}}</text>
            </view>
          </scroll-view>
        </view>
      </view>
      <!-- 卫星2 -->
      <view class="sat-col">
        <view class="card-title"><view class="tag-dot dot-sat2"></view>卫星2
          <text class="grp-chip {{group2 ? '' : 'grp-empty'}}" catchtap="toggleGroup2">{{group2Label || '全部'}} ▾</text>
          <view wx:if="{{groupOpen2}}" class="grp-pop">
            <view wx:for="{{groupList}}" wx:key="key" class="grp-item {{group2 === item.key ? 'grp-on' : (item.key ? '' : 'grp-all')}}"
              data-key="{{item.key}}" data-label="{{item.label}}" catchtap="onPickGroup2">{{item.label}}</view>
          </view>
        </view>
        <view class="sch">
          <input class="sch-in" value="{{kw2}}" placeholder="{{group2 ? '组内过滤，或在下方直接选' : '输入卫星名或 NORAD 搜索'}}"
            bindfocus="onSearchFocus2" bindinput="onSearchInput2" confirm-type="search" />
          <text wx:if="{{kw2}}" class="sch-clr" bindtap="clearSearch2">✕</text>
        </view>
        <!-- 波束角(全波束°)：placeholder 常显该星 ε=0 上限，可手填更小值；清空即回到自动 -->
        <view class="bw-row">
          <text class="bw-l">波束角</text>
          <input class="bw-in" type="digit" value="{{beam2}}" placeholder="{{beam2Auto || '自动'}}" data-slot="2" bindinput="onBeamInput" />
          <text class="bw-u">°</text>
        </view>
        <view wx:if="{{results2.length}}" class="sch-res">
          <view class="sch-res-hd">
            <text class="sch-res-ti">{{group2Label || '搜索结果'}} · {{results2.length}} 颗</text>
            <text class="sch-res-x" catchtap="closeResults2">✕ 关闭</text>
          </view>
          <scroll-view class="sch-res-list" scroll-y>
            <view wx:for="{{results2}}" wx:key="noradId" class="sch-item" data-norad="{{item.noradId}}" data-group="{{item.group}}" bindtap="onPickResult2">
              <text class="si-name">{{item.name}}</text>
              <text class="si-meta">{{item.groupLabel}} · {{item.noradId}}{{item.lonText ? ' · 定点 ' + item.lonText : ''}}</text>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <view class="common-row">
      <text class="cl cl-wide">地球站 经度</text>
      <input class="cf" type="digit" value="{{esLon}}" data-key="esLon" bindinput="onInput" />
      <text class="cu cu-hemi" data-key="esLon" bindtap="toggleHemi">{{lonHemi}}</text>
      <text class="cl cl-mid">纬度</text>
      <input class="cf" type="digit" value="{{esLat}}" data-key="esLat" bindinput="onInput" />
      <text class="cu cu-hemi" data-key="esLat" bindtap="toggleHemi">{{latHemi}}</text>
    </view>
    <!-- 点空白处关闭浮层：透明全屏遮罩，置于浮层之下、其余内容之上（与浮层同处操作区层叠上下文） -->
    <view wx:if="{{groupOpen1 || groupOpen2 || results1.length || results2.length}}"
      class="pop-mask" catchtap="closeAllPops"></view>
  </view>

  <!-- 3D 地球（canvas 为原生层、会盖住普通浮层；选星浮层展开时隐藏地球，彻底避免遮挡） -->
  <view class="globe-wrap">
    <canvas type="2d" id="globeCanvas" class="globe-canvas"
      hidden="{{results1.length || results2.length}}"
      bindtouchstart="onTouchStart" catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"
      catchwheel="onWheel"></canvas>
    <view class="globe-legend" hidden="{{results1.length || results2.length}}">
      <view class="lg-item"><view class="lg-dot dot-sat1"></view>卫星1</view>
      <view class="lg-item"><view class="lg-dot dot-sat2"></view>卫星2</view>
      <view class="lg-item"><view class="lg-dot dot-station"></view>地球站</view>
      <view class="lg-item"><view class="lg-line {{blocked ? 'line-blocked' : 'line-ok'}}"></view>ISL</view>
    </view>
  </view>

  <!-- 时间轴（非实时，可拖动查看未来 24h 轨道变化）：粗调拖滑块、精调点步进 -->
  <view class="time-bar">
    <view class="tb-row">
      <text class="tb-label">时间轴</text>
      <view class="tb-track" bindtouchstart="onTrackTouch" catchtouchmove="onTrackTouch" bindtouchend="onTrackEnd">
        <view class="tb-bar"><view class="tb-fill" style="width:{{timePct}}%"></view></view>
        <view class="tb-knob" style="left:{{timePct}}%"></view>
      </view>
      <text class="tb-time">{{live ? '实时' : timeLabel}}</text>
    </view>
    <view class="tb-steps">
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="-60" bindtap="stepTime">−1h</text>
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="-10" bindtap="stepTime">−10m</text>
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="-1" bindtap="stepTime">−1m</text>
      <text class="tb-now {{(!live && timeOffset > 0) ? '' : 'tb-dis'}}" bindtap="resetTime">此刻</text>
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="1" bindtap="stepTime">+1m</text>
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="10" bindtap="stepTime">+10m</text>
      <text class="tb-step {{live ? 'tb-dis' : ''}}" data-d="60" bindtap="stepTime">+1h</text>
    </view>
  </view>

  <!-- 展示信息区 -->
  <view class="result-card {{blocked ? 'card-blocked' : ''}}">
    <!-- 地球站对星（上移至顶部） -->
    <view class="sec-title">
      地球站对星
      <text class="sec-sub">站址 {{esAddr}}</text>
      <text class="calc-time">{{live ? '实时' : '计算'}} {{calcTime}}</text>
    </view>
    <view class="es-tbl">
      <view class="es-tr es-thead">
        <view class="es-c c-name">目标</view>
        <view class="es-c">斜距 km</view>
        <view class="es-c">仰角 °</view>
        <view class="es-c">方位角 °</view>
        <view class="es-c">时延 ms</view>
      </view>
      <view class="es-tr">
        <view class="es-c c-name">
          <view class="cn-top"><view class="tag-dot dot-sat1"></view>卫星1</view>
          <text class="c-norad" wx:if="{{sat1Norad}}">NORAD {{sat1Norad}}</text>
        </view>
        <view class="es-c">{{slant1}}</view>
        <view class="es-c {{vis1 ? '' : 'es-warn'}}">{{elev1}}</view>
        <view class="es-c">{{az1}}</view>
        <view class="es-c">{{esDelay1}}</view>
      </view>
      <view class="es-tr">
        <view class="es-c c-name">
          <view class="cn-top"><view class="tag-dot dot-sat2"></view>卫星2</view>
          <text class="c-norad" wx:if="{{sat2Norad}}">NORAD {{sat2Norad}}</text>
        </view>
        <view class="es-c">{{slant2}}</view>
        <view class="es-c {{vis2 ? '' : 'es-warn'}}">{{elev2}}</view>
        <view class="es-c">{{az2}}</view>
        <view class="es-c">{{esDelay2}}</view>
      </view>
    </view>

    <!-- 星间链路几何 -->
    <view class="sec-title">
      星间链路 ISL 几何
      <text class="sec-badge {{blocked ? 'b-bad' : 'b-ok'}}">{{statusText}}</text>
    </view>
    <view class="kv-grid">
      <view class="kv"><text class="k">ISL 斜距（当前）</text><text class="v">{{dCur}} km</text></view>
      <view class="kv"><text class="k">几何视距上限</text><text class="v">{{dMax}} km</text></view>
      <view class="kv"><text class="k">视距裕量</text><text class="v {{blocked ? 'v-bad' : 'v-ok'}}">{{losMargin}} km</text></view>
      <view class="kv"><text class="k">ISL时延</text><text class="v">{{delayMs}} ms</text></view>
    </view>
  </view>
</view>
