          <text class="form-label">MODCOD</text>
          <picker mode="selector" 
                  range="{{currentModcodList}}" 
                  range-key="label"
                  value="{{modcodPickerIndex}}"
                  bindchange="onModcodChange">
            <view class="form-picker">
              {{currentModcodList[modcodPickerIndex].label || '请选择'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 3GPP NTN 物理层参数：选了 3GPP 一族的标准才出。
           占用带宽 = PRB 数 × 12 × 子载波间隔（NB-IoT 上行 = 子载波数 × 子载波间隔），它就是门限那个
           SNR 的噪声带宽 —— 没有这几项，3GPP 的门限无处安放，只能被当 Es/N₀ 硬算。
           每一格的取值方法写在「使用帮助 → 链路预算逐项说明 / NTN 标准怎么配」两章，版面上不写字。 -->
      <!-- 旧档提示：v3.8.11 之前的 3GPP 配置按 Es/N₀ 存的，门限表也停在旧版本。
           不自动改（静默换掉一份存档的算法，用户无从知道结论何时变了），只在这里说明怎么对齐。 -->
      <view class="ntn-legacy" wx:if="{{ntn.legacy}}">
        这份配置存于 3GPP 口径修正之前：门限按 Es/N₀ 存、走的是 DVB 那条换算链，表数据也停在旧版本。
        重新选一次上面的 MODCOD，即整条载波对齐到本版（门限改按每资源元素 SNR，占用带宽由物理层参数算）。
        算过的历史结果不受影响。
      </view>

      <view class="ntn-block" wx:if="{{ntn.on}}">
        <view class="ntn-head">
          <text class="ntn-head-t">3GPP 物理层 · {{ntn.kindText}}</text>
          <text class="ntn-head-s">{{ntn.descText}}</text>
        </view>

        <!-- ===== NR ===== -->
        <block wx:if="{{ntn.isNr}}">
          <view class="grid-3">
            <view class="form-group">
              <text class="form-label">方向</text>
              <picker wx:if="{{!ntn.dirLocked}}" mode="selector" range="{{ntn.dirOptions}}"
                      value="{{ntn.dirIndex}}" bindchange="onNtnDirChange">
                <view class="form-picker">{{ntn.dirText}}</view>
              </picker>
              <view wx:else class="form-picker form-picker-lock">{{ntn.dirText}}</view>
            </view>
            <view class="form-group">
              <text class="form-label">NTN 频段</text>
              <picker mode="selector" range="{{ntn.bandOptions}}" range-key="label"
                      value="{{ntn.bandIndex}}" bindchange="onNtnBandChange">
                <view class="form-picker">{{ntn.bandOptions[ntn.bandIndex].label}}</view>
              </picker>
            </view>
            <view class="form-group">
              <text class="form-label">子载波间隔<text class="form-label-unit">(kHz)</text></text>
              <picker mode="selector" range="{{ntn.scsOptions}}" range-key="label"
                      value="{{ntn.scsIndex}}" bindchange="onNtnScsChange">
                <view class="form-picker">{{ntn.scsOptions[ntn.scsIndex].label}}</view>
              </picker>
            </view>
          </view>

          <view class="grid-3">
            <view class="form-group">
              <text class="form-label">信道带宽</text>
              <picker mode="selector" range="{{ntn.bwOptions}}" range-key="label"
                      value="{{ntn.bwIndex}}" bindchange="onNtnBwChange">
                <view class="form-picker">{{ntn.bwOptions[ntn.bwIndex].label}}</view>
              </picker>
            </view>
            <view class="form-group">
              <text class="form-label">PRB 数</text>
              <input class="form-input {{focusedField === 'nRb' ? 'input-focused' : ''}}"
                     type="digit" placeholder="25" value="{{ntn.nRb}}"
                     data-field="nRb" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group">
              <text class="form-label">重复次数</text>
              <input class="form-input {{focusedField === 'nRep' ? 'input-focused' : ''}}"
                     type="digit" placeholder="1" value="{{ntn.nRep}}"
                     data-field="nRep" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="grid-3" wx:if="{{ntn.isTbs}}">
            <view class="form-group">
              <text class="form-label">符号数</text>
              <input class="form-input" type="digit" placeholder="12" value="{{ntn.nSymb}}"
                     data-field="nSymb" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group">
              <text class="form-label">DMRS<text class="form-label-unit">(RE/PRB)</text></text>
              <input class="form-input" type="digit" placeholder="12" value="{{ntn.nDmrs}}"
                     data-field="nDmrs" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group">
              <text class="form-label">其他开销<text class="form-label-unit">(RE/PRB)</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{ntn.nOh}}"
                     data-field="nOh" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="grid-3">
            <view class="form-group">
              <text class="form-label">层数</text>
              <input class="form-input" type="digit" placeholder="1" value="{{ntn.layers}}"
                     data-field="layers" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group">
              <text class="form-label">合并损失<text class="form-label-unit">(dB)</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{ntn.combLossDb}}"
                     data-field="combLossDb" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group">
              <text class="form-label">速率模型</text>
              <picker mode="selector" range="{{ntn.rateModelOptions}}" range-key="label"
                      value="{{ntn.rateModelIndex}}" bindchange="onNtnRateModelChange">
                <view class="form-picker">{{ntn.rateModelOptions[ntn.rateModelIndex].label}}</view>
              </picker>
            </view>
          </view>
        </block>

        <!-- ===== NB-IoT ===== -->
        <block wx:else>
          <view class="grid-3">
            <view class="form-group">
              <text class="form-label">方向</text>
              <view class="form-picker form-picker-lock">{{ntn.dirText}}</view>
            </view>
            <view class="form-group">
              <text class="form-label">子载波间隔<text class="form-label-unit">(kHz)</text></text>
              <picker wx:if="{{!ntn.scsLocked}}" mode="selector" range="{{ntn.scsOptions}}" range-key="label"
                      value="{{ntn.scsIndex}}" bindchange="onNtnScsChange">
                <view class="form-picker">{{ntn.scsOptions[ntn.scsIndex].label}}</view>
              </picker>
              <view wx:else class="form-picker form-picker-lock">{{ntn.scsOptions[ntn.scsIndex].label}}</view>
            </view>
            <view class="form-group">
              <text class="form-label">子载波数</text>
              <picker wx:if="{{!ntn.toneLocked}}" mode="selector" range="{{ntn.toneOptions}}" range-key="label"
                      value="{{ntn.toneIndex}}" bindchange="onNtnToneChange">
                <view class="form-picker">{{ntn.toneOptions[ntn.toneIndex].label}}</view>
              </picker>
              <view wx:else class="form-picker form-picker-lock">{{ntn.toneOptions[ntn.toneIndex].label}}</view>
            </view>
          </view>

          <view class="grid-3">
            <view class="form-group" wx:if="{{ntn.opModeOn}}">
              <text class="form-label">部署模式</text>
              <picker mode="selector" range="{{ntn.opModeOptions}}" range-key="label"
                      value="{{ntn.opModeIndex}}" bindchange="onNtnOpModeChange">
                <view class="form-picker">{{ntn.opModeOptions[ntn.opModeIndex].label}}</view>
              </picker>
            </view>
            <view class="form-group">
              <text class="form-label">{{ntn.spanLabel}}</text>
              <picker mode="selector" range="{{ntn.spanOptions}}" range-key="label"
                      value="{{ntn.spanIndex}}" bindchange="onNtnSpanChange">
                <view class="form-picker">{{ntn.spanOptions[ntn.spanIndex].label}}</view>
              </picker>
            </view>
            <view class="form-group">
              <text class="form-label">重复次数</text>
              <input class="form-input {{focusedField === 'nRep' ? 'input-focused' : ''}}"
                     type="digit" placeholder="1" value="{{ntn.nRep}}"
                     data-field="nRep" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="form-group" wx:if="{{!ntn.opModeOn}}">
              <text class="form-label">合并损失<text class="form-label-unit">(dB)</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{ntn.combLossDb}}"
                     data-field="combLossDb" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="grid-3" wx:if="{{ntn.opModeOn}}">
            <view class="form-group">
              <text class="form-label">合并损失<text class="form-label-unit">(dB)</text></text>
              <input class="form-input" type="digit" placeholder="0" value="{{ntn.combLossDb}}"
                     data-field="combLossDb" data-focus-area="carrier" adjust-position="{{true}}" cursor-spacing="120"
                     bindinput="onNtnNumInput" bindfocus="onInputFocus"
                     selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>
        </block>

        <!-- 只读读数：占用带宽就是门限那个 SNR 的噪声带宽；频谱效率按信道带宽算，与计算结果同口径 -->
        <view class="ntn-out">
          <view class="ntn-out-i"><text class="ntn-out-l">占用带宽</text><text class="ntn-out-v">{{ntn.out.bOcc}} kHz</text></view>
          <view class="ntn-out-i"><text class="ntn-out-l">信道带宽</text><text class="ntn-out-v">{{ntn.out.bCh}} kHz</text></view>
          <view class="ntn-out-i"><text class="ntn-out-l">信息速率</text><text class="ntn-out-v">{{ntn.out.rate}} kbps</text></view>
          <view class="ntn-out-i"><text class="ntn-out-l">TBS</text><text class="ntn-out-v">{{ntn.out.tbs}} bit</text></view>
          <view class="ntn-out-i"><text class="ntn-out-l">频谱效率</text><text class="ntn-out-v">{{ntn.out.se}} bps/Hz</text></view>
        </view>
        <view class="ntn-err" wx:if="{{ntn.out.error}}">{{ntn.out.error}}</view>
        <!-- 单音表的行号是 I_MCS，phy 里存的是映射后的 I_TBS。对不上的（本版之前直接存了 I_MCS 的存档、或外来 phy）不静默改，只标出来 -->
        <view class="ntn-err" wx:if="{{ntn.stMismatch}}">所选单音档位的 I_TBS 与物理层参数不一致，重新选一次上面的 MODCOD 即对齐。</view>
      </view>


      <!-- 第一行：核心参数 4列 -->
      <view class="grid-4">
        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">信息速率<text class="form-label-unit">(kbps)</text></text>
          </view>
          <!-- 3GPP 行：信息速率由 TBS ÷ 时长算出（见上方物理层面板），填进来也不参与计算，故置灰只读 -->
          <input class="form-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'infoRate' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="2048" 
                 value="{{linkParams.infoRate}}"
                 data-field="infoRate"
               data-focus-area="carrier"
               disabled="{{ntn.on}}"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">调制方式</text>
          </view>
          <picker mode="selector" 
                  range="{{modulationOptions}}" 
                  range-key="label"
                  value="{{modulationIndex}}"
                  data-field="modulation"
                  bindchange="onLinkPickerChange">
            <view class="form-picker">
              {{linkParams.modulation || '请选择'}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">FEC码率</text>
          </view>
          <input class="form-input {{focusedField === 'fec' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="3/4" 
                 value="{{linkParams.fec}}"
                 data-field="fec"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onFecInput" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">{{noiseRatioMode === 'snr' ? 'SNR' : (noiseRatioMode === 'ebno' ? 'Eb/N₀' : 'Es/N₀')}}门限<text class="form-label-unit">(dB)</text></text>
            <view class="unit-toggle" bindtap="toggleEbnoEsno"><view class="unit-toggle-icon"></view></view>
          </view>
          <input class="form-input {{focusedField === 'ebno' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="5.50" 
                 value="{{linkParams.ebno}}"
                 data-field="ebno"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>

      <!-- 第二行：扩展参数 -->
      <view class="grid-4">
        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">误码率 <text class="form-label-unit">(1×10⁻ⁿ)</text></text>
          </view>
          <!-- 3GPP 行：门限按 BLER 10% 首传给，误码率对它无意义（结果里改报「目标 BLER」），置灰只读 -->
          <input class="form-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'ber' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="7"
                 value="{{linkParams.ber}}"
                 data-field="ber"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">扩频增益</text>
          </view>
          <!-- 扩频增益 / 滚降 / 帧效率是 DVB 换算链上的三项，对 3GPP 的 OFDM 载波不参与计算，置灰只读 -->
          <input class="form-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'm' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="1.00"
                 value="{{linkParams.m}}"
                 data-field="m"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">滚降系数<text class="form-label-unit">(1+α)</text></text>
          </view>
          <input class="form-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'bandwidthFactor' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="1.20"
                 value="{{linkParams.bandwidthFactor}}"
                 data-field="bandwidthFactor"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">{{rsCodeMode === 'spectral' ? '频谱效率' : '帧效率'}}<text class="form-label-unit">{{rsCodeMode === 'spectral' ? '(bps/Hz)' : ''}}</text></text>
            <view class="unit-toggle" bindtap="toggleRsCodeMode"><view class="unit-toggle-icon"></view></view>
          </view>
          <input class="form-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'rsCode' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="{{rsCodeMode === 'spectral' ? '0.9216' : '188/204'}}"
                 value="{{rsCodeMode === 'spectral' ? realtimeParams.spectralEfficiency : linkParams.rsCode}}"
                 data-field="rsCode"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onRsCodeInput" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>
      
      <!-- 实时计算结果 -->
      <view class="station-result station-result-row">
        <view class="station-result-item station-result-editable">
          <text class="station-result-label">载波带宽</text>
          <!-- 3GPP 行：信道带宽在物理层面板里选档、符号率对 OFDM 没有这个读数，两格都只读——
               否则在这里填一个数会切到符号率 / 载波带宽优先模式，用 DVB 公式把信息速率反推回去 -->
          <input class="station-result-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'carrierBandwidth' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="--"
                 value="{{realtimeParams.carrierBandwidth}}"
                 data-field="carrierBandwidth"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onCarrierBandwidthInput"
                 bindblur="onCarrierBandwidthBlur"
                 bindfocus="onInputFocus"
                 selection-start="{{inputSelectAll ? 0 : -1}}"
                 selection-end="{{inputSelectAll ? 999 : -1}}" />
          <text class="station-result-unit">kHz</text>
        </view>
        <view class="station-result-item station-result-editable">
          <text class="station-result-label">符号率</text>
          <input class="station-result-input {{ntn.on ? 'input-readonly' : ''}} {{focusedField === 'symbolRate' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="--"
                 value="{{realtimeParams.symbolRate}}"
                 data-field="symbolRate"
                 disabled="{{ntn.on}}"
               data-focus-area="carrier"
               adjust-position="{{true}}"
               cursor-spacing="120"
                 bindinput="onSymbolRateInput"
                 bindblur="onSymbolRateBlur"
                 bindfocus="onInputFocus"
                 selection-start="{{inputSelectAll ? 0 : -1}}"
                 selection-end="{{inputSelectAll ? 999 : -1}}" />
          <text class="station-result-unit">ksps</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 计算结果 -->
  <view id="result-section" class="card card-full-width" wx:if="{{hasResults}}">
    <view class="card-title">
      计算结果
      <view class="more-results-btn" bindtap="goToResultsDetail">
        <text>查看更多计算结果</text>
        <text class="more-arrow">»</text>
      </view>
    </view>
    
    <view class="collapse-content show">
    
    <!-- 核心结论区 - 置顶 -->
    <view class="core-results {{resultsFlash ? 'results-flash' : ''}}">

      <!-- 仰角警告置顶提示 -->
      <view wx:if="{{elevationWarningInfo.tx || elevationWarningInfo.rx}}" class="elevation-warning-banner">
        <!-- 发信站（左） -->
        <view wx:if="{{elevationWarningInfo.tx}}" class="elevation-warning-item elevation-warning-{{elevationWarningInfo.tx.level}}">
          <text class="elevation-warning-icon">{{elevationWarningInfo.tx.level === 'error' ? '✕' : '▲'}}</text>
          <text class="elevation-warning-text">{{elevationWarningInfo.tx.message}}<text wx:if="{{elevationWarningInfo.tx.level !== 'error'}}" class="elevation-warning-value"> ({{elevationWarningInfo.tx.elevation}}°)</text></text>
        </view>
        <view wx:else class="elevation-warning-placeholder"></view>
        <!-- 收信站（右） -->
        <view wx:if="{{elevationWarningInfo.rx}}" class="elevation-warning-item elevation-warning-{{elevationWarningInfo.rx.level}}">
          <text class="elevation-warning-icon">{{elevationWarningInfo.rx.level === 'error' ? '✕' : '▲'}}</text>
          <text class="elevation-warning-text">{{elevationWarningInfo.rx.message}}<text wx:if="{{elevationWarningInfo.rx.level !== 'error'}}" class="elevation-warning-value"> ({{elevationWarningInfo.rx.elevation}}°)</text></text>
        </view>
        <view wx:else class="elevation-warning-placeholder"></view>
      </view>

      <view class="core-results-grid">
        <view class="core-result-row">
          <text class="core-result-label">功放建议</text>
          <text class="core-result-value">{{results.paRecommendation}} W / {{results.paRecommendationdBResult}} dBW</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">链路余量</text>
          <text class="core-result-value">{{results.linkmargin}} dB</text>
        </view>
        <view class="core-result-row-with-bar">
          <view class="core-result-row">
            <text class="core-result-label">带宽占比</text>
            <text class="core-result-value {{results.bandwidthUsageRatio > 100 ? 'value-danger' : ''}}">{{results.bandwidthUsageRatio}}%</text>
          </view>
          <view class="core-ratio-bar">
            <view class="core-ratio-bar-fill {{results.bandwidthUsageRatio > 100 ? 'bar-danger' : results.bandwidthUsageRatio > 80 ? 'bar-warn' : 'bar-normal'}}" style="width: {{results.bandwidthUsageRatio > 100 ? 100 : results.bandwidthUsageRatio}}%"></view>
          </view>
        </view>
        <view class="core-result-row-with-bar">
          <view class="core-result-row">
            <text class="core-result-label">功率占比</text>
            <text class="core-result-value {{results.powerUsageRatio > 100 ? 'value-danger' : ''}}">{{results.powerUsageRatio}}%</text>
          </view>
          <view class="core-ratio-bar">
            <view class="core-ratio-bar-fill {{results.powerUsageRatio > 100 ? 'bar-danger' : results.powerUsageRatio > 80 ? 'bar-warn' : 'bar-normal'}}" style="width: {{results.powerUsageRatio > 100 ? 100 : results.powerUsageRatio}}%"></view>
          </view>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">载波带宽</text>
          <text class="core-result-value">{{results.allocBandwidthResult}} kHz</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">功率带宽</text>
          <text class="core-result-value">{{results.PowerBWResult}} kHz</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">载波总C/N</text>
          <text class="core-result-value">{{results.carrierTotalCN}} dB</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">门限C/N</text>
          <text class="core-result-value">{{results.thresholdCN}} dB</text>
        </view>
      </view>
    </view>

    <!-- 详细结果已移至独立页面，主页仅保留核心结论和链路计算结果 -->
    <view wx:if="{{false}}">
    <!-- 上行站结果 -->
    <view class="result-section">
      <view class="result-section-title">发信站参数</view>
      <view class="result-grid-2">
        <view class="result-item {{markedParams.indexOf('earthAntennaDiameterResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthAntennaDiameterResult">
          <text class="result-label">地球站天线口径</text>
          <text class="result-value">{{results.earthAntennaDiameterResult}} 米</text>
        </view>
        <view class="result-item {{markedParams.indexOf('earthLongitudeResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthLongitudeResult">
