<!--index.wxml-->
<wxs module="utils">
  function includes(arr, val) {
    if (!arr || !arr.length) return false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === val) return true;
    }
    return false;
  }
  module.exports = { includes: includes };
</wxs>
<view class="container {{isNotIOS ? 'non-ios' : ''}}">
  <!-- 悬浮顶部操作栏 -->
  <view class="floating-action-bar" style="top: {{navBarTop}}px; height: {{navBarHeight}}px; left: {{navBarRight}}px;" catchtouchmove="preventTouchMove">
    <!-- 开始计算按钮 -->
    <view class="float-btn float-btn-primary" bindtap="onStartCalculate">
      <view class="float-icon icon-play"></view>
    </view>
    
    <!-- 余量/正向计算合并按钮 -->
    <view class="float-btn float-btn-margin" bindtap="showMarginPanel">
      <text class="float-margin-value">{{calcMode === 'forward' ? (inputPaPower || 'PA') : marginValue}}</text>
      <text class="float-margin-unit">{{calcMode === 'forward' ? 'W' : 'dB'}}</text>
    </view>
    
    <!-- 历史记录按钮 -->
    <view class="float-btn" bindtap="toggleHistoryPanel">
      <view class="float-icon icon-history"></view>
    </view>
    
    <!-- 配置管理按钮 -->
    <view class="float-btn" bindtap="showConfigMenu">
      <view class="float-icon icon-settings"></view>
    </view>
    
    <!-- 可视化按钮 -->
    <view class="float-btn float-btn-ar" bindtap="showVisualPanel">
      <view class="float-icon icon-visual"></view>
    </view>
  </view>

  <!-- 可视化功能选择面板 -->
  <view class="visual-popup {{showVisualPopup ? 'show' : ''}}" wx:if="{{showVisualPopup}}" catchtouchmove="preventTouchMove">
    <view class="visual-popup-header">
      <text class="visual-popup-title">可视化工具</text>
      <text class="visual-popup-close" bindtap="hideVisualPanel">✕</text>
    </view>
    <view class="visual-popup-body">
      <view class="visual-option" bindtap="goToARAlign">
        <view class="visual-option-icon">
          <view class="option-icon icon-ar-satellite"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">AR对星</text>
          <text class="visual-option-desc">使用增强现实辅助天线对星</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToCoverageMap">
        <view class="visual-option-icon">
          <view class="option-icon icon-coverage"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">卫星覆盖</text>
          <text class="visual-option-desc">查看当前卫星的覆盖范围</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
    </view>
  </view>
  
  <!-- 可视化面板遮罩 -->
  <view class="visual-popup-mask {{showVisualPopup ? 'show' : ''}}" wx:if="{{showVisualPopup}}" bindtap="hideVisualPanel" catchtouchmove="preventTouchMove"></view>

  <!-- 余量/正向计算弹出面板 -->
  <view class="margin-popup {{showMarginPopup ? 'show' : ''}}" wx:if="{{showMarginPopup}}" catchtouchmove="preventTouchMove">
    <view class="margin-popup-header">
      <view class="margin-mode-tabs">
        <view class="margin-mode-tab {{calcMode === 'reverse' ? 'active' : ''}}" bindtap="setCalcMode" data-mode="reverse">
          <text>反向计算</text>
        </view>
        <view class="margin-mode-tab {{calcMode === 'forward' ? 'active' : ''}}" bindtap="setCalcMode" data-mode="forward">
          <text>正向计算</text>
        </view>
      </view>
      <text class="margin-popup-close" bindtap="hideMarginPanel">✕</text>
    </view>
    
    <!-- 反向模式：输入余量 -->
    <view class="margin-popup-body" wx:if="{{calcMode === 'reverse'}}">
      <view class="margin-popup-row">
        <text class="margin-popup-label">目标余量</text>
        <input class="margin-popup-input" 
               type="text"
               placeholder="3.00" 
               value="{{marginValue}}"
               adjust-position="{{false}}"
               hold-keyboard="{{true}}"
               bindinput="onMarginInput" bindfocus="onMarginInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        <text class="margin-popup-unit">dB</text>
        <view class="margin-popup-balance" bindtap="autoBalanceMargin">
          <text>平衡</text>
        </view>
        <view class="margin-popup-calc" bindtap="calculateLink">
          <text>计算</text>
        </view>
      </view>
      <view class="margin-popup-hint">
        <text>输入目标余量后点击计算，或点击平衡自动计算功带平衡余量</text>
      </view>
    </view>
    
    <!-- 正向模式：输入功放功率 -->
    <view class="margin-popup-body" wx:else>
      <view class="margin-popup-row">
        <text class="margin-popup-label">功放功率</text>
        <input class="margin-popup-input" 
               type="digit"
               placeholder="400" 
               value="{{inputPaPower}}"
               adjust-position="{{false}}"
               hold-keyboard="{{true}}"
               bindinput="onPaPowerInput" bindfocus="onMarginInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        <text class="margin-popup-unit">W</text>
        <view class="margin-popup-calc {{isForwardCalculating ? 'loading' : ''}}" bindtap="forwardCalculate">
          <text>{{isForwardCalculating ? '...' : '反推'}}</text>
        </view>
      </view>
      <view class="margin-popup-hint">
        <text>💡 输入功放功率，反推可达余量</text>
      </view>
    </view>
  </view>
  
  <!-- 余量面板遮罩 -->
  <view class="margin-popup-mask {{showMarginPopup ? 'show' : ''}}" wx:if="{{showMarginPopup}}" bindtap="hideMarginPanel" catchtouchmove="preventTouchMove"></view>

  <!-- 历史记录面板 -->
  <view class="history-panel {{showHistoryPanel ? 'show' : ''}}" style="top: {{navBarTop + navBarHeight + 8}}px; height: calc(100vh - {{navBarTop + navBarHeight + 8}}px);">
    <view class="history-header">
      <text class="history-title">{{historySelectMode ? '已选择 ' + selectedHistoryIds.length + ' 条' : '最近计算记录'}}</text>
      <view class="history-actions">
        <text class="history-select-btn {{historySelectMode ? 'active' : ''}}" bindtap="toggleHistorySelectMode" wx:if="{{historyRecords.length > 0}}">{{historySelectMode ? '取消' : '多选'}}</text>
        <text class="history-export-btn" bindtap="exportHistoryExcel" wx:if="{{historySelectMode && selectedHistoryIds.length > 0}}">Excel</text>
        <text class="history-clear" bindtap="clearAllHistory" wx:if="{{historyRecords.length > 0 && !historySelectMode}}">清空</text>
        <text class="history-close" bindtap="toggleHistoryPanel">✕</text>
      </view>
    </view>
    <scroll-view scroll-y class="history-list" enhanced show-scrollbar="{{false}}" wx:if="{{historyRecords.length > 0}}">
      <view class="history-item-wrapper {{utils.includes(selectedHistoryIds, item.id) ? 'selected' : ''}}" wx:for="{{historyRecords}}" wx:key="id"
        bindtap="{{historySelectMode ? 'toggleHistorySelection' : ''}}"
        data-id="{{item.id}}">
        <!-- 多选指示器 -->
        <view class="history-select-indicator {{utils.includes(selectedHistoryIds, item.id) ? 'checked' : ''}}" wx:if="{{historySelectMode}}">
          <view class="history-select-checkbox"></view>
        </view>
        <view class="history-item-content {{item.animating ? 'animating' : ''}} {{historySelectMode ? 'select-mode' : ''}}" 
              style="transform: translateX({{historySelectMode ? 0 : (item.offsetX || 0)}}px);"
              bindtouchstart="{{historySelectMode ? '' : 'onHistoryTouchStart'}}"
              bindtouchmove="{{historySelectMode ? '' : 'onHistoryTouchMove'}}"
              bindtouchend="{{historySelectMode ? '' : 'onHistoryTouchEnd'}}"
              data-id="{{item.id}}">
          <view class="history-item-main" catchtap="{{historySelectMode ? '' : 'loadHistoryRecord'}}" data-id="{{item.id}}">
            <view class="history-item-header">
              <text class="history-satellite">{{item.satelliteName}}</text>
              <text class="history-time">{{item.time}}</text>
            </view>
            <view class="history-item-body">
              <text class="history-info">{{item.txLocation}} → {{item.rxLocation}}</text>
              <text class="history-params">{{item.infoRate}}kbps | {{item.modulation}} | 余量{{item.margin}}dB</text>
              <text class="history-result">功放: {{item.paRecommendation}}W</text>
            </view>
          </view>
        </view>
        <view class="history-item-actions-bg" wx:if="{{!historySelectMode}}">
          <view class="history-action-save" catchtap="saveHistoryToConfig" data-id="{{item.id}}">
            <text>收藏</text>
          </view>
          <view class="history-action-delete" catchtap="deleteHistoryRecord" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="history-empty" wx:else>
      <text class="history-empty-icon">📋</text>
      <text class="history-empty-text">暂无历史记录</text>
      <text class="history-empty-hint">完成一次计算后将自动保存</text>
    </view>
  </view>

  <!-- 历史面板遮罩 -->
  <view class="history-mask {{showHistoryPanel ? 'show' : ''}}" bindtap="toggleHistoryPanel" catchtouchmove="preventTouchMove"></view>
  
  <!-- 使用scroll-view替代页面滚动，防止iOS键盘弹出时视口偏移导致fixed元素消失 -->
  <!-- 编辑配置提示条 - 悬浮固定在操作栏下方 -->
  <view class="editing-config-bar" wx:if="{{isEditingConfig}}" style="top: {{navBarTop + navBarHeight + 6}}px; left: {{navBarRight}}px;" catchtouchmove="preventTouchMove">
    <view class="editing-config-content">
      <view class="editing-config-icon"></view>
      <text class="editing-config-label">正在编辑:</text>
      <input class="editing-config-input" 
             value="{{editingConfigName}}" 
             placeholder="配置名称"
             adjust-position="{{false}}"
             hold-keyboard="{{true}}"
             bindinput="onEditingConfigNameChange"
             bindfocus="onMarginInputFocus"
             bindblur="onEditingConfigNameBlur" />
    </view>
    <view class="editing-config-actions">
      <text class="editing-config-save" bindtap="saveConfig">保存</text>
      <text class="editing-config-cancel" bindtap="cancelEditingConfig">取消</text>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll" 
               scroll-top="{{contentScrollTop}}" 
               scroll-with-animation 
               bindscroll="onContentScroll" 
               enhanced 
               show-scrollbar="{{true}}">
  <view class="content-wrapper" style="padding-top: {{navBarTop + navBarHeight + (isEditingConfig ? 40 : 0)}}px;" bindtouchstart="onContentTouchStart">

  <!-- 卫星参数卡片 -->
  <view class="card">
    <view class="card-title">
      卫星参数
    </view>
    <view class="collapse-content {{satelliteParamsExpandState !== 'collapsed' ? 'show' : ''}}">
      <!-- 第一行：卫星选择 + 卫星名称 + 轨道位置 -->
      <view class="grid-3">
        <view class="form-group">
          <text class="form-label">选择卫星</text>
          <picker mode="selector" 
                  range="{{satellites}}" 
                  range-key="name"
                  value="{{satelliteIndex}}"
                  data-field="satellite"
                  bindchange="onSatellitePickerChange">
            <view class="form-picker">
              {{satellites[satelliteIndex].name}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">卫星名称 *</text>
          <input class="form-input" 
                 placeholder="请输入" 
                 value="{{satelliteParams.satelliteName}}"
                 data-field="satelliteName"
                 adjust-position="{{false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">轨道位置(°E) *</text>
          <input class="form-input" 
                 type="text"
                 placeholder="110.5" 
                 value="{{satelliteParams.orbitPosition}}"
                 data-field="orbitPosition"
                 adjust-position="{{false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>

      <!-- 第二行：频段 + SFD + 转发器带宽 + 输入回退 -->
      <view class="grid-4">
        <view class="form-group">
          <text class="form-label">工作频段 *</text>
          <picker mode="selector" 
                  range="{{frequencyBandOptions}}" 
                  range-key="label"
                  value="{{frequencyBandIndex}}"
                  data-field="frequencyBand"
                  bindchange="onSatellitePickerChange">
            <view class="form-picker">
              {{frequencyBandOptions[frequencyBandIndex].label || '请选择'}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">SFD(dBW/m²)</text>
          <input class="form-input" 
                 type="text"
                 placeholder="-84" 
                 value="{{satelliteParams.sfdRef}}"
                 data-field="sfdRef"
                 adjust-position="{{false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">转发器带宽(MHz)</text>
          <input class="form-input" 
                 type="text"
                 placeholder="36" 
                 value="{{satelliteParams.transponderBandwidth}}"
                 data-field="transponderBandwidth"
                 adjust-position="{{false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">输入回退(dB)</text>
          <input class="form-input" 
                 type="text"
                 placeholder="6" 
                 value="{{satelliteParams.BOi}}"
                 data-field="BOi"
                 adjust-position="{{false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>

      <!-- 第三行：输出回退（部分收起时隐藏以下内容） -->
      <view wx:if="{{satelliteParamsExpandState === 'full'}}">
        <view class="grid-4">
          <view class="form-group">
            <text class="form-label">输出回退(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="3" 
                   value="{{satelliteParams.BOo}}"
                   data-field="BOo"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">邻星离轴角(°)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="0" 
                   value="{{satelliteParams.deltaTheta}}"
                   data-field="deltaTheta"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">邻星上行C/I(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="25" 
                   value="{{satelliteParams.adjUplinkFactor}}"
                   data-field="adjUplinkFactor"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">邻星下行C/I(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="25" 
                   value="{{satelliteParams.adjDownlinkFactor}}"
                   data-field="adjDownlinkFactor"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <view class="grid-4">
          <view class="form-group">
            <text class="form-label">极化上行C/I(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="30" 
                   value="{{satelliteParams.xpolUplinkFactor}}"
                   data-field="xpolUplinkFactor"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">极化下行C/I(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="30" 
                   value="{{satelliteParams.xpolDownlinkFactor}}"
                   data-field="xpolDownlinkFactor"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">互调噪声C/I(dB)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="22" 
                   value="{{satelliteParams.intermodFactor}}"
                   data-field="intermodFactor"
                   adjust-position="{{false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <!-- 空白占位 -->
          </view>
        </view>
      </view>
      <!-- 部分收起结束 -->
    </view>
  </view>

  <!-- 发信站/收信站双栏布局 -->
  <view class="stations-dual-panel">
    <!-- 发信站 -->
    <view class="station-column">
      <view class="station-header">
        <view class="station-title">
          <text>发信站</text>
        </view>
      </view>
      
      <view class="collapse-content {{uplinkParamsExpandState !== 'collapsed' ? 'show' : ''}}">
        <!-- 城市选择 -->
        <view class="station-form-group city-selector-group">
          <text class="form-label">地面站位置</text>
          <view class="city-toggle-wrapper" bindtap="toggleCityDropdown" data-type="uplink">
            <text class="city-toggle-text">{{linkParams.earthStationLocation || '选择城市'}}</text>
            <text class="city-dropdown-icon">{{showUplinkCityDropdown ? '▲' : '▼'}}</text>
          </view>
          <view wx:if="{{showUplinkCityDropdown}}" class="city-dropdown show" catchtap="stopPropagation">
            <view class="city-search-wrapper">
              <view class="search-icon"></view>
              <input class="city-search-input" 
                     placeholder="" 
                     value="{{linkParams.earthStationLocation}}"
                     data-field="earthStationLocation"
                     adjust-position="{{false}}"
                     bindinput="onCityInput"
                     bindconfirm="onCityConfirm"
                     data-type="uplink" />
            </view>
            <view class="city-group">
              <scroll-view scroll-y class="city-list" style="max-height: 350px;">
                <view wx:for="{{filteredCities}}" 
                      wx:key="name" 
                      class="city-item"
                      data-city="{{item}}"
                      data-type="uplink"
                      bindtap="onCitySelect">
                  {{item.name}}
                </view>
                <view wx:if="{{filteredCities.length === 0}}" class="city-empty">无匹配</view>
              </scroll-view>
            </view>
          </view>
        </view>

        <!-- 经纬度 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">经度(°E)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="116.4" 
                   value="{{linkParams.longitude}}"
                   data-field="longitude"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">纬度(°N)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="39.9" 
                   value="{{linkParams.latitude}}"
                   data-field="latitude"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 天线参数 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">天线口径(m)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="6.2" 
                   value="{{linkParams.antennaDiameter}}"
                   data-field="antennaDiameter"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">天线效率(%)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="65" 
                   value="{{linkParams.antennaEfficiency}}"
                   data-field="antennaEfficiency"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 频率和极化 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">上行中心频率(GHz)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="14.25" 
                   value="{{linkParams.centerFrequency}}"
                   data-field="centerFrequency"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">极化方式</text>
            <picker mode="selector" 
                    range="{{polarizationOptions}}" 
                    range-key="label"
                    value="{{uplinkPolarizationIndex}}"
                    data-field="uplinkPolarization"
                    bindchange="onLinkPickerChange">
              <view class="form-picker">
                {{linkParams.uplinkPolarization || 'V'}}
              </view>
            </picker>
          </view>
        </view>

        <!-- 卫星G/T和可用度 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">卫星G/T(dB/K)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="2.0" 
                   value="{{linkParams.G_Ts}}"
                   data-field="G_Ts"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">可用度(%)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="99.90" 
                   value="{{linkParams.uplinkAvailability}}"
                   data-field="uplinkAvailability"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 展开更多参数 -->
        <view wx:if="{{uplinkParamsExpandState === 'full'}}">
          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">海拔(m)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="0" 
                     value="{{linkParams.altitude}}"
                     data-field="altitude"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="station-form-group">
              <text class="form-label">降雨率(mm/h)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="40" 
                     value="{{linkParams.rainRate}}"
                     data-field="rainRate"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">功放回退(dB)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="5" 
                     value="{{linkParams.paBackoff}}"
                     data-field="paBackoff"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="station-form-group">
              <text class="form-label">馈线损耗(dB)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="3.5" 
                     value="{{linkParams.feederLoss}}"
                     data-field="feederLoss"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">UPC</text>
              <picker mode="selector" 
                      range="{{upcOptions}}" 
                      range-key="label"
                      value="{{upcIndex}}"
                      data-field="uplinkPowerControl"
                      bindchange="onLinkPickerChange">
                <view class="form-picker">
                  {{linkParams.uplinkPowerControl || '否'}}
                </view>
              </picker>
            </view>
            <view class="station-form-group" wx:if="{{linkParams.uplinkPowerControl === '自定义'}}">
              <text class="form-label">UPC值(dB)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="3.0" 
                     value="{{linkParams.upcValue}}"
                     data-field="upcValue"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>
        </view>

        <!-- 实时结果 -->
        <view class="station-result">
          <view class="station-result-item">
            <text class="station-result-label">EIRP</text>
            <text class="station-result-value">{{realtimeParams.stationEIRP}} dBW</text>
          </view>
          <view class="station-result-item">
            <text class="station-result-label">建议功放</text>
            <text class="station-result-value">{{realtimeParams.paRecommendation}} W</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 收信站 -->
    <view class="station-column">
      <view class="station-header">
        <view class="station-title">
          <text>收信站</text>
        </view>
      </view>
      
      <view class="collapse-content {{downlinkParamsExpandState !== 'collapsed' ? 'show' : ''}}">
        <!-- 城市选择 -->
        <view class="station-form-group city-selector-group">
          <text class="form-label">地面站位置</text>
          <view class="city-toggle-wrapper" bindtap="toggleCityDropdown" data-type="downlink">
            <text class="city-toggle-text">{{linkParams.rxEarthStationLocation || '选择城市'}}</text>
            <text class="city-dropdown-icon">{{showDownlinkCityDropdown ? '▲' : '▼'}}</text>
          </view>
          <view wx:if="{{showDownlinkCityDropdown}}" class="city-dropdown show" catchtap="stopPropagation">
            <view class="city-search-wrapper">
              <view class="search-icon"></view>
              <input class="city-search-input" 
                     placeholder="" 
                     value="{{linkParams.rxEarthStationLocation}}"
                     data-field="rxEarthStationLocation"
                     adjust-position="{{false}}"
                     bindinput="onCityInput"
                     bindconfirm="onCityConfirm"
                     data-type="downlink" />
            </view>
            <view class="city-group">
              <scroll-view scroll-y class="city-list" style="max-height: 350px;">
                <view wx:for="{{filteredCitiesRx}}" 
                      wx:key="name" 
                      class="city-item"
                      data-city="{{item}}"
                      data-type="downlink"
                      bindtap="onCitySelect">
                  {{item.name}}
                </view>
                <view wx:if="{{filteredCitiesRx.length === 0}}" class="city-empty">无匹配</view>
              </scroll-view>
            </view>
          </view>
        </view>

        <!-- 经纬度 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">经度(°E)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="116.4" 
                   value="{{linkParams.rxLongitude}}"
                   data-field="rxLongitude"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">纬度(°N)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="39.9" 
                   value="{{linkParams.rxLatitude}}"
                   data-field="rxLatitude"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 天线参数 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">天线口径(m)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="3.7" 
                   value="{{linkParams.rxAntennaDiameter}}"
                   data-field="rxAntennaDiameter"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">天线效率(%)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="65" 
                   value="{{linkParams.rxAntennaEfficiency}}"
                   data-field="rxAntennaEfficiency"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 频率和极化 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">下行中心频率(GHz)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="12.5" 
                   value="{{linkParams.rxCenterFrequency}}"
                   data-field="rxCenterFrequency"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">极化方式</text>
            <picker mode="selector" 
                    range="{{polarizationOptions}}" 
                    range-key="label"
                    value="{{downlinkPolarizationIndex}}"
                    data-field="downlinkPolarization"
                    bindchange="onLinkPickerChange">
              <view class="form-picker">
                {{linkParams.downlinkPolarization || 'H'}}
              </view>
            </picker>
          </view>
        </view>

        <!-- 卫星EIRP和可用度 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">卫星EIRP(dBW)</text>
            <input class="form-input" 
                   type="text"
                   placeholder="46.0" 
                   value="{{linkParams.rxEIRP}}"
                   data-field="rxEIRP"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">可用度(%)</text>
            <input class="form-input" 
                   type="digit"
                   placeholder="99.90" 
                   value="{{linkParams.rxDownlinkAvailability}}"
                   data-field="rxDownlinkAvailability"
                   adjust-position="{{false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 展开更多参数 -->
        <view wx:if="{{downlinkParamsExpandState === 'full'}}">
          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">海拔(m)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="0" 
                     value="{{linkParams.rxAltitude}}"
                     data-field="rxAltitude"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="station-form-group">
              <text class="form-label">降雨率(mm/h)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="40" 
                     value="{{linkParams.rxRainRate}}"
                     data-field="rxRainRate"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">天线噪温(K)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="35" 
                     value="{{linkParams.rxAntennaNoiseTemp}}"
                     data-field="rxAntennaNoiseTemp"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="station-form-group">
              <text class="form-label">接收机噪温(K)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="75" 
                     value="{{linkParams.rxReceiverNoiseTemp}}"
                     data-field="rxReceiverNoiseTemp"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
          </view>

          <view class="station-grid-2">
            <view class="station-form-group">
              <text class="form-label">馈线损耗(dB)</text>
              <input class="form-input" 
                     type="text"
                     placeholder="0.2" 
                     value="{{linkParams.rxFeederLoss}}"
                     data-field="rxFeederLoss"
                     adjust-position="{{false}}"
                     bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
            </view>
            <view class="station-form-group">
              <!-- 空白占位 -->
            </view>
          </view>
        </view>

        <!-- 实时结果 -->
        <view class="station-result">
          <view class="station-result-item">
            <text class="station-result-label">G/T</text>
            <text class="station-result-value">{{realtimeParams.gOverTe}} dB/K</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 基带参数卡片 -->
  <view class="card">
    <view class="card-title">
      基带参数
    </view>
    <view class="collapse-content {{carrierParamsExpandState !== 'collapsed' ? 'show' : ''}}">
      <!-- 第一行：核心参数 4列 -->
      <view class="grid-4">
        <view class="form-group">
          <text class="form-label">信息速率(kbps)</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="2048" 
                 value="{{linkParams.infoRate}}"
                 data-field="infoRate"
                 adjust-position="{{false}}"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">调制方式</text>
          <picker mode="selector" 
                  range="{{modulationOptions}}" 
                  range-key="label"
                  value="{{modulationIndex}}"
                  data-field="modulation"
                  bindchange="onLinkPickerChange">
            <view class="form-picker">
              {{linkParams.modulation || '请选择'}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">FEC编码率</text>
          <input class="form-input" 
                 type="text"
                 placeholder="3/4" 
                 value="{{linkParams.fec}}"
                 data-field="fec"
                 adjust-position="{{false}}"
                 bindinput="onFecInput" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">{{noiseRatioMode === 'ebno' ? 'Eb/N₀' : 'Es/N₀'}}门限(dB)</text>
            <button class="toggle-btn-emoji" bindtap="toggleEbnoEsno">🔄</button>
          </view>
          <input class="form-input" 
                 type="text"
                 placeholder="5.50" 
                 value="{{linkParams.ebno}}"
                 data-field="ebno"
                 adjust-position="{{false}}"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>

      <!-- 第二行：扩展参数（完全展开时显示） -->
      <view class="grid-4" wx:if="{{carrierParamsExpandState === 'full'}}">
        <view class="form-group">
          <text class="form-label">RS编码率</text>
          <input class="form-input" 
                 type="text"
                 placeholder="188/204" 
                 value="{{linkParams.rsCode}}"
                 data-field="rsCode"
                 adjust-position="{{false}}"
                 bindinput="onRsCodeInput" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">误码率 (1×10⁻ⁿ)</text>
          <input class="form-input" 
                 type="text"
                 placeholder="7" 
                 value="{{linkParams.ber}}"
                 data-field="ber"
                 adjust-position="{{false}}"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">扩频增益</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="1.00" 
                 value="{{linkParams.m}}"
                 data-field="m"
                 adjust-position="{{false}}"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">滚降系数(1+α)</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="1.20" 
                 value="{{linkParams.bandwidthFactor}}"
                 data-field="bandwidthFactor"
                 adjust-position="{{false}}"
                 bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>
      
      <!-- 实时计算结果 -->
      <view class="station-result station-result-row">
        <view class="station-result-item">
          <text class="station-result-label">载波带宽</text>
          <text class="station-result-value">{{realtimeParams.carrierBandwidth}} kHz</text>
        </view>
        <view class="station-result-item station-result-editable">
          <text class="station-result-label">符号率</text>
          <input class="station-result-input" 
                 type="digit"
                 placeholder="--" 
                 value="{{realtimeParams.symbolRate}}"
                 adjust-position="{{false}}"
                 bindinput="onSymbolRateInput"
                 bindblur="onSymbolRateBlur"
                 bindfocus="onInputFocus"
                 selection-start="{{inputSelectAll ? 0 : -1}}"
                 selection-end="{{inputSelectAll ? 999 : -1}}" />
          <text class="station-result-unit">ksps</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 计算结果 -->
  <view id="result-section" class="card card-full-width" wx:if="{{hasResults}}">
    <view class="card-title">
      计算结果
    </view>
    
    <view class="collapse-content {{resultsExpandState !== 'collapsed' ? 'show' : ''}}">
    
    <!-- 核心结论区 - 置顶 -->
    <view class="core-results">
      <view class="core-results-grid">
        <view class="core-result-row">
          <text class="core-result-label">功放建议</text>
          <text class="core-result-value">{{results.paRecommendation}} W / {{results.paRecommendationdBResult}} dBW</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">链路余量</text>
          <text class="core-result-value">{{results.linkmargin}} dB</text>
        </view>
        <view class="core-result-row-with-bar">
          <view class="core-result-row">
            <text class="core-result-label">带宽占比</text>
            <text class="core-result-value {{results.bandwidthUsageRatio > 100 ? 'value-danger' : ''}}">{{results.bandwidthUsageRatio}}%</text>
          </view>
          <view class="core-ratio-bar">
            <view class="core-ratio-bar-fill {{results.bandwidthUsageRatio > 100 ? 'bar-danger' : results.bandwidthUsageRatio > 80 ? 'bar-warn' : 'bar-normal'}}" style="width: {{results.bandwidthUsageRatio > 100 ? 100 : results.bandwidthUsageRatio}}%"></view>
          </view>
        </view>
        <view class="core-result-row-with-bar">
          <view class="core-result-row">
            <text class="core-result-label">功率占比</text>
            <text class="core-result-value {{results.powerUsageRatio > 100 ? 'value-danger' : ''}}">{{results.powerUsageRatio}}%</text>
          </view>
          <view class="core-ratio-bar">
            <view class="core-ratio-bar-fill {{results.powerUsageRatio > 100 ? 'bar-danger' : results.powerUsageRatio > 80 ? 'bar-warn' : 'bar-normal'}}" style="width: {{results.powerUsageRatio > 100 ? 100 : results.powerUsageRatio}}%"></view>
          </view>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">载波带宽</text>
          <text class="core-result-value">{{results.allocBandwidthResult}} kHz</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">功率带宽</text>
          <text class="core-result-value">{{results.PowerBWResult}} kHz</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">载波总C/N</text>
          <text class="core-result-value">{{results.carrierTotalCN}} dB</text>
        </view>
        <view class="core-result-row">
          <text class="core-result-label">门限C/N</text>
          <text class="core-result-value">{{results.thresholdCN}} dB</text>
        </view>
      </view>
    </view>

    <!-- 完全展开时显示所有内容 -->
    <view wx:if="{{resultsExpandState === 'full'}}">
    <!-- 上行站结果 -->
    <view class="result-section">
      <view class="result-section-title">发信站参数</view>
      <view class="result-grid-2">
        <view class="result-item {{markedParams.indexOf('earthAntennaDiameterResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthAntennaDiameterResult">
          <text class="result-label">地球站天线口径</text>
          <text class="result-value">{{results.earthAntennaDiameterResult}} 米</text>
        </view>
        <view class="result-item {{markedParams.indexOf('earthLongitudeResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthLongitudeResult">
          <text class="result-label">地球站经度</text>
          <text class="result-value">{{results.earthLongitudeResult}}°E</text>
        </view>
        <view class="result-item {{markedParams.indexOf('earthLatitudeResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthLatitudeResult">
          <text class="result-label">地球站纬度</text>
          <text class="result-value">{{results.earthLatitudeResult}}°N</text>
        </view>
        <view class="result-item {{markedParams.indexOf('uplinkPolarizationResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="uplinkPolarizationResult">
          <text class="result-label">极化方式</text>
          <text class="result-value">{{results.uplinkPolarizationResult}}</text>
        </view>
        <view class="result-item {{markedParams.indexOf('elevationResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="elevationResult">
          <text class="result-label">对卫星仰角</text>
          <text class="result-value">{{results.elevationResult}}°</text>
        </view>
        <view class="result-item {{markedParams.indexOf('azimuthResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="azimuthResult">
          <text class="result-label">对卫星方位角</text>
          <text class="result-value">{{results.azimuthResult}}°</text>
        </view>
        <view class="result-item {{markedParams.indexOf('uplinkPolarizationAngleResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="uplinkPolarizationAngleResult">
          <text class="result-label">对卫星极化角</text>
          <text class="result-value">{{results.uplinkPolarizationAngleResult}}{{results.uplinkPolarizationAngleResult !== '-' ? '°' : ''}}</text>
        </view>
        <view class="result-item {{markedParams.indexOf('earthAntennaEfficiencyResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="earthAntennaEfficiencyResult">
          <text class="result-label">天线效率</text>
          <text class="result-value">{{results.earthAntennaEfficiencyResult}}%</text>
        </view>
        <view class="result-item {{markedParams.indexOf('wavelengthResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="wavelengthResult">
          <text class="result-label">波长</text>
          <text class="result-value">{{results.wavelengthResult}} m</text>
        </view>
        <view class="result-item {{markedParams.indexOf('beamWidthResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="beamWidthResult">
          <text class="result-label">3dB波束宽度</text>
          <text class="result-value">{{results.beamWidthResult}}°</text>
        </view>
        <view class="result-item {{markedParams.indexOf('stationEIRPResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="stationEIRPResult">
          <text class="result-label">地球站EIRP</text>
          <text class="result-value">{{results.stationEIRPResult}} dBW</text>
        </view>
        <view class="result-item {{markedParams.indexOf('txAntennaGainResult') > -1 ? 'result-item-marked' : ''}}" 
              bindtap="toggleHighlight" 
              data-param="txAntennaGainResult">
          <text class="result-label">发射天线增益</text>
