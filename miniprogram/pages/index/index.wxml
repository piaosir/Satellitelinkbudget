<!--index.wxml-->
<wxs module="utils">
  function includes(arr, val) {
    if (!arr || !arr.length) return false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === val) return true;
    }
    return false;
  }
  function indexOf(arr, val) {
    if (!arr || !arr.length) return -1;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] === val) return i;
    }
    return -1;
  }
  module.exports = { includes: includes, indexOf: indexOf };
</wxs>
<view class="container {{isNotIOS ? 'non-ios' : ''}}">
  <!-- 悬浮顶部操作栏 -->
  <view class="floating-action-bar" style="top: {{navBarTop}}px; height: {{navBarHeight}}px; left: {{navBarRight}}px;" catchtouchmove="preventTouchMove">
    <!-- 开始计算按钮 -->
    <view class="float-btn float-btn-primary" bindtap="onStartCalculate">
      <view class="float-icon icon-play"></view>
    </view>
    
    <!-- 余量/正向计算合并按钮 -->
    <view class="float-btn float-btn-margin" bindtap="showMarginPanel">
      <text class="float-margin-value">{{calcMode === 'forward' ? (inputPaPower || 'PA') : marginValue}}</text>
      <text class="float-margin-unit">{{calcMode === 'forward' ? 'W' : 'dB'}}</text>
    </view>
    
    <!-- 历史记录按钮 -->
    <view class="float-btn" bindtap="toggleHistoryPanel">
      <view class="float-icon icon-history"></view>
    </view>
    
    <!-- 配置管理按钮 -->
    <view class="float-btn" bindtap="showConfigMenu">
      <view class="float-icon icon-settings"></view>
    </view>
    
    <!-- 可视化按钮 -->
    <view class="float-btn float-btn-ar" bindtap="showVisualPanel">
      <view class="float-icon icon-visual"></view>
    </view>
  </view>

  <!-- 可视化功能选择面板 -->
  <view class="visual-popup {{showVisualPopup ? 'show' : ''}}" wx:if="{{showVisualPopup}}" catchtouchmove="preventTouchMove">
    <view class="visual-popup-header">
      <text class="visual-popup-title">工具栏</text>
      <text class="visual-popup-close" bindtap="hideVisualPanel">✕</text>
    </view>
    <view class="visual-popup-body">
      <view class="visual-option" bindtap="goToARAlign">
        <view class="visual-option-icon">
          <view class="option-icon icon-ar-satellite"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">AR对星</text>
          <text class="visual-option-desc">使用增强现实辅助天线对星</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToCoverageMap">
        <view class="visual-option-icon">
          <view class="option-icon icon-coverage-cn"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">卫星覆盖</text>
          <text class="visual-option-desc">查看当前卫星的覆盖范围</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToISLVisual">
        <view class="visual-option-icon">
          <view class="option-icon icon-isl"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">星间链路分析</text>
          <text class="visual-option-desc">两星链路几何与最大链路长度</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToConstellationMap">
        <view class="visual-option-icon">
          <view class="option-icon icon-coverage"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">星座地图</text>
          <text class="visual-option-desc">3D地球查看各星座实时星位</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="showAzElToolPanel">
        <view class="visual-option-icon">
          <view class="option-icon icon-az-el"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">方位仰角工具</text>
          <text class="visual-option-desc">填坐标或地图选点，选择卫星后输出结论</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="showSunOutagePanel">
        <view class="visual-option-icon">
          <view class="option-icon icon-sun-outage"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">日凌计算</text>
          <text class="visual-option-desc">计算太阳干扰中断时间窗口</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToFreqPlan">
        <view class="visual-option-icon">
          <view class="option-icon icon-freq-plan"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">频率计划</text>
          <text class="visual-option-desc">查看从仿真平台导入的转发器频率计划</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
      <view class="visual-option" bindtap="goToSettings">
        <view class="visual-option-icon">
          <view class="option-icon icon-satsim-bind"></view>
        </view>
        <view class="visual-option-content">
          <text class="visual-option-title">仿真平台绑定</text>
          <text class="visual-option-desc">绑定电脑上的仿真平台，发来的内容自动同步</text>
        </view>
        <view class="visual-option-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 方位仰角工具弹层 -->
  <view class="azel-popup {{showAzElToolPopup ? 'show' : ''}}" wx:if="{{showAzElToolPopup}}" catchtouchmove="preventTouchMove">
    <view class="azel-popup-header">
      <text class="azel-popup-title">方位仰角工具</text>
      <text class="azel-popup-close" bindtap="hideAzElToolPanel">✕</text>
    </view>
    <view class="azel-popup-body">
      <view class="azel-row">
        <text class="azel-label">卫星</text>
        <view class="azel-sat-toggle">
          <picker wx:if="{{!azElUseCustom}}" mode="selector"
                  range="{{satellites}}"
                  range-key="displayName"
                  value="{{azElSatelliteIndex}}"
                  bindchange="onAzElSatelliteChange"
                  class="azel-picker-flex">
            <view class="azel-picker">{{satellites[azElSatelliteIndex].displayName}}</view>
          </picker>
          <input wx:if="{{azElUseCustom}}" class="azel-input"
                 type="digit"
                 placeholder="输入轨道位置(°E)"
                 value="{{azElCustomPosition}}"
                 bindinput="onAzElCustomPositionInput" />
          <text class="azel-toggle-link" bindtap="toggleAzElCustomMode">{{azElUseCustom ? '选择' : '自定义'}}</text>
        </view>
      </view>
      <view class="azel-row">
        <text class="azel-label">纬度</text>
        <input class="azel-input"
               type="text"
               placeholder="例如 39.9042"
               value="{{azElLatitude}}"
               bindinput="onAzElLatitudeInput" />
      </view>
      <view class="azel-row">
        <text class="azel-label">经度</text>
        <input class="azel-input"
               type="text"
               placeholder="例如 116.4074"
               value="{{azElLongitude}}"
               bindinput="onAzElLongitudeInput" />
      </view>
      <view class="azel-actions">
        <view class="azel-btn azel-btn-map" bindtap="goToMapPickForAzEl">
          <text>地图选点</text>
        </view>
        <view class="azel-btn azel-btn-locate" bindtap="useMyLocationForAzEl">
          <text>我的位置</text>
        </view>
      </view>
      <view class="azel-actions azel-actions-bottom">
        <view class="azel-btn azel-btn-calc" bindtap="calculateAzElConclusion">
          <text>计算</text>
        </view>
      </view>
      <view class="azel-result" wx:if="{{azElResultReady}}">
        <view class="azel-result-head {{azElConclusionLevel}}">{{azElConclusionTitle}}</view>
        <!-- 方位角/仰角核心结论 -->
        <view class="azel-result-highlight">
          <view class="azel-highlight-item">
            <text class="azel-highlight-label">方位角</text>
            <text class="azel-highlight-value">{{azElAzimuth}}°</text>
          </view>
          <view class="azel-highlight-item">
            <text class="azel-highlight-label">仰角</text>
            <text class="azel-highlight-value {{azElConclusionLevel}}">{{azElElevation}}°</text>
          </view>
        </view>
        <text class="azel-result-line">经纬度: {{azElInputLatitude}}, {{azElInputLongitude}}</text>
        <text class="azel-result-line">卫星名称: {{azElSatelliteName}}</text>
        <text class="azel-result-line">轨道位置: {{azElSatelliteOrbit}}</text>
        <text class="azel-result-line">建议: {{azElSuggestion}}</text>
        <text class="azel-result-line">方位角怎么找: {{azElAzimuthGuide}}</text>
        <text class="azel-result-line">仰角怎么找: {{azElElevationGuide}}</text>
      </view>
    </view>
  </view>

  <!-- 方位仰角工具遮罩 -->
  <view class="azel-popup-mask {{showAzElToolPopup ? 'show' : ''}}" wx:if="{{showAzElToolPopup}}" bindtap="hideAzElToolPanel" catchtouchmove="preventTouchMove"></view>

  <!-- 日凌计算工具弹层 -->
  <view class="azel-popup sunoutage-popup {{showSunOutagePopup ? 'show' : ''}}" wx:if="{{showSunOutagePopup}}" catchtouchmove="preventTouchMove">
    <view class="azel-popup-header">
      <text class="azel-popup-title">日凌时间计算</text>
      <text class="azel-popup-close" bindtap="hideSunOutagePanel">✕</text>
    </view>
    <scroll-view scroll-y class="sunoutage-scroll-body">
    <view class="azel-popup-body so-form">
      <!-- 卫星选择 -->
      <view class="so-field">
        <text class="so-field-label">卫星</text>
        <view class="so-sat-toggle">
          <picker wx:if="{{!sunOutageUseCustom}}" mode="selector"
                  range="{{satellites}}"
                  range-key="displayName"
                  value="{{sunOutageSatelliteIndex}}"
                  bindchange="onSunOutageSatelliteChange"
                  class="so-field-picker-wrap">
            <view class="so-field-picker">
              <text>{{satellites[sunOutageSatelliteIndex].displayName}}</text>
            </view>
          </picker>
          <input wx:if="{{sunOutageUseCustom}}" class="so-field-input so-field-input-custom"
                 type="digit"
                 placeholder="输入轨道位置(°E)"
                 value="{{sunOutageCustomPosition}}"
                 bindinput="onSunOutageCustomPositionInput" />
          <text class="azel-toggle-link" bindtap="toggleSunOutageCustomMode">{{sunOutageUseCustom ? '选择' : '自定义'}}</text>
        </view>
      </view>
      <!-- 经纬度 -->
      <view class="so-field-row-2col">
        <view class="so-field so-field-half">
          <text class="so-field-label">纬度<text class="form-label-unit">(°N)</text></text>
          <input class="so-field-input"
                 type="text"
                 placeholder="39.9042"
                 value="{{sunOutageLatitude}}"
                 bindinput="onSunOutageLatInput" />
        </view>
        <view class="so-field so-field-half">
          <text class="so-field-label">经度<text class="form-label-unit">(°E)</text></text>
          <input class="so-field-input"
                 type="text"
                 placeholder="116.4074"
                 value="{{sunOutageLongitude}}"
                 bindinput="onSunOutageLonInput" />
        </view>
      </view>
      <!-- 位置按钮 -->
      <view class="so-loc-btns">
        <view class="so-loc-btn" bindtap="goToMapPickForSunOutage">
          <text>地图选点</text>
        </view>
        <view class="so-loc-btn" bindtap="useMyLocationForSunOutage">
          <text>我的位置</text>
        </view>
      </view>
      <!-- 天线口径 -->
      <view class="so-field">
        <text class="so-field-label">天线口径<text class="form-label-unit">(m)</text></text>
        <input class="so-field-input"
               type="text"
               placeholder="3.0"
               value="{{sunOutageDiameter}}"
               bindinput="onSunOutageDiameterInput" />
      </view>
      <!-- 年份 + 季节 -->
      <view class="so-field-row-2col">
        <view class="so-field so-field-half">
          <text class="so-field-label">年份</text>
          <input class="so-field-input"
                 type="number"
                 placeholder="{{sunOutageYear}}"
                 value="{{sunOutageYear}}"
                 bindinput="onSunOutageYearInput" />
        </view>
        <view class="so-field so-field-half">
          <text class="so-field-label">季节</text>
          <picker mode="selector"
                  range="{{sunOutageSeasons}}"
                  value="{{sunOutageSeasonIndex}}"
                  bindchange="onSunOutageSeasonChange"
                  class="so-field-picker-wrap">
            <view class="so-field-picker">
              <text>{{sunOutageSeasons[sunOutageSeasonIndex]}}</text>
            </view>
          </picker>
        </view>
      </view>
      <!-- 下行频段 -->
      <view class="so-field">
        <text class="so-field-label">下行频段</text>
        <picker mode="selector"
                range="{{sunOutageBands}}"
                value="{{sunOutageBandIndex}}"
                bindchange="onSunOutageBandChange"
                class="so-field-picker-wrap">
          <view class="so-field-picker">
            <text>{{sunOutageBands[sunOutageBandIndex]}}</text>
          </view>
        </picker>
      </view>
      <!-- 自定义频率 -->
      <view class="so-field" wx:if="{{sunOutageShowCustomFreq}}">
        <text class="so-field-label">下行频率<text class="form-label-unit">(GHz)</text></text>
        <input class="so-field-input"
               type="text"
               placeholder="输入频率"
               value="{{sunOutageCustomFreq}}"
               bindinput="onSunOutageCustomFreqInput" />
      </view>
      <view class="so-freq-link" bindtap="toggleSunOutageCustomFreq">
        <text>{{sunOutageShowCustomFreq ? '使用默认频率' : '自定义下行频率'}}</text>
      </view>
      <!-- 计算按钮 -->
      <view class="so-calc-btn {{sunOutageCalculating ? 'btn-disabled' : ''}}" bindtap="calculateSunOutage">
        <text>{{sunOutageCalculating ? '计算中...' : '开始计算'}}</text>
      </view>
      <!-- 结果区域 -->
      <view class="sunoutage-result" wx:if="{{sunOutageResultReady && sunOutageResult}}">
        <!-- 报告题头：规则线标题 + 时区切换 -->
        <view class="so-report-head">
          <text class="so-report-title">计算结果</text>
          <view class="sunoutage-time-switch" wx:if="{{sunOutageResult.totalDays > 0}}" bindtap="toggleSunOutageTimeMode">
            <text class="sunoutage-time-opt {{sunOutageTimeMode === 'bjt' ? 'active' : ''}}">BJT</text>
            <text class="sunoutage-time-opt {{sunOutageTimeMode === 'gmt' ? 'active' : ''}}">GMT</text>
          </view>
        </view>
        <!-- 结论句 -->
        <text class="so-report-conclusion {{sunOutageResult.totalDays > 0 ? 'warn' : 'ok'}}">{{sunOutageResult.totalDays > 0 ? '存在日凌影响' : '无日凌影响'}}</text>
        <view class="sunoutage-result-summary">
          <!-- 参数与结论：标签-数值对齐行 -->
          <view class="so-sum-grid">
            <view class="so-sum-row">
              <text class="so-sum-label">卫星</text>
              <text class="so-sum-value">{{sunOutageResult.satName}}（{{sunOutageResult.satLonDisplay}}°E）</text>
            </view>
            <view class="so-sum-row">
              <text class="so-sum-label">方位 / 仰角</text>
              <text class="so-sum-value">{{sunOutageResult.satAz}}° / {{sunOutageResult.satEl}}°</text>
            </view>
            <view class="so-sum-row">
              <text class="so-sum-label">地球站</text>
              <text class="so-sum-value">{{sunOutageResult.stationLat}}°N, {{sunOutageResult.stationLon}}°E</text>
            </view>
            <view class="so-sum-row">
              <text class="so-sum-label">口径 / 频率</text>
              <text class="so-sum-value">{{sunOutageResult.antennaD}} m / {{sunOutageResult.frequency}} GHz</text>
            </view>
            <view class="so-sum-row" wx:if="{{sunOutageResult.totalDays > 0}}">
              <text class="so-sum-label">影响期</text>
              <text class="so-sum-value">{{sunOutageResult.startDate}} ~ {{sunOutageResult.endDate}}（{{sunOutageResult.totalDays}}天）</text>
            </view>
            <view class="so-sum-row" wx:if="{{sunOutageResult.peakRecord}}">
              <text class="so-sum-label">最长中断</text>
              <text class="so-sum-value">{{sunOutageResult.maxDurationStr}}</text>
            </view>
            <view class="so-sum-row" wx:if="{{sunOutageResult.peakRecord}}">
              <text class="so-sum-label">峰值时刻（{{sunOutageTimeMode === 'bjt' ? 'BJT' : 'GMT'}}）</text>
              <text class="so-sum-value">{{sunOutageResult.peakRecord.date}} {{sunOutageTimeMode === 'bjt' ? sunOutageResult.peakRecord.peakTimeBJT : sunOutageResult.peakRecord.peakTimeUTC}}</text>
            </view>
          </view>
        </view>
        <!-- 逐日详情（常显三线表） -->
        <view class="so-table-caption" wx:if="{{sunOutageResult.dailyResults.length > 0}}">逐日详情</view>
        <view class="sunoutage-detail-list" wx:if="{{sunOutageResult.dailyResults.length > 0}}">
          <view class="sunoutage-detail-header">
            <text class="so-col so-col-date">日期</text>
            <text class="so-col so-col-time">开始</text>
            <text class="so-col so-col-time">峰值</text>
            <text class="so-col so-col-time">结束</text>
            <text class="so-col so-col-dur">时长</text>
            <text class="so-col so-col-cn">强度</text>
          </view>
          <view class="sunoutage-detail-row {{item.isPeak ? 'peak-row' : ''}}" wx:for="{{sunOutageResult.dailyResults}}" wx:key="date">
            <text class="so-col so-col-date">{{item.date}}</text>
            <text class="so-col so-col-time">{{sunOutageTimeMode === 'bjt' ? item.startTimeBJT : item.startTimeUTC}}</text>
            <text class="so-col so-col-time">{{sunOutageTimeMode === 'bjt' ? item.peakTimeBJT : item.peakTimeUTC}}</text>
            <text class="so-col so-col-time">{{sunOutageTimeMode === 'bjt' ? item.endTimeBJT : item.endTimeUTC}}</text>
            <text class="so-col so-col-dur">{{item.durationStr}}</text>
            <text class="so-col so-col-cn {{item.intensityClass}}">{{item.intensity}}</text>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>
  </view>

  <!-- 日凌计算工具遮罩 -->
  <view class="azel-popup-mask {{showSunOutagePopup ? 'show' : ''}}" wx:if="{{showSunOutagePopup}}" bindtap="hideSunOutagePanel" catchtouchmove="preventTouchMove"></view>

  <!-- 可视化面板遮罩 -->
  <view class="visual-popup-mask {{showVisualPopup ? 'show' : ''}}" wx:if="{{showVisualPopup}}" bindtap="hideVisualPanel" catchtouchmove="preventTouchMove"></view>

  <!-- 余量/正向计算弹出面板 -->
  <view class="margin-popup {{showMarginPopup ? 'show' : ''}}" wx:if="{{showMarginPopup}}" style="top: {{navBarTop + navBarHeight + 4}}px; left: {{navBarRight}}px;" catchtouchmove="preventTouchMove">
    <view class="margin-popup-header">
      <view class="margin-mode-tabs">
        <view class="margin-mode-tab {{calcMode === 'reverse' ? 'active' : ''}}" bindtap="setCalcMode" data-mode="reverse">
          <text>反向计算</text>
        </view>
        <view class="margin-mode-tab {{calcMode === 'forward' ? 'active' : ''}}" bindtap="setCalcMode" data-mode="forward">
          <text>正向计算</text>
        </view>
      </view>
      <text class="margin-popup-close" bindtap="hideMarginPanel">✕</text>
    </view>
    
    <!-- 反向模式：输入余量 -->
    <view class="margin-popup-body" wx:if="{{calcMode === 'reverse'}}">
      <view class="margin-popup-row">
        <text class="margin-popup-label">目标余量</text>
        <input class="margin-popup-input" 
               type="text"
               placeholder="3.00" 
               value="{{marginValue}}"
               adjust-position="{{isNotIOS}}"
               hold-keyboard="{{true}}"
               bindinput="onMarginInput" bindfocus="onMarginInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        <text class="margin-popup-unit">dB</text>
        <view class="margin-popup-balance" bindtap="autoBalanceMargin">
          <text>平衡</text>
        </view>
        <view class="margin-popup-calc" bindtap="calculateLink">
          <text>计算</text>
        </view>
      </view>
      <view class="margin-popup-hint">
        <text>输入目标余量后点击计算，或点击平衡自动计算功带平衡余量</text>
      </view>
    </view>
    
    <!-- 正向模式：输入功放功率 -->
    <view class="margin-popup-body" wx:else>
      <view class="margin-popup-row">
        <text class="margin-popup-label">功放功率</text>
        <input class="margin-popup-input" 
               type="text"
               placeholder="400" 
               value="{{inputPaPower}}"
               adjust-position="{{isNotIOS}}"
               hold-keyboard="{{true}}"
               bindinput="onPaPowerInput" bindfocus="onMarginInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        <text class="margin-popup-unit">W</text>
        <view class="margin-popup-calc {{isForwardCalculating ? 'loading' : ''}}" bindtap="forwardCalculate">
          <text>{{isForwardCalculating ? '...' : '反推'}}</text>
        </view>
      </view>
      <view class="margin-popup-hint">
        <text>输入功放功率，反推可达余量</text>
      </view>
    </view>
  </view>
  
  <!-- 余量面板为非模态：无遮罩，页面可正常滚动，点击内容区或✕关闭 -->

  <!-- 历史记录面板 -->
  <view class="history-panel {{showHistoryPanel ? 'show' : ''}}" style="top: {{navBarTop + navBarHeight + 8}}px; height: calc(100vh - {{navBarTop + navBarHeight + 8}}px);">
    <view class="history-header">
      <text class="history-title">{{historySelectMode ? '已选择 ' + selectedHistoryIds.length + ' 条' : '最近计算记录'}}</text>
      <view class="history-actions">
        <text class="history-select-btn {{historySelectMode ? 'active' : ''}}" bindtap="toggleHistorySelectMode" wx:if="{{historyRecords.length > 0}}">{{historySelectMode ? '取消' : '多选'}}</text>
        <text class="history-export-btn history-export-btn-word" bindtap="exportHistoryWord" wx:if="{{historySelectMode && selectedHistoryIds.length > 0}}">Word</text>
        <text class="history-export-btn history-export-btn-excel" bindtap="exportHistoryExcel" wx:if="{{historySelectMode && selectedHistoryIds.length > 0}}">Excel</text>
        <text class="history-export-btn history-export-btn-pdf" bindtap="exportHistoryPDF" wx:if="{{historySelectMode && selectedHistoryIds.length > 0}}">PDF</text>
        <text class="history-clear" bindtap="clearAllHistory" wx:if="{{historyRecords.length > 0 && !historySelectMode}}">清空</text>
        <text class="history-close" bindtap="toggleHistoryPanel">✕</text>
      </view>
    </view>
    <scroll-view scroll-y class="history-list" enhanced show-scrollbar="{{false}}" wx:if="{{historyRecords.length > 0}}">
      <view class="history-item-wrapper {{utils.includes(selectedHistoryIds, item.id) ? 'selected' : ''}}" wx:for="{{historyRecords}}" wx:key="id"
        bindtap="{{historySelectMode ? 'toggleHistorySelection' : ''}}"
        data-id="{{item.id}}">
        <!-- 多选指示器 -->
        <view class="history-select-indicator {{utils.includes(selectedHistoryIds, item.id) ? 'checked' : ''}}" wx:if="{{historySelectMode}}">
          <view class="history-select-checkbox">
            <text class="history-select-order">{{index + 1}}</text>
          </view>
        </view>
        <view class="history-item-content {{item.animating ? 'animating' : ''}} {{historySelectMode ? 'select-mode' : ''}}" 
              style="transform: translateX({{historySelectMode ? 0 : (item.offsetX || 0)}}px);"
              bindtouchstart="{{historySelectMode ? '' : 'onHistoryTouchStart'}}"
              bindtouchmove="{{historySelectMode ? '' : 'onHistoryTouchMove'}}"
              bindtouchend="{{historySelectMode ? '' : 'onHistoryTouchEnd'}}"
              data-id="{{item.id}}">
          <view class="history-item-main" catchtap="{{historySelectMode ? '' : 'loadHistoryRecord'}}" data-id="{{item.id}}">
            <view class="history-item-header">
              <text class="history-satellite">{{index + 1}}. {{item.satelliteName}}</text>
              <view class="history-header-right">
                <text class="orbit-tag {{item.orbitType === 'NGSO' ? 'orbit-tag-ngso orbit-tag-' + (item.ngsoOrbitClass || 'LEO') : 'orbit-tag-geo'}}">{{item.orbitType === 'NGSO' ? (item.ngsoOrbitClass || 'LEO') : 'GEO'}}</text>
                <text class="history-time">{{item.time}}</text>
              </view>
            </view>
            <view class="history-item-body">
              <text class="history-info">{{item.txLocation}} → {{item.rxLocation}}</text>
              <text class="history-params">{{item.frequencyBand}} | {{item.infoRate}}kbps | {{item.modulation}}</text>
              <view class="history-results-row" wx:if="{{item.linkmargin}}">
                <text class="history-rc" wx:if="{{item.calcMode === 'forward'}}">PA {{item.inputPaPower}}W</text>
                <text class="history-rc" wx:else>功放 {{item.paRecommendation}}W</text>
                <text class="history-rc-sep">·</text>
                <text class="history-rc" wx:if="{{item.calcMode === 'forward'}}">余量 {{item.linkmargin}}dB</text>
                <text class="history-rc" wx:else>目标余量 {{item.margin}}dB</text>
                <text class="history-rc-sep">·</text>
                <text class="history-rc">C/N {{item.carrierTotalCN}}dB</text>
                <text class="history-rc-sep">·</text>
                <text class="history-rc">带宽 {{item.bandwidthPct}}%</text>
                <text class="history-rc-sep">·</text>
                <text class="history-rc">功率 {{item.powerPct}}%</text>
              </view>
              <text class="history-result" wx:else>功放: {{item.paRecommendation}}W</text>
            </view>
          </view>
        </view>
        <view class="history-item-actions-bg" wx:if="{{!historySelectMode}}">
          <view class="history-action-save" catchtap="saveHistoryToConfig" data-id="{{item.id}}">
            <text>收藏</text>
          </view>
          <view class="history-action-delete" catchtap="deleteHistoryRecord" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="history-empty" wx:else>
      <text class="history-empty-icon">📋</text>
      <text class="history-empty-text">暂无历史记录</text>
      <text class="history-empty-hint">完成一次计算后将自动保存</text>
    </view>
  </view>

  <!-- 历史面板遮罩 -->
  <view class="history-mask {{showHistoryPanel ? 'show' : ''}}" bindtap="toggleHistoryPanel" catchtouchmove="preventTouchMove"></view>
  
  <!-- 使用scroll-view替代页面滚动，防止iOS键盘弹出时视口偏移导致fixed元素消失 -->
  <!-- 编辑配置提示条 - 悬浮固定在操作栏下方 -->
  <view class="editing-config-bar" wx:if="{{isEditingConfig}}" style="top: {{navBarTop + navBarHeight + 6}}px; left: {{navBarRight}}px;" catchtouchmove="preventTouchMove">
    <view class="editing-config-content">
      <view class="editing-config-icon"></view>
      <text class="editing-config-label">正在编辑:</text>
      <input class="editing-config-input" 
             value="{{editingConfigName}}" 
             placeholder="配置名称"
             adjust-position="{{isNotIOS}}"
             hold-keyboard="{{true}}"
             bindinput="onEditingConfigNameChange"
             bindfocus="onMarginInputFocus"
             bindblur="onEditingConfigNameBlur" />
    </view>
    <view class="editing-config-actions">
      <text class="editing-config-save" bindtap="saveConfig">保存</text>
      <text class="editing-config-cancel" bindtap="cancelEditingConfig">取消</text>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll"
               scroll-top="{{contentScrollTop}}"
               scroll-with-animation
               bindscroll="onContentScroll"
               binddragstart="onContentDragStart"
               enhanced
               show-scrollbar="{{true}}">
  <view class="content-wrapper" style="padding-top: {{navBarTop + navBarHeight + (isEditingConfig ? 40 : 0)}}px;" bindtouchstart="onContentTouchStart" bindtap="onContentTap">

  <!-- 卫星参数卡片 -->
  <view class="card">
    <view class="card-title card-title-satellite">
      <text class="sat-title-text">{{orbitType === 'NGSO' ? '非地球静止轨道卫星' : '地球静止轨道卫星'}}</text>
      <view class="orbit-seg">
        <view class="orbit-seg-item {{orbitType === 'GEO' ? 'active' : ''}}" data-type="GEO" bindtap="onOrbitTypeChange">GEO</view>
        <view class="orbit-seg-item {{orbitType === 'NGSO' ? 'active' : ''}}" data-type="NGSO" bindtap="onOrbitTypeChange">NGSO</view>
      </view>
    </view>
    <view class="collapse-content show">
      <!-- 第一行：卫星选择 + 卫星名称 + 轨道位置（GEO）；卫星名称 + 轨道倾角（NGSO） -->
      <view class="grid-3" wx:if="{{orbitType !== 'NGSO'}}">
        <view class="form-group">
          <text class="form-label">选择卫星</text>
          <picker mode="selector" 
                  range="{{satellites}}" 
                  range-key="name"
                  value="{{satelliteIndex}}"
                  data-field="satellite"
                  bindchange="onSatellitePickerChange">
            <view class="form-picker">
              {{satellites[satelliteIndex].name}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">卫星名称<text class="required-mark"> *</text></text>
          <input class="form-input {{focusedField === 'satelliteName' ? 'input-focused' : ''}}" 
                 placeholder="请输入" 
                 value="{{satelliteParams.satelliteName}}"
                 data-field="satelliteName"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">轨道位置<text class="form-label-unit">(°E)</text><text class="required-mark"> *</text></text>
          <input class="form-input {{focusedField === 'orbitPosition' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="110.5" 
                 value="{{satelliteParams.orbitPosition}}"
                 data-field="orbitPosition"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>
      </view>

      <!-- NGSO 首行：卫星名称 + 轨道倾角 -->
      <view class="grid-2" wx:if="{{orbitType === 'NGSO'}}">
        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">卫星名称<text class="required-mark"> *</text></text>
          </view>
          <input class="form-input {{focusedField === 'satelliteName' ? 'input-focused' : ''}}"
                 placeholder="请输入"
                 value="{{satelliteParams.satelliteName}}"
                 data-field="satelliteName"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <view class="form-label-row">
            <text class="form-label">轨道倾角<text class="form-label-unit">(°)</text></text>
          </view>
          <input class="form-input {{focusedField === 'orbitInclination' ? 'input-focused' : ''}}"
                 type="digit"
                 placeholder="50"
                 value="{{satelliteParams.orbitInclination}}"
                 data-field="orbitInclination"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

      </view>

      <!-- 第二行：频段 + SFD + 转发器带宽 + 转发器IBO -->
      <view class="grid-4">
        <!-- NGSO 专属：轨道类型（LEO/MEO/HEO），选择后自动填入典型轨道高度/斜距 -->
        <view class="form-group" wx:if="{{orbitType === 'NGSO'}}">
          <text class="form-label">轨道类型</text>
          <picker mode="selector"
                  range="{{ngsoOrbitClassOptions}}"
                  range-key="label"
                  value="{{ngsoOrbitClassIndex}}"
                  bindchange="onNgsoOrbitClassChange">
            <view class="form-picker">
              {{ngsoOrbitClassOptions[ngsoOrbitClassIndex].label}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">工作频段<text class="required-mark"> *</text></text>
          <picker mode="selector" 
                  range="{{frequencyBandOptions}}" 
                  range-key="label"
                  value="{{frequencyBandIndex}}"
                  data-field="frequencyBand"
                  bindchange="onSatellitePickerChange">
            <view class="form-picker">
              {{frequencyBandOptions[frequencyBandIndex].label || '请选择'}}
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">SFD<text class="form-label-unit">(dBW/m²)</text></text>
          <input class="form-input {{focusedField === 'sfdRef' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="-84" 
                 value="{{satelliteParams.sfdRef}}"
                 data-field="sfdRef"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">Tpdr.带宽<text class="form-label-unit">(MHz)</text></text>
          <input class="form-input {{focusedField === 'transponderBandwidth' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="36" 
                 value="{{satelliteParams.transponderBandwidth}}"
                 data-field="transponderBandwidth"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group" wx:if="{{orbitType !== 'NGSO'}}">
          <text class="form-label">邻星离轴角<text class="form-label-unit">(°)</text></text>
          <input class="form-input {{focusedField === 'deltaTheta' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="0" 
                 value="{{satelliteParams.deltaTheta}}"
                 data-field="deltaTheta"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">G/Tref<text class="form-label-unit">(dB/K)</text></text>
          <input class="form-input {{focusedField === 'sfdGtRef' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="0"
                 value="{{satelliteParams.sfdGtRef}}"
                 data-field="sfdGtRef"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">Tpdr. IBO<text class="form-label-unit">(dB)</text></text>
          <input class="form-input {{focusedField === 'BOi' ? 'input-focused' : ''}}"
                 type="text"
                 placeholder="6" 
                 value="{{satelliteParams.BOi}}"
                 data-field="BOi"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <text class="form-label">Tpdr. OBO<text class="form-label-unit">(dB)</text></text>
          <input class="form-input {{focusedField === 'BOo' ? 'input-focused' : ''}}" 
                 type="text"
                 placeholder="3" 
                 value="{{satelliteParams.BOo}}"
                 data-field="BOo"
                 adjust-position="{{isNotIOS ? '' : false}}"
                 bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
        </view>

        <view class="form-group">
          <!-- 空白占位（其他损耗已移至发信站/收信站，可上下行单独设置） -->
        </view>
      </view>

      <view>
        <view class="grid-4">
          <view class="form-group">
            <text class="form-label">上行C/ACI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'aciUplinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="30" 
                   value="{{satelliteParams.aciUplinkFactor}}"
                   data-field="aciUplinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">上行C/ASI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'adjUplinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="25" 
                   value="{{satelliteParams.adjUplinkFactor}}"
                   data-field="adjUplinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">下行C/ACI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'aciDownlinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="30" 
                   value="{{satelliteParams.aciDownlinkFactor}}"
                   data-field="aciDownlinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">下行C/ASI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'adjDownlinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="25" 
                   value="{{satelliteParams.adjDownlinkFactor}}"
                   data-field="adjDownlinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <view class="grid-4">
          <view class="form-group">
            <text class="form-label">上行C/XPI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'xpolUplinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="26" 
                   value="{{satelliteParams.xpolUplinkFactor}}"
                   data-field="xpolUplinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">HPA C/IM<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'hpaIntermodFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="24" 
                   value="{{satelliteParams.hpaIntermodFactor}}"
                   data-field="hpaIntermodFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">下行C/XPI<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'xpolDownlinkFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="26" 
                   value="{{satelliteParams.xpolDownlinkFactor}}"
                   data-field="xpolDownlinkFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>

          <view class="form-group">
            <text class="form-label">Tpdr. C/IM<text class="form-label-unit">(dB)</text></text>
            <input class="form-input {{focusedField === 'xpdrIntermodFactor' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="21" 
                   value="{{satelliteParams.xpdrIntermodFactor}}"
                   data-field="xpdrIntermodFactor"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onSatelliteParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 发信站/收信站双栏布局 -->
  <view class="stations-dual-panel">
    <!-- 发信站 -->
    <view class="station-column">
      <view class="station-header">
        <view class="station-title">
          <text>发信站</text>
        </view>
      </view>
      
      <view class="collapse-content show">
        <!-- 城市选择 -->
        <view class="station-form-group city-selector-group">
          <text class="form-label">地面站位置</text>
          <view class="city-toggle-wrapper" bindtap="toggleCityDropdown" data-type="uplink">
            <text class="city-toggle-text">{{linkParams.earthStationLocation || '选择城市'}}</text>
            <text class="city-dropdown-icon">{{showUplinkCityDropdown ? '▲' : '▼'}}</text>
          </view>
          <view wx:if="{{showUplinkCityDropdown}}" class="city-dropdown show" catchtap="stopPropagation">
            <view class="city-search-wrapper">
              <view class="search-icon"></view>
              <input class="city-search-input" 
                     placeholder="" 
                     value="{{linkParams.earthStationLocation}}"
                     data-field="earthStationLocation"
                     adjust-position="{{isNotIOS ? '' : false}}"
                     bindinput="onCityInput"
                     bindconfirm="onCityConfirm"
                     data-type="uplink" />
            </view>
            <view class="city-group">
              <scroll-view scroll-y class="city-list" style="max-height: 350px;">
                <view wx:for="{{filteredCities}}" 
                      wx:key="name" 
                      class="city-item"
                      data-city="{{item}}"
                      data-type="uplink"
                      bindtap="onCitySelect">
                  {{item.name}}
                </view>
                <view wx:if="{{filteredCities.length === 0}}" class="city-empty">无匹配</view>
              </scroll-view>
            </view>
          </view>
        </view>

        <!-- 经纬度 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">经度<text class="form-label-unit">(°E)</text></text>
            <input class="form-input {{focusedField === 'longitude' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="116.4" 
                   value="{{linkParams.longitude}}"
                   data-field="longitude"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <text class="form-label">纬度<text class="form-label-unit">(°N)</text></text>
            <input class="form-input {{focusedField === 'latitude' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="39.9" 
                   value="{{linkParams.latitude}}"
                   data-field="latitude"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onLinkParamChange"
                   bindblur="onCoordinateBlur" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- NGSO 专属：最低仰角 + 轨道高度/星地斜距（可切换） -->
        <view class="station-grid-2" wx:if="{{orbitType === 'NGSO'}}">
          <view class="station-form-group">
            <view class="form-label-row">
              <text class="form-label">最低仰角<text class="form-label-unit">(°)</text></text>
            </view>
            <input class="form-input {{focusedField === 'minElevation' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="10" 
                   value="{{linkParams.minElevation}}"
                   data-field="minElevation"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
          <view class="station-form-group">
            <view class="form-label-row">
              <text class="form-label">{{linkParams.distanceMode === 'slantRange' ? '星地斜距' : '轨道高度'}}<text class="form-label-unit">(km)</text></text>
              <view class="unit-toggle" data-type="uplink" bindtap="onDistanceModeToggle"><view class="unit-toggle-icon"></view></view>
            </view>
            <input class="form-input {{focusedField === 'slantRange' || focusedField === 'orbitAltitude' ? 'input-focused' : ''}}" 
                   type="text"
                   placeholder="{{linkParams.distanceMode === 'slantRange' ? '2500' : '1200'}}" 
                   value="{{linkParams.distanceMode === 'slantRange' ? linkParams.slantRange : linkParams.orbitAltitude}}"
                   data-field="{{linkParams.distanceMode === 'slantRange' ? 'slantRange' : 'orbitAltitude'}}"
                   adjust-position="{{isNotIOS ? '' : false}}"
                   bindinput="onLinkParamChange" bindfocus="onInputFocus" selection-start="{{inputSelectAll ? 0 : -1}}" selection-end="{{inputSelectAll ? 999 : -1}}" />
          </view>
        </view>

        <!-- 天线参数 -->
        <view class="station-grid-2">
          <view class="station-form-group">
            <text class="form-label">天线口径<text class="form-label-unit">(m)</text></text>
