  min-width: 0;
}

.azel-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.azel-actions-bottom {
  margin-top: 10rpx;
}

.azel-btn {
  flex: 1;
  border-radius: 8rpx;
  padding: 16rpx 0;
  text-align: center;
}

.azel-btn text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.azel-btn-map {
  background: #475569;
}

.azel-btn-locate {
  background: #1f2937;
}

.azel-btn-calc {
  background: #0f172a;
}

.azel-result {
  margin-top: 16rpx;
  border-radius: 0;
  border: 1rpx solid #d9d9d9;
  padding: 14rpx 16rpx;
  background: #ffffff;
}

.azel-result-head {
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.azel-result-head.ok {
  color: #1a1a1a;
}

.azel-result-head.warn {
  color: #9b1c1c;
}

.azel-result-head.danger {
  color: #9b1c1c;
}

.azel-result-highlight {
  display: flex;
  justify-content: space-around;
  margin: 16rpx 0;
  padding: 16rpx 0;
}

.azel-highlight-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.azel-highlight-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.azel-highlight-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #1e3a8a;
  letter-spacing: 1rpx;
}

.azel-highlight-value.ok {
  color: #065f46;
}

.azel-highlight-value.warn {
  color: #92400e;
}

.azel-highlight-value.danger {
  color: #991b1b;
}

.azel-result-line {
  display: block;
  font-size: 24rpx;
  color: #1a1a1a;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
  margin-bottom: 4rpx;
}

/* ====== 日凌计算工具 ====== */
.sunoutage-popup {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.sunoutage-scroll-body {
  flex: 1;
  max-height: calc(80vh - 80rpx);
}

.azel-unit {
  font-size: 24rpx;
  color: #6b7280;
  margin-left: 8rpx;
  white-space: nowrap;
}

.sunoutage-freq-toggle {
  text-align: right;
  margin: 4rpx 0 12rpx;
}

.sunoutage-freq-toggle text {
  font-size: 22rpx;
  color: #1a1a1a;
  text-decoration: underline;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ====== 日凌结果 - 论文报告版式 ====== */
.sunoutage-result {
  margin-top: 28rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.sunoutage-result-summary {
  padding: 0;
}

/* 报告题头：标题 + 2rpx 黑规则线（与卡片标题同语法） */
.so-report-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #1a1a1a;
}

.so-report-title {
  font-size: 26rpx;
  font-weight: 600;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
  color: #1a1a1a;
  letter-spacing: 0.02em;
}

/* 结论句 - 报告摘要式的一句话结论 */
.so-report-conclusion {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
  padding: 14rpx 0 6rpx;
}

.so-report-conclusion.ok {
  color: #1a1a1a;
}

.so-report-conclusion.warn {
  color: #9b1c1c;
}

/* 时区切换 - 墨块分段 */
.sunoutage-time-switch {
  display: flex;
  background: transparent;
  border: 1rpx solid #1a1a1a;
  border-radius: 0;
  overflow: hidden;
}

.sunoutage-time-opt {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  color: #1a1a1a;
  transition: color 0.15s ease, background 0.15s ease;
}

.sunoutage-time-opt + .sunoutage-time-opt {
  border-left: 1rpx solid #1a1a1a;
}

.sunoutage-time-opt.active {
  background: #1a1a1a;
  color: #fff;
}

/* 摘要：标签-数值对齐行，发丝线分隔 */
.so-sum-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.so-sum-row:last-child {
  border-bottom: none;
}

.so-sum-label {
  font-size: 22rpx;
  color: #404040;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
  flex-shrink: 0;
}

.so-sum-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
  text-align: right;
  min-width: 0;
}

/* 表题 - 期刊表格的标题行 */
.so-table-caption {
  font-size: 22rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
