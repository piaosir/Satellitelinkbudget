  margin-bottom: 14rpx;
}

.so-loc-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  background: #ffffff;
  border: 1rpx solid #d4d4d4;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #1a1a1a;
