  padding: 8rpx 4rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sunoutage-detail-row:last-child {
  border-bottom: none;
}

/* 峰值日：加粗强调，不用底纹（期刊表格的强调方式） */
.sunoutage-detail-row.peak-row {
  background: transparent;
}

.sunoutage-detail-row.peak-row .so-col {
