}

.so-col {
  font-size: 20rpx;
  color: #1a1a1a;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
}

.so-col-date {
  flex: 2.5;
}

.so-col-time {
  flex: 2;
  text-align: center;
}

.so-col-dur {
  flex: 1.5;
  text-align: center;
}

.so-col-cn {
  flex: 1.2;
  text-align: center;
