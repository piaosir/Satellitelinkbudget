}

.so-intensity-high { color: #9b1c1c; }
.so-intensity-mid  { color: #404040; }
.so-intensity-low  { color: #8c8c8c; }

/* ====== 日凌输入区域 ====== */
.so-form {
  padding: 16rpx 20rpx 20rpx;
}

.so-field {
  margin-bottom: 14rpx;
}

.so-field-label {
