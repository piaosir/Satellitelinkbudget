.visual-option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.visual-option-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 4rpx;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
}

.visual-option-desc {
  font-size: 22rpx;
  color: #6b7280;
  font-family: "Times New Roman", "Songti SC", "SimSun", serif;
}

.visual-option-arrow {
  font-size: 36rpx;
  color: #9ca3af;
