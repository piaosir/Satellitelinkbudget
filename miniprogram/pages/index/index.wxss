}

/* 逐日详情 - 三线表（booktabs）：顶线/中线/底线，无竖线无底纹 */
.sunoutage-detail-list {
  border-top: 2rpx solid #1a1a1a;
  border-bottom: 2rpx solid #1a1a1a;
}

.sunoutage-detail-header {
