/* settings.wxss */

/* —— 仿真平台绑定 —— */
.bind-code {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx 16rpx 22rpx;
  margin: 8rpx 0 4rpx;
  background: #fafafa;
  border: 1px solid #e0e0e0;
  border-radius: 6rpx;
}

.bind-code:active {
  background: #f0f0f0;
}

.bind-code-t {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.bind-code-copy {
  font-size: 20rpx;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.bind-steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0 4rpx;
}

.bind-step {
  font-size: 22rpx;
  line-height: 1.5;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.bind-plats {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 0 4rpx;
}

.bind-plat {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 0;
}

.bind-plat-n {
  font-size: 24rpx;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.bind-plat-v {
  font-size: 20rpx;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.bind-msg {
  padding: 12rpx 0 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6a6a6a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.action-label.danger {
  color: #d9534f;
}

.about-info {
  padding: 16rpx 0;
}

.about-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #e0e0e0;
}

.about-item:last-child {
  border-bottom: none;
}

.about-item .label {
  font-size: 24rpx;
  color: #4a4a4a;
  font-family: 'Courier New', 'Consolas', monospace;
}

.about-item .value {
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: 600;
  font-family: 'Courier New', 'Consolas', monospace;
}

.action-list {
  padding: 8rpx 0;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #e0e0e0;
  cursor: pointer;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item:active {
  background: #fafafa;
}

.action-label {
  font-size: 24rpx;
  color: #1a1a1a;
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.3px;
}

.action-icon {
  font-size: 24rpx;
  color: #6a6a6a;
}

.system-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  text-align: center;
  padding: 16rpx 0;
}

.info-text {
  font-size: 22rpx;
  color: #6a6a6a;
  line-height: 1.5;
  font-family: 'Courier New', 'Consolas', monospace;
}
