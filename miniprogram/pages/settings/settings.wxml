<!--settings.wxml-->
<view class="container">
  <!-- 仿真平台绑定：本机的认证码 = 长期收件地址，给电脑上的仿真平台记下来。
       bind-card 只为把整块换成衬线字（见 settings.wxss 开头），不带任何布局含义 -->
  <view class="card bind-card">
    <view class="card-title">仿真平台绑定</view>
    <view class="bind-code" bindtap="copyCh">
      <text class="bind-code-t">{{ chFmt || '············' }}</text>
      <text class="bind-code-copy">点击复制</text>
    </view>
    <!-- 绑定步骤、多设备/多账号的说明都在「使用帮助 → 仿真平台联动」那一章，这里只留个指路条 -->
    <view class="bind-steps">
      <text class="bind-step link" bindtap="showHelp">怎么绑定 · 详见「使用帮助 → 仿真平台联动」›</text>
    </view>

    <view class="bind-plats" wx:if="{{ platforms.length }}">
      <view class="bind-plat" wx:for="{{ platforms }}" wx:key="pid">
        <text class="bind-plat-n">{{ item.label || item.pid }}</text>
        <text class="bind-plat-v">{{ item.app ? 'v' + item.app : '' }}</text>
      </view>
    </view>

    <!-- 本机的码与云端记着的不是同一个：多半是同一个微信号的另一台手机各自生成过。
         两台要收同一份内容，得在其中一台上换绑到另一台的码。 -->
    <view class="bind-warn" wx:if="{{ otherFmt }}">云端还记着另一个认证码 {{ otherFmt }}，多半是你另一台手机生成的。两台手机想收同一份内容，在其中一台上「换绑其他认证码」到另一台的码即可（平台侧绑的是哪个，就并到哪个）。</view>

    <view class="action-list">
      <view class="action-item" bindtap="syncNow">
        <text class="action-label">{{ syncing ? '同步中…' : '立即同步' }}</text>
        <text class="action-icon">→</text>
      </view>
      <view class="action-item" bindtap="adoptCh">
        <text class="action-label">换绑其他认证码</text>
        <text class="action-icon">→</text>
      </view>
      <view class="action-item" bindtap="resetCh">
        <text class="action-label danger">重置认证码</text>
        <text class="action-icon">→</text>
      </view>
    </view>
    <view class="bind-msg" wx:if="{{ syncMsg }}">{{ syncMsg }}</view>
  </view>

  <view class="card">
    <view class="card-title">关于系统</view>
    <view class="about-info">
      <view class="about-item">
        <text class="label">系统名称</text>
        <text class="value">卫星链路计算与仿真系统</text>
      </view>
      <view class="about-item">
        <text class="label">版本号</text>
        <text class="value">v3.8.10</text>
      </view>
      <view class="about-item">
        <text class="label">开发者</text>
        <text class="value">ppx</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">数据管理</view>
    <view class="action-list">
      <view class="action-item" bindtap="clearCache">
        <text class="action-label">清除缓存</text>
        <text class="action-icon">→</text>
      </view>
      <view class="action-item" bindtap="exportData">
        <text class="action-label">导出数据</text>
        <text class="action-icon">→</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">帮助与反馈</view>
    <view class="action-list">
      <view class="action-item" bindtap="showHelp">
        <text class="action-label">使用帮助</text>
        <text class="action-icon">→</text>
      </view>
      <view class="action-item" bindtap="feedback">
        <text class="action-label">意见反馈</text>
        <text class="action-icon">→</text>
      </view>
    </view>
  </view>
</view>
